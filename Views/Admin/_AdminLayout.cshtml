@using Microsoft.AspNetCore.Identity
@using UFSStayConnect.Models

@inject UserManager<ApplicationUser> UserManager
@inject UFSStayConnect.DataAccess.IRepositoryWrapper Repository

@{
    var currentUser = await UserManager.GetUserAsync(User);

    var adminName = currentUser != null
        ? $"{currentUser.FirstName} {currentUser.Surname}".Trim()
        : "Administrator";

    if (string.IsNullOrWhiteSpace(adminName))
    {
        adminName = "Administrator";
    }

    var unreadNotifications = currentUser == null
        ? 0
        : Repository.Notification
            .FindByUser(currentUser.Id)
            .Count(n => !n.IsRead);

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null)
    {
        if (!string.Equals(
                currentController,
                controller,
                StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (action == null)
        {
            return true;
        }

        return string.Equals(
            currentAction,
            action,
            StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - UFS StayConnect
    </title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         FONT AWESOME
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =====================================================
         SITE CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />


    <!-- =====================================================
         ADMIN CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />


    @RenderSection("Styles", required: false)

</head>


<body class="admin-body">


    <div class="admin-shell">


        <!-- =====================================================
             ADMIN SIDEBAR
             ===================================================== -->

        <aside class="admin-sidebar"
               id="adminSidebar">


            <!-- ACCOMMODATION BACKGROUND -->

            <div class="admin-sidebar-image"></div>

            <div class="admin-sidebar-overlay"></div>


            <!-- SIDEBAR CONTENT -->

            <div class="admin-sidebar-content">


                <!-- =================================================
                     BRAND
                     ================================================= -->

                <div class="admin-brand">

                    <div class="admin-brand-logo">

                        <img src="~/images/ufs-emblem.png"
                             alt="University of the Free State"
                             class="ufs-emblem" />

                    </div>


                    <div class="admin-brand-text">

                        <div class="admin-brand-title">
                            UFS StayConnect
                        </div>

                        <div class="admin-brand-subtitle">
                            Administration
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     NAVIGATION
                     ================================================= -->

                <nav class="admin-navigation">


                    <!-- MAIN -->

                    <div class="admin-nav-section">
                        MAIN
                    </div>


                    <!-- DASHBOARD -->

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("Admin", "Index") ? "active" : "")">

                        <i class="fa-solid fa-chart-line"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <!-- USERS -->

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="admin-nav-link @(IsActive("Admin", "Users") ? "active" : "")">

                        <i class="fa-solid fa-users"></i>

                        <span>
                            Users
                        </span>

                    </a>


                    <!-- ACCOMMODATION -->

                    <a asp-controller="Accommodation"
                       asp-action="Manage"
                       class="admin-nav-link @(IsActive("Accommodation") ? "active" : "")">

                        <i class="fa-solid fa-house"></i>

                        <span>
                            Accommodation
                        </span>

                    </a>


                    <!-- APPLICATIONS -->

                    <a asp-controller="Application"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("Application") ? "active" : "")">

                        <i class="fa-solid fa-file-lines"></i>

                        <span>
                            Applications
                        </span>

                    </a>


                    <!-- PAYMENTS -->

                    <a asp-controller="PaymentManagement"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("PaymentManagement") ? "active" : "")">

                        <i class="fa-solid fa-credit-card"></i>

                        <span>
                            Payments
                        </span>

                    </a>


                    <!-- PAYMENT TYPES -->

                    <a asp-controller="PaymentType"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("PaymentType") ? "active" : "")">

                        <i class="fa-solid fa-file-invoice-dollar"></i>

                        <span>
                            Payment Types
                        </span>

                    </a>


                    <!-- DIVIDER -->

                    <div class="admin-nav-divider"></div>


                    <!-- MANAGEMENT -->

                    <div class="admin-nav-section">
                        MANAGEMENT
                    </div>


                    <!-- SERVICES -->

                   
<!-- CUSTOMER CHARGES -->
<a asp-controller="CustomerCharge"
   asp-action="Index"
   class="admin-nav-link @(IsActive("CustomerCharge") ? "active" : "")">
    <i class="fa-solid fa-file-invoice-dollar"></i>
    <span>Customer Charges</span>
</a>


                    <a asp-controller="Service"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("Service") ? "active" : "")">

                        <i class="fa-solid fa-bolt"></i>

                        <span>
                            Services
                        </span>

                    </a>


                    <!-- FINANCIAL OFFICERS -->

                    <a asp-controller="FinancialOfficer"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("FinancialOfficer") ? "active" : "")">

                        <i class="fa-solid fa-user-tie"></i>

                        <span>
                            Financial Officers
                        </span>

                    </a>


                    <!-- REPORTS -->

                    <a asp-controller="Report"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("Report") ? "active" : "")">

                        <i class="fa-solid fa-chart-pie"></i>

                        <span>
                            Reports
                        </span>

                    </a>


                    <!-- OFFICER ADVICE -->

                    <a asp-controller="Admin"
                       asp-action="Advice"
                       class="admin-nav-link @(IsActive("Admin", "Advice") ? "active" : "")">

                        <i class="fa-solid fa-lightbulb"></i>

                        <span>
                            Officer Advice
                        </span>

                    </a>


                    <!-- NOTIFICATIONS -->

                    <a asp-controller="Notification"
                       asp-action="Index"
                       class="admin-nav-link @(IsActive("Notification") ? "active" : "")">

                        <i class="fa-solid fa-bell"></i>

                        <span>
                            Notifications
                        </span>

                        @if (unreadNotifications > 0)
                        {
                            <span class="sidebar-notification-count">

                                @(unreadNotifications > 99
                                                            ? "99+"
                                                            : unreadNotifications.ToString())

                        </span>
                                                }

                    </a>


                </nav>


                <!-- =================================================
                     SIDEBAR FOOTER
                     ================================================= -->

                <div class="admin-sidebar-bottom">


                    <!-- ADMIN PROFILE -->

                    <div class="admin-user-mini">

                        <div class="admin-avatar">

                            <i class="fa-solid fa-user-shield"></i>

                        </div>


                        <div class="admin-user-details">

                            <strong>
                                @adminName
                            </strong>

                            <span>
                                Administrator
                            </span>

                        </div>

                    </div>


                    <!-- LOGOUT FORM -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          id="logoutForm">

                        @Html.AntiForgeryToken()


                        <!-- IMPORTANT:
                             type="button" means it does NOT
                             immediately submit the form. -->

                        <button type="button"
                                class="admin-logout"
                                id="logoutButton">

                            <i class="fa-solid fa-right-from-bracket"></i>

                            <span>
                                Logout
                            </span>

                        </button>

                    </form>


                </div>


            </div>

        </aside>


        <!-- =====================================================
             MAIN APPLICATION AREA
             ===================================================== -->

        <main class="admin-main">


            <!-- =================================================
                 TOPBAR
                 ================================================= -->

            <header class="admin-topbar">


                <!-- LEFT -->

                <div class="admin-topbar-left">


                    <!-- SIDEBAR TOGGLE -->

                    <button type="button"
                            class="admin-sidebar-toggle"
                            id="adminSidebarToggle"
                            title="Toggle navigation">

                        <i class="fa-solid fa-bars"></i>

                    </button>


                    <!-- PAGE TITLE -->

                    <div class="topbar-title">

                        <h1>
                            @ViewData["Title"]
                        </h1>

                        <p>
                            UFS StayConnect Administration
                        </p>

                    </div>


                </div>


                <!-- RIGHT -->

                <div class="admin-topbar-right">


                    <!-- NOTIFICATIONS -->

                    <a asp-controller="Notification"
                       asp-action="Index"
                       class="admin-notification-button"
                       aria-label="Notifications">

                        <i class="fa-regular fa-bell"></i>


                        @if (unreadNotifications > 0)
                        {
                            <span class="notification-count">

                                @(unreadNotifications > 99
                                                            ? "99+"
                                                            : unreadNotifications.ToString())

                        </span>
                                                }

                    </a>


                    <!-- ADMIN PROFILE -->

                    <div class="admin-profile">

                        <div class="admin-profile-avatar">

                            <i class="fa-solid fa-user-shield"></i>

                        </div>


                        <div class="admin-profile-text">

                            <strong>
                                @adminName
                            </strong>

                            <span>
                                Administrator
                            </span>

                        </div>

                    </div>


                </div>


            </header>


            <!-- =================================================
                 MAIN PAGE CONTENT
                 ================================================= -->

            <section class="admin-content">

                @RenderBody()

            </section>


        </main>


    </div>



    <!-- =========================================================
         LOGOUT CONFIRMATION MODAL
         ========================================================= -->

    <div class="logout-modal"
         id="logoutModal"
         aria-hidden="true">


        <!-- BACKDROP -->

        <div class="logout-modal-backdrop"
             id="logoutModalBackdrop">
        </div>


        <!-- MODAL CARD -->

        <div class="logout-modal-card"
             role="dialog"
             aria-modal="true"
             aria-labelledby="logoutModalTitle">


            <!-- ICON -->

            <div class="logout-modal-icon">

                <i class="fa-solid fa-right-from-bracket"></i>

            </div>


            <!-- CONTENT -->

            <div class="logout-modal-content">

                <h3 id="logoutModalTitle">
                    Sign out of UFS StayConnect?
                </h3>


                <p>
                    Are you sure you want to log out of your
                    administrator account?
                </p>

            </div>


            <!-- ACTIONS -->

            <div class="logout-modal-actions">


                <!-- CANCEL -->

                <button type="button"
                        class="logout-cancel"
                        id="logoutCancel">

                    Cancel

                </button>


                <!-- CONFIRM -->

                <button type="button"
                        class="logout-confirm"
                        id="logoutConfirm">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    Logout

                </button>


            </div>


        </div>

    </div>



    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /* =====================================================
               ELEMENTS
               ===================================================== */

            const shell =
                document.querySelector(".admin-shell");

            const sidebar =
                document.getElementById("adminSidebar");

            const sidebarToggle =
                document.getElementById("adminSidebarToggle");


            /* =====================================================
               SIDEBAR TOGGLE
               ===================================================== */

            if (sidebarToggle) {

                sidebarToggle.addEventListener(
                    "click",
                    function () {


                        /* MOBILE */

                        if (window.innerWidth <= 992) {

                            sidebar.classList.toggle("show");

                        }


                        /* DESKTOP */

                        else {

                            shell.classList.toggle(
                                "sidebar-collapsed"
                            );

                        }

                    }
                );

            }


            /* =====================================================
               CLOSE MOBILE SIDEBAR
               ===================================================== */

            document.addEventListener(
                "click",
                function (event) {


                    if (window.innerWidth > 992) {
                        return;
                    }


                    if (!sidebar.classList.contains("show")) {
                        return;
                    }


                    const clickedInsideSidebar =
                        sidebar.contains(event.target);


                    const clickedToggle =
                        sidebarToggle &&
                        sidebarToggle.contains(event.target);


                    if (
                        !clickedInsideSidebar &&
                        !clickedToggle
                    ) {

                        sidebar.classList.remove("show");

                    }

                }
            );


            /* =====================================================
               LOGOUT ELEMENTS
               ===================================================== */

            const logoutButton =
                document.getElementById("logoutButton");

            const logoutModal =
                document.getElementById("logoutModal");

            const logoutCancel =
                document.getElementById("logoutCancel");

            const logoutConfirm =
                document.getElementById("logoutConfirm");

            const logoutBackdrop =
                document.getElementById("logoutModalBackdrop");

            const logoutForm =
                document.getElementById("logoutForm");


            /* =====================================================
               OPEN LOGOUT MODAL
               ===================================================== */

            if (logoutButton && logoutModal) {

                logoutButton.addEventListener(
                    "click",
                    function () {


                        logoutModal.classList.add("show");


                        logoutModal.setAttribute(
                            "aria-hidden",
                            "false"
                        );


                        document.body.style.overflow =
                            "hidden";


                        /* Put focus on Cancel */

                        if (logoutCancel) {

                            setTimeout(
                                function () {

                                    logoutCancel.focus();

                                },
                                100
                            );

                        }

                    }
                );

            }


            /* =====================================================
               CLOSE LOGOUT MODAL
               ===================================================== */

            function closeLogoutModal() {


                if (!logoutModal) {
                    return;
                }


                logoutModal.classList.remove("show");


                logoutModal.setAttribute(
                    "aria-hidden",
                    "true"
                );


                document.body.style.overflow =
                    "";

            }


            /* =====================================================
               CANCEL
               ===================================================== */

            if (logoutCancel) {

                logoutCancel.addEventListener(
                    "click",
                    closeLogoutModal
                );

            }


            /* =====================================================
               CLICK BACKDROP
               ===================================================== */

            if (logoutBackdrop) {

                logoutBackdrop.addEventListener(
                    "click",
                    closeLogoutModal
                );

            }


            /* =====================================================
               CONFIRM LOGOUT
               ===================================================== */

            if (logoutConfirm) {

                logoutConfirm.addEventListener(
                    "click",
                    function () {


                        if (logoutForm) {

                            logoutForm.submit();

                        }

                    }
                );

            }


            /* =====================================================
               ESCAPE KEY
               ===================================================== */

            document.addEventListener(
                "keydown",
                function (event) {


                    if (
                        event.key === "Escape" &&
                        logoutModal &&
                        logoutModal.classList.contains("show")
                    ) {

                        closeLogoutModal();

                    }

                }
            );


        });

    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )


</body>

</html>