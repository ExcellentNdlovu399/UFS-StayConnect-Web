@model IEnumerable<UFSStayConnect.Models.Notification>

@{
    ViewData["Title"] = "Notifications";

    var notifications = Model?.OrderByDescending(n => n.DateCreated).ToList()
        ?? new List<UFSStayConnect.Models.Notification>();

    var unreadCount = notifications.Count(n => !n.IsRead);
    var readCount = notifications.Count(n => n.IsRead);
}

<div class="customer-notifications-page">

    <!-- Header -->
    <div class="notifications-header">

        <div>

            <div class="notifications-eyebrow">
                <i class="fas fa-bell"></i>
                ACCOUNT UPDATES
            </div>

            <h1>Notifications</h1>

            <p>
                Stay updated with important account, accommodation
                and payment events.
            </p>

        </div>


        <div class="notification-header-summary">

            <div class="notification-summary-icon">
                <i class="fas fa-bell"></i>
            </div>

            <div>
                <strong>@unreadCount</strong>
                <span>Unread</span>
            </div>

        </div>

    </div>


    <!-- Summary -->
    <div class="notification-stats">

        <div class="notification-stat-card">

            <div class="notification-stat-icon unread">
                <i class="fas fa-bell"></i>
            </div>

            <div>
                <span>Unread</span>
                <strong>@unreadCount</strong>
            </div>

        </div>


        <div class="notification-stat-card">

            <div class="notification-stat-icon total">
                <i class="fas fa-inbox"></i>
            </div>

            <div>
                <span>Total notifications</span>
                <strong>@notifications.Count</strong>
            </div>

        </div>


        <div class="notification-stat-card">

            <div class="notification-stat-icon read">
                <i class="fas fa-check-double"></i>
            </div>

            <div>
                <span>Read</span>
                <strong>@readCount</strong>
            </div>

        </div>

    </div>


    <!-- Toolbar -->
    <div class="notifications-toolbar">

        <div>
            <h2>Recent Notifications</h2>

            <span>
                @(notifications.Count == 0
                                ? "No notifications"
                                : $"{notifications.Count} notification{(notifications.Count == 1 ? "" : "s")}")
            </span>
        </div>


        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="mark-all-btn">
                    <i class="fas fa-check-double"></i>
                    Mark All as Read
                </button>

            </form>
        }

    </div>


    @if (notifications.Any())
    {
        <div class="notification-list">

            @foreach (var n in notifications)
            {
                <div class="notification-card @(n.IsRead ? "notification-read" : "notification-unread")">

                    <!-- Status indicator -->
                    <div class="notification-status-line"></div>


                    <!-- Icon -->
                    <div class="notification-icon">

                        @if (!n.IsRead)
                        {
                            <i class="fas fa-bell"></i>
                        }
                        else
                        {
                            <i class="fas fa-check"></i>
                        }

                    </div>


                    <!-- Content -->
                    <div class="notification-content">

                        <div class="notification-title-row">

                            <h3>
                                @n.Title
                            </h3>

                            @if (!n.IsRead)
                            {
                                <span class="unread-pill">
                                    New
                                </span>
                            }

                        </div>


                        <p>
                            @n.Message
                        </p>


                        <div class="notification-meta">

                            <span>
                                <i class="far fa-clock"></i>

                                @n.DateCreated.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")
                            </span>

                            @if (n.IsRead)
                            {
                                <span class="read-label">
                                    <i class="fas fa-check"></i>
                                    Read
                                </span>
                            }
                            else
                            {
                                <span class="unread-label">
                                    <i class="fas fa-circle"></i>
                                    Unread
                                </span>
                            }

                        </div>

                    </div>


                    <!-- Action -->
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead"
                              method="post"
                              class="notification-action">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@n.NotificationID" />

                            <button type="submit"
                                    class="mark-read-btn"
                                    title="Mark notification as read">

                                <i class="fas fa-check"></i>
                                <span>Mark Read</span>

                            </button>

                        </form>
                    }

                </div>
            }

        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="notifications-empty">

            <div class="notifications-empty-icon">
                <i class="far fa-bell-slash"></i>
            </div>

            <h2>You're all caught up</h2>

            <p>
                There are no notifications on your account right now.
                New updates about your accommodation, applications
                and payments will appear here.
            </p>

        </div>
    }


    <!-- Information -->
    <div class="notification-information">

        <div class="notification-information-icon">
            <i class="fas fa-shield-halved"></i>
        </div>

        <div>

            <strong>Your notifications are private</strong>

            <p>
                These notifications are linked to your UFS StayConnect
                account and are only visible to you.
            </p>

        </div>

    </div>

</div>


<style>

    /* =========================================================
           CUSTOMER NOTIFICATIONS
           ========================================================= */

    .customer-notifications-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 34px 30px 60px;
    }


    /* =========================
           HEADER
           ========================= */

    .notifications-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 24px;
    }

    .notifications-eyebrow {
        color: #b8860b;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 1.4px;
        margin-bottom: 7px;
    }

        .notifications-eyebrow i {
            margin-right: 5px;
        }

    .notifications-header h1 {
        margin: 0;
        color: #123b73;
        font-size: 2rem;
        font-weight: 800;
    }

    .notifications-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 0.93rem;
    }


    /* =========================
           HEADER SUMMARY
           ========================= */

    .notification-header-summary {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 125px;
        padding: 13px 15px;
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 11px;
    }

    .notification-summary-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: #edf3f9;
        color: #123b73;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .notification-header-summary strong {
        display: block;
        color: #123b73;
        font-size: 1rem;
        line-height: 1;
    }

    .notification-header-summary span {
        display: block;
        margin-top: 4px;
        color: #8a94a2;
        font-size: 0.67rem;
    }


    /* =========================
           STATS
           ========================= */

    .notification-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 27px;
    }

    .notification-stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px;
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 11px;
        box-shadow: 0 4px 14px rgba(8,20,38,0.035);
    }

    .notification-stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .notification-stat-icon.unread {
            background: #edf3f9;
            color: #123b73;
        }

        .notification-stat-icon.total {
            background: #f4f5f7;
            color: #596579;
        }

        .notification-stat-icon.read {
            background: #edf8f1;
            color: #198754;
        }

    .notification-stat-card span {
        display: block;
        color: #7b8491;
        font-size: 0.69rem;
    }

    .notification-stat-card strong {
        display: block;
        margin-top: 3px;
        color: #25364d;
        font-size: 1.12rem;
        font-weight: 800;
    }


    /* =========================
           TOOLBAR
           ========================= */

    .notifications-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 14px;
    }

        .notifications-toolbar h2 {
            margin: 0;
            color: #123b73;
            font-size: 1.12rem;
            font-weight: 800;
        }

        .notifications-toolbar span {
            display: block;
            margin-top: 3px;
            color: #8a94a2;
            font-size: 0.72rem;
        }

    .mark-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 39px;
        padding: 0 14px;
        border: 1px solid #d8e1ec;
        border-radius: 8px;
        background: #ffffff;
        color: #123b73;
        font-size: 0.77rem;
        font-weight: 750;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .mark-all-btn:hover {
            background: #f2f6fa;
            border-color: #b9c9dc;
        }


    /* =========================
           NOTIFICATION CARD
           ========================= */

    .notification-list {
        display: grid;
        gap: 10px;
    }

    .notification-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 18px 19px 18px 23px;
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 11px;
        box-shadow: 0 4px 15px rgba(8,20,38,0.035);
        overflow: hidden;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

        .notification-card:hover {
            box-shadow: 0 7px 20px rgba(8,20,38,0.065);
            transform: translateY(-1px);
        }

    .notification-unread {
        background: #fbfdff;
        border-color: #d3dfed;
    }

    .notification-status-line {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: transparent;
    }

    .notification-unread .notification-status-line {
        background: #123b73;
    }


    /* =========================
           ICON
           ========================= */

    .notification-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #eef3f8;
        color: #123b73;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .notification-read .notification-icon {
        background: #f1f3f5;
        color: #7b8491;
    }


    /* =========================
           CONTENT
           ========================= */

    .notification-content {
        flex: 1;
        min-width: 0;
    }

    .notification-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .notification-title-row h3 {
            margin: 0;
            color: #26364a;
            font-size: 0.89rem;
            font-weight: 800;
        }

    .unread-pill {
        display: inline-flex !important;
        width: auto !important;
        margin: 0 !important;
        padding: 3px 7px;
        border-radius: 999px;
        background: #e8f0fa;
        color: #123b73 !important;
        font-size: 0.61rem !important;
        font-weight: 800 !important;
        text-transform: uppercase;
    }

    .notification-content p {
        margin: 6px 0 9px;
        color: #667085;
        font-size: 0.8rem;
        line-height: 1.55;
    }

    .notification-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 13px;
        color: #8a94a2;
        font-size: 0.68rem;
    }

        .notification-meta i {
            margin-right: 4px;
        }

    .read-label {
        color: #198754;
    }

    .unread-label {
        color: #123b73;
    }

        .unread-label i {
            font-size: 0.38rem;
            vertical-align: middle;
        }


    /* =========================
           ACTION
           ========================= */

    .notification-action {
        flex-shrink: 0;
        margin-top: 2px;
    }

    .mark-read-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 35px;
        padding: 0 11px;
        border: 1px solid #d8e1ec;
        border-radius: 7px;
        background: #ffffff;
        color: #123b73;
        font-size: 0.7rem;
        font-weight: 750;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .mark-read-btn:hover {
            background: #123b73;
            border-color: #123b73;
            color: #ffffff;
        }


    /* =========================
           EMPTY STATE
           ========================= */

    .notifications-empty {
        padding: 60px 30px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(8,20,38,0.04);
    }

    .notifications-empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #edf3f9;
        color: #123b73;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .notifications-empty h2 {
        margin: 0;
        color: #25364d;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .notifications-empty p {
        max-width: 560px;
        margin: 9px auto 0;
        color: #7b8491;
        font-size: 0.8rem;
        line-height: 1.6;
    }


    /* =========================
           INFORMATION
           ========================= */

    .notification-information {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 18px;
        padding: 15px 17px;
        border: 1px solid #dce7f4;
        border-radius: 10px;
        background: #f5f9fe;
    }

    .notification-information-icon {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 8px;
        background: #e3edf9;
        color: #123b73;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .notification-information strong {
        display: block;
        color: #123b73;
        font-size: 0.78rem;
    }

    .notification-information p {
        margin: 3px 0 0;
        color: #6b7280;
        font-size: 0.72rem;
    }


    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 768px) {

        .customer-notifications-page {
            padding: 25px 16px 45px;
        }

        .notifications-header {
            align-items: flex-start;
        }

        .notification-header-summary {
            display: none;
        }

        .notification-stats {
            grid-template-columns: 1fr;
        }

        .notifications-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .notification-card {
            padding: 16px;
        }

        .notification-action {
            align-self: center;
        }

        .mark-read-btn span {
            display: none;
        }
    }
</style>