@model IEnumerable<UFSStayConnect.Models.Notification>

@{
    ViewData["Title"] = "Notification Management";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";

    var notifications = Model?.ToList()
        ?? new List<UFSStayConnect.Models.Notification>();

    var totalNotifications = notifications.Count;
    var unreadNotifications = notifications.Count(n => !n.IsRead);
    var readNotifications = notifications.Count(n => n.IsRead);
}

<div class="notifications-page">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <div class="eyebrow">
                <i class="fas fa-bell"></i>
                SYSTEM COMMUNICATION
            </div>

            <h1>Notification Management</h1>

            <p>
                Review system notifications generated for users.
            </p>
        </div>
    </div>


    <!-- SUMMARY -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fas fa-bell"></i>
            </div>

            <div>
                <span>Total Notifications</span>
                <strong>@totalNotifications</strong>
                <small>System notifications</small>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fas fa-envelope"></i>
            </div>

            <div>
                <span>Unread</span>
                <strong>@unreadNotifications</strong>
                <small>Awaiting user attention</small>
            </div>
        </div>


        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fas fa-envelope-open"></i>
            </div>

            <div>
                <span>Read</span>
                <strong>@readNotifications</strong>
                <small>Already viewed</small>
            </div>
        </div>

    </div>


    <!-- NOTIFICATIONS -->
    <div class="management-card">

        <div class="management-header">

            <div>
                <h2>
                    <i class="fas fa-bell"></i>
                    System Notifications
                </h2>

                <p>
                    Notifications generated by applications, payments and
                    other system activities.
                </p>
            </div>

            <div class="search-box">
                <i class="fas fa-search"></i>

                <input type="text"
                       id="notificationSearch"
                       placeholder="Search notifications..."
                       autocomplete="off" />
            </div>

        </div>


        @if (!notifications.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fas fa-bell-slash"></i>
                </div>

                <h3>No Notifications</h3>

                <p>
                    There are currently no system notifications to display.
                </p>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table class="notifications-table">

                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Notification</th>
                            <th>Message</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody id="notificationTable">

                        @foreach (var notification in notifications)
                        {
                            <tr class="notification-row">

                                <!-- USER -->
                                <td>

                                    <div class="user-cell">

                                        <div class="user-icon">
                                            <i class="fas fa-user"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                @(notification.User?.Email
                                                                                        ?? notification.UserID)
                                                                                                           </strong>

                                            <span>
                                                Notification recipient
                                            </span>
                                        </div>

                                    </div>

                                </td>


                                <!-- TITLE -->
                                <td>

                                    <div class="title-cell">

                                        <div class="notification-icon
                                                    @(notification.IsRead
                                                                                             ? "read-icon"
                                                                                             : "unread-icon")">

                                    <i class="fas fa-bell"></i>

                                        </div>

                                        <strong>
                                            @notification.Title
                                        </strong>

                                    </div>

                                </td>


                                <!-- MESSAGE -->
                                <td>

                                    <div class="message-cell">
                                        @notification.Message
                                    </div>

                                </td>


                                <!-- DATE -->
                                <td>

                                    <span class="date-cell">
                                        @notification.DateCreated.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                            @if (notification.IsRead)
                                    {
                                        <span class="status-badge read">
                                            <span></span>
                                            Read
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge unread">
                                            <span></span>
                                            Unread
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div id="noNotificationResults" class="no-results">

                <i class="fas fa-search"></i>

                <h3>No notifications found</h3>

                <p>
                    Try searching using another term.
                </p>

            </div>
        }

    </div>

</div>


<style>

    .notifications-page {
        padding: 30px 34px 50px;
        background: #f6f8fb;
        min-height: calc(100vh - 70px);
    }

    .page-header {
        margin-bottom: 25px;
    }

    .eyebrow {
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        margin-bottom: 7px;
    }

    .page-header h1 {
        margin: 0;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-header p {
        color: #7b8494;
        font-size: 14px;
        margin: 7px 0 0;
    }


    /* STATS */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 18px rgba(20,30,50,.04);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .stat-icon.blue {
            background: #eef4ff;
            color: #2563eb;
        }

        .stat-icon.orange {
            background: #fff4df;
            color: #d97706;
        }

        .stat-icon.green {
            background: #eaf9ef;
            color: #16a34a;
        }

    .stat-card span {
        display: block;
        color: #7b8495;
        font-size: 12px;
        font-weight: 600;
    }

    .stat-card strong {
        display: block;
        color: #172033;
        font-size: 25px;
        margin: 2px 0;
    }

    .stat-card small {
        color: #9aa3b2;
        font-size: 11px;
    }


    /* CARD */

    .management-card {
        background: white;
        border: 1px solid #e7ebf1;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 7px 25px rgba(20,30,50,.045);
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f4;
    }

        .management-header h2 {
            color: #172033;
            font-size: 17px;
            font-weight: 800;
            margin: 0 0 4px;
        }

            .management-header h2 i {
                color: #2563eb;
                margin-right: 7px;
            }

        .management-header p {
            color: #8a93a3;
            font-size: 12px;
            margin: 0;
        }


    /* SEARCH */

    .search-box {
        position: relative;
        width: 280px;
    }

        .search-box i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aa3b2;
        }

        .search-box input {
            width: 100%;
            border: 1px solid #dfe4eb;
            background: #f8fafc;
            border-radius: 9px;
            padding: 10px 12px 10px 36px;
            outline: none;
            font-size: 13px;
        }

            .search-box input:focus {
                border-color: #2563eb;
                background: white;
                box-shadow: 0 0 0 3px rgba(37,99,235,.08);
            }


    /* TABLE */

    .table-wrapper {
        overflow-x: auto;
    }

    .notifications-table {
        width: 100%;
        border-collapse: collapse;
    }

        .notifications-table th {
            background: #f8fafc;
            color: #7b8495;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 14px 22px;
            border-bottom: 1px solid #e9edf2;
            white-space: nowrap;
        }

        .notifications-table td {
            padding: 16px 22px;
            border-bottom: 1px solid #f0f2f5;
            vertical-align: middle;
        }

    .notification-row:hover {
        background: #fafcff;
    }


    /* USER */

    .user-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eef4ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .user-cell strong {
        display: block;
        color: #303949;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .user-cell span {
        color: #9aa3b2;
        font-size: 10px;
    }


    /* NOTIFICATION */

    .title-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
    }

    .notification-icon {
        width: 35px;
        height: 35px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .unread-icon {
        background: #eef4ff;
        color: #2563eb;
    }

    .read-icon {
        background: #f0f1f3;
        color: #858d99;
    }

    .title-cell strong {
        color: #303949;
        font-size: 13px;
    }


    /* MESSAGE */

    .message-cell {
        max-width: 430px;
        color: #626d7e;
        font-size: 12px;
        line-height: 1.5;
    }

    .date-cell {
        color: #7b8495;
        font-size: 11px;
        white-space: nowrap;
    }


    /* STATUS */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
    }

        .status-badge span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .status-badge.unread {
            background: #eef4ff;
            color: #2563eb;
        }

            .status-badge.unread span {
                background: #2563eb;
            }

        .status-badge.read {
            background: #f0f1f3;
            color: #68707d;
        }

            .status-badge.read span {
                background: #8b929d;
            }


    /* EMPTY */

    .empty-state,
    .no-results {
        text-align: center;
        padding: 65px 20px;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 18px;
        background: #eef4ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto auto 17px;
        font-size: 26px;
    }

    .empty-state h3,
    .no-results h3 {
        color: #202939;
        font-size: 18px;
        font-weight: 800;
    }

    .empty-state p,
    .no-results p {
        color: #8b94a3;
        font-size: 13px;
    }

    .no-results {
        display: none;
    }

        .no-results > i {
            color: #929aa7;
            font-size: 25px;
            margin-bottom: 12px;
        }


    @@media(max-width:1000px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .management-header {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }
    }


    @@media(max-width:700px) {

        .notifications-page {
            padding: 22px 16px 40px;
        }

        .page-header h1 {
            font-size: 27px;
        }
    }
</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const search =
            document.getElementById("notificationSearch");

        const rows =
            document.querySelectorAll(".notification-row");

        const noResults =
            document.getElementById("noNotificationResults");

        if (!search) return;

        search.addEventListener("input", function () {

            const term =
                this.value.toLowerCase().trim();

            let visible = 0;

            rows.forEach(row => {

                const match =
                    row.innerText
                        .toLowerCase()
                        .includes(term);

                row.style.display =
                    match ? "" : "none";

                if (match) visible++;

            });

            if (noResults) {
                noResults.style.display =
                    visible === 0 ? "block" : "none";
            }

        });

    });

</script>