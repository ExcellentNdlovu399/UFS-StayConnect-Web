@model IEnumerable<UFSStayConnect.Models.Service>

@{
    ViewData["Title"] = "Service Management";

    var services = Model?.ToList()
        ?? new List<UFSStayConnect.Models.Service>();
}

<div class="services-page">

    <!-- Page Header -->
    <div class="page-header">

        <div>
            <div class="page-eyebrow">
                <i class="fas fa-concierge-bell"></i>
                ACCOMMODATION MANAGEMENT
            </div>

            <h1>Service Management</h1>

            <p>
                Manage the services and facilities available across
                UFS StayConnect residences.
            </p>
        </div>

        <a asp-action="Create"
           class="btn-primary">
            <i class="fas fa-plus"></i>
            Add Service
        </a>

    </div>


    <!-- Statistics -->
    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon blue">
                <i class="fas fa-concierge-bell"></i>
            </div>

            <div>
                <span>Total Services</span>
                <strong>@services.Count</strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon green">
                <i class="fas fa-circle-check"></i>
            </div>

            <div>
                <span>Available Services</span>
                <strong>@services.Count</strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon gold">
                <i class="fas fa-building"></i>
            </div>

            <div>
                <span>Residence Facilities</span>
                <strong>Manage</strong>
            </div>

        </div>

    </div>


    <!-- Management Card -->
    <div class="management-card">

        <div class="management-header">

            <div>

                <h2>Residence Services</h2>

                <p>
                    Create, review and maintain the standard services
                    that can be assigned to accommodations.
                </p>

            </div>

            <div class="search-wrapper">

                <i class="fas fa-search"></i>

                <input type="text"
                       id="serviceSearch"
                       placeholder="Search services..." />

            </div>

        </div>


        @if (!services.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fas fa-concierge-bell"></i>
                </div>

                <h3>No services found</h3>

                <p>
                    There are currently no services configured.
                    Create your first service to make it available
                    for residence assignment.
                </p>

                <a asp-action="Create"
                   class="btn-primary">
                    <i class="fas fa-plus"></i>
                    Create First Service
                </a>

            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table class="services-table">

                    <thead>

                        <tr>

                            <th>Service</th>

                            <th>Description</th>

                            <th>Service ID</th>

                            <th class="actions-column">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody id="servicesTableBody">

                        @foreach (var service in services)
                        {
                            <tr class="service-row">

                                <!-- Service -->
                                <td>

                                    <div class="service-name">

                                        <div class="service-icon">
                                            <i class="@GetServiceIcon(service.ServiceName)"></i>
                                        </div>

                                        <div>

                                            <strong>
                                                @service.ServiceName
                                            </strong>

                                            <small>
                                                Residence facility
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- Description -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(service.Description))
                                    {
                                        <div class="service-description">
                                            @service.Description
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="muted">
                                            No description provided
                                        </span>
                                    }

                                </td>


                                <!-- ID -->
                                <td>

                                    <span class="service-id">
                                        #@service.ServiceID
                                    </span>

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Edit"
                                           asp-route-id="@service.ServiceID"
                                           class="action-btn edit"
                                           title="Edit service">

                                            <i class="fas fa-pen"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- No Search Results -->
            <div id="noSearchResults"
                 class="no-search-results"
                 style="display:none;">

                <div class="empty-icon">
                    <i class="fas fa-magnifying-glass"></i>
                </div>

                <h3>No matching services</h3>

                <p>
                    Try searching with a different service name
                    or description.
                </p>

            </div>
        }

    </div>

</div>


@functions {

    string GetServiceIcon(string? serviceName)
    {
        if (string.IsNullOrWhiteSpace(serviceName))
            return "fas fa-circle-check";

        var name = serviceName.ToLowerInvariant();

        if (name.Contains("water"))
            return "fas fa-droplet";

        if (name.Contains("electric"))
            return "fas fa-bolt";

        if (name.Contains("wifi") ||
            name.Contains("wi-fi") ||
            name.Contains("internet"))
            return "fas fa-wifi";

        if (name.Contains("security"))
            return "fas fa-shield-halved";

        if (name.Contains("parking"))
            return "fas fa-square-parking";

        if (name.Contains("laundry"))
            return "fas fa-shirt";

        if (name.Contains("refuse") ||
            name.Contains("waste"))
            return "fas fa-trash";

        return "fas fa-circle-check";
    }

}


<style>

    .services-page {
        background: #f6f8fb;
        min-height: calc(100vh - 80px);
        padding: 32px;
        color: #172033;
    }


    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        margin-bottom: 8px;
    }

        .page-eyebrow i {
            margin-right: 6px;
        }

    .page-header h1 {
        margin: 0;
        color: #172033;
        font-size: 30px;
        font-weight: 800;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }


    /* BUTTON */

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 17px;
        background: #2563eb;
        color: #fff;
        border-radius: 9px;
        text-decoration: none;
        border: none;
        font-size: 13px;
        font-weight: 750;
        box-shadow: 0 4px 10px rgba(37,99,235,.18);
        transition: .2s;
    }

        .btn-primary:hover {
            background: #1d4ed8;
            color: #fff;
            transform: translateY(-1px);
        }


    /* STATISTICS */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px;
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(15,23,42,.04);
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .stat-icon.blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.green {
            background: #ecfdf3;
            color: #16a34a;
        }

        .stat-icon.gold {
            background: #fffbeb;
            color: #b8860b;
        }

    .stat-card span {
        display: block;
        margin-bottom: 3px;
        color: #7b8494;
        font-size: 11px;
        font-weight: 650;
    }

    .stat-card strong {
        display: block;
        color: #172033;
        font-size: 18px;
        font-weight: 800;
    }


    /* MANAGEMENT CARD */

    .management-card {
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(15,23,42,.05);
        overflow: hidden;
    }

    .management-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f4;
    }

        .management-header h2 {
            margin: 0;
            color: #172033;
            font-size: 18px;
            font-weight: 800;
        }

        .management-header p {
            margin: 4px 0 0;
            color: #7b8494;
            font-size: 12px;
        }


    /* SEARCH */

    .search-wrapper {
        position: relative;
        width: 270px;
    }

        .search-wrapper i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 12px;
        }

        .search-wrapper input {
            width: 100%;
            height: 40px;
            box-sizing: border-box;
            padding: 8px 12px 8px 36px;
            border: 1px solid #dce1e8;
            border-radius: 8px;
            outline: none;
            font-size: 12px;
            color: #172033;
            transition: .2s;
        }

            .search-wrapper input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37,99,235,.08);
            }


    /* TABLE */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .services-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
    }

        .services-table th {
            padding: 13px 18px;
            background: #fafbfc;
            border-bottom: 1px solid #e9edf2;
            color: #7b8494;
            text-align: left;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .7px;
        }

        .services-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #edf0f4;
            vertical-align: middle;
            font-size: 13px;
        }

        .services-table tbody tr {
            transition: .15s;
        }

            .services-table tbody tr:hover {
                background: #fbfdff;
            }


    /* SERVICE */

    .service-name {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .service-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .service-name strong {
        display: block;
        color: #172033;
        font-size: 13px;
        font-weight: 800;
    }

    .service-name small {
        display: block;
        margin-top: 3px;
        color: #9aa2b1;
        font-size: 10px;
    }

    .service-description {
        max-width: 420px;
        color: #596273;
        font-size: 12px;
        line-height: 1.5;
    }

    .muted {
        color: #a0a7b3;
        font-size: 12px;
    }

    .service-id {
        display: inline-block;
        padding: 5px 8px;
        background: #f3f4f6;
        color: #6b7280;
        border-radius: 6px;
        font-family: monospace;
        font-size: 11px;
    }


    /* ACTION */

    .actions-column {
        text-align: right !important;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e1e5eb;
        border-radius: 8px;
        background: #fff;
        color: #2563eb;
        text-decoration: none;
        font-size: 11px;
        transition: .18s;
    }

        .action-btn:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
        }


    /* EMPTY */

    .empty-state {
        max-width: 600px;
        margin: auto;
        padding: 70px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .empty-state h3,
    .no-search-results h3 {
        margin: 0;
        color: #172033;
        font-size: 19px;
        font-weight: 800;
    }

    .empty-state p,
    .no-search-results p {
        max-width: 500px;
        margin: 8px auto 20px;
        color: #7b8494;
        font-size: 13px;
        line-height: 1.6;
    }

    .no-search-results {
        padding: 60px 25px;
        text-align: center;
    }


    /* RESPONSIVE */

    @@media (max-width: 800px) {

        .services-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .management-header {
            align-items: stretch;
            flex-direction: column;
        }

        .search-wrapper {
            width: 100%;
        }
    }
</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("serviceSearch");

        const rows =
            document.querySelectorAll(".service-row");

        const noResults =
            document.getElementById("noSearchResults");


        if (!searchInput) {
            return;
        }


        searchInput.addEventListener("input", function () {

            const searchTerm =
                this.value.toLowerCase().trim();

            let visibleRows = 0;


            rows.forEach(function (row) {

                const text =
                    row.textContent.toLowerCase();

                if (text.includes(searchTerm)) {

                    row.style.display = "";

                    visibleRows++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (noResults) {

                noResults.style.display =
                    visibleRows === 0 ? "block" : "none";

            }

        });

    });

</script>