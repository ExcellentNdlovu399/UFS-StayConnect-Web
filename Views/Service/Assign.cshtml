@model UFSStayConnect.ViewModels.ServiceAssignmentViewModel

@{
    ViewData["Title"] = "Residence Services";
}

<style>
    .services-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .services-header {
        background: linear-gradient(135deg, #123c69, #176b87);
        color: white;
        padding: 28px;
        border-radius: 16px;
        margin-bottom: 24px;
    }

    .service-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
        transition: box-shadow .2s ease, transform .2s ease;
    }

        .service-card:hover {
            box-shadow: 0 8px 24px rgba(15, 23, 42, .08);
            transform: translateY(-2px);
        }

        .service-card .card-header {
            background: #f8fafc;
            padding: 18px 20px;
            border-bottom: 1px solid #e2e8f0;
        }

        .service-card .card-body {
            padding: 22px;
        }

    .service-icon {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #e8f1ff;
        color: #1769d2;
        border-radius: 12px;
        font-size: 19px;
        flex-shrink: 0;
    }

    .field-label {
        font-size: .875rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 7px;
    }

    .service-card .form-control {
        min-height: 43px;
    }

    .service-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 13px 0;
        border-top: 1px solid #edf0f4;
    }

        .service-option small {
            display: block;
            color: #64748b;
            margin-top: 3px;
        }

    .unit-display {
        min-height: 43px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 12px;
        border: 1px solid #dbe3ec;
        border-radius: 7px;
        background: #f8fafc;
        color: #334155;
    }

        .unit-display .unit-value {
            font-weight: 700;
        }

        .unit-display .unit-badge {
            font-size: .75rem;
            color: #166534;
            background: #dcfce7;
            padding: 4px 8px;
            border-radius: 20px;
            white-space: nowrap;
        }

    .info-panel {
        background: #fff8e6;
        border: 1px solid #f5dfa0;
        border-radius: 12px;
        padding: 17px;
    }

    .section-heading {
        font-weight: 700;
        color: #172b4d;
        margin-bottom: 5px;
    }

    .section-description {
        color: #64748b;
        margin-bottom: 0;
    }

    .save-bar {
        position: sticky;
        bottom: 0;
        z-index: 5;
        background: rgba(255, 255, 255, .97);
        backdrop-filter: blur(8px);
        border-top: 1px solid #e2e8f0;
        padding: 16px 0;
        margin-top: 28px;
    }

    .validation-summary-valid {
        display: none;
    }

    @@media (max-width: 576px) {
        .services-header {
            padding: 20px;
        }

        .service-card .card-body {
            padding: 16px;
        }

        .save-bar {
            position: static;
        }
    }
</style>

<div class="container-fluid py-4 services-page">

    <!-- Page heading -->
    <div class="services-header">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="small text-white-50 mb-2">
                    ACCOMMODATION MANAGEMENT
                </div>

                <h2 class="fw-bold mb-2">
                    <i class="fas fa-sliders-h me-2"></i>
                    Residence Services
                </h2>

                <p class="mb-0 text-white-50">
                    Configure service availability, usage rates and free allowances
                    for <strong class="text-white">@Model.AccommodationName</strong>.
                </p>
            </div>

            <a asp-controller="Accommodation"
               asp-action="Manage"
               class="btn btn-light">
                <i class="fas fa-arrow-left me-2"></i>
                Back to Accommodations
            </a>
        </div>
    </div>

    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Validation messages -->
    <div asp-validation-summary="All"
         class="alert alert-danger mb-4"></div>

    <!-- Overview cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex gap-3 align-items-center">
                    <div class="service-icon">
                        <i class="fas fa-house-user"></i>
                    </div>

                    <div>
                        <div class="small text-muted">Accommodation</div>
                        <div class="fw-bold">@Model.AccommodationName</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex gap-3 align-items-center">
                    <div class="service-icon">
                        <i class="fas fa-coins"></i>
                    </div>

                    <div>
                        <div class="small text-muted">Charging method</div>
                        <div class="fw-bold">Pay as you go</div>
                        <small class="text-muted">
                            Charges depend on recorded usage
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex gap-3 align-items-center">
                    <div class="service-icon">
                        <i class="fas fa-car"></i>
                    </div>

                    <div>
                        <div class="small text-muted">Parking allowance</div>
                        <div class="fw-bold">First car free</div>
                        <small class="text-muted">
                            Set the additional-car rate below
                        </small>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Instructions -->
    <div class="info-panel mb-4">
        <div class="d-flex gap-3">
            <i class="fas fa-info-circle text-warning fs-4 mt-1"></i>

            <div>
                <h6 class="fw-bold mb-1">How service charges work</h6>

                <p class="mb-2">
                    Enable the services offered by this accommodation and set
                    the rate charged for each unit used. Service charges are
                    separate from accommodation rent.
                </p>

                <p class="mb-0">
                    <strong>Parking example:</strong>
                    If the rate is R100 per car and the free allowance is 1,
                    one car costs R0, two cars cost R100, and three cars cost R200.
                </p>

                <small class="text-muted d-block mt-2">
                    Units of measure are assigned automatically. You do not
                    need to enter them yourself.
                </small>
            </div>
        </div>
    </div>

    <!-- Service configuration form -->
    <form asp-controller="Service"
          asp-action="Assign"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="AccommodationID" />

        <div class="mb-4">
            <h4 class="section-heading">Available services</h4>

            <p class="section-description">
                Enable a service to assign it to this accommodation.
                Unselected services will be removed from the accommodation.
            </p>
        </div>

        <div class="row g-4">

            @for (var i = 0; i < Model.Services.Count; i++)
            {
                var serviceName = Model.Services[i].ServiceName ?? "";

                var icon =
                    serviceName.Contains("water", StringComparison.OrdinalIgnoreCase)
                        ? "fa-tint"
                    : serviceName.Contains("electricity", StringComparison.OrdinalIgnoreCase)
                        ? "fa-bolt"
                    : serviceName.Contains("wifi", StringComparison.OrdinalIgnoreCase)
                        || serviceName.Contains("wi-fi", StringComparison.OrdinalIgnoreCase)
                        || serviceName.Contains("internet", StringComparison.OrdinalIgnoreCase)
                        ? "fa-wifi"
                    : serviceName.Contains("security", StringComparison.OrdinalIgnoreCase)
                        ? "fa-shield-alt"
                    : serviceName.Contains("parking", StringComparison.OrdinalIgnoreCase)
                        ? "fa-car"
                    : serviceName.Contains("laundry", StringComparison.OrdinalIgnoreCase)
                        ? "fa-tshirt"
                    : serviceName.Contains("refuse", StringComparison.OrdinalIgnoreCase)
                        || serviceName.Contains("waste", StringComparison.OrdinalIgnoreCase)
                        ? "fa-trash-alt"
                    : "fa-concierge-bell";

                <div class="col-12 col-xl-6" id="service-@i">
                    <div class="card service-card h-100 shadow-sm">

                        <!-- Service heading -->
                        <div class="card-header">
                            <div class="d-flex align-items-center gap-3">

                                <div class="service-icon">
                                    <i class="fas @icon"></i>
                                </div>

                                <div class="flex-grow-1">
                                    <h5 class="fw-bold mb-1">
                                        @Model.Services[i].ServiceName
                                    </h5>

                                    <p class="small text-muted mb-0">
                                        @(string.IsNullOrWhiteSpace(
                                            Model.Services[i].Description)
                                            ? "Configure this residence service."
                                            : Model.Services[i].Description)
                                    </p>
                                </div>

                            </div>
                        </div>

                        <div class="card-body">

                            <!-- Values required for model binding -->
                            <input type="hidden"
                                   asp-for="Services[i].ServiceID" />

                            <input type="hidden"
                                   asp-for="Services[i].ServiceName" />

                            <input type="hidden"
                                   asp-for="Services[i].UnitOfMeasure" />

                            <!-- All services are pay-as-you-go -->
                            <input type="hidden"
                                   name="Services[@i].IsPayAsYouGo"
                                   value="true" />

                            <!-- Enable/disable service assignment -->
                            <div class="service-option pt-0 border-0">
                                <div>
                                    <span class="fw-semibold">Offer this service</span>
                                    <small>
                                        Assign this service to the accommodation
                                    </small>
                                </div>

                                <div class="form-check form-switch">
                                    <input asp-for="Services[i].Selected"
                                           class="form-check-input"
                                           role="switch" />
                                </div>
                            </div>

                            <div class="row g-3 mt-1">

                                <!-- Rate -->
                                <div class="col-sm-6">
                                    <label asp-for="Services[i].RatePerUnit"
                                           class="form-label field-label">
                                        Rate per unit (R)
                                    </label>

                                    <input asp-for="Services[i].RatePerUnit"
                                           class="form-control"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           required />

                                    <span asp-validation-for="Services[i].RatePerUnit"
                                          class="text-danger small"></span>
                                </div>

                                <!-- Automatically assigned unit -->
                                <div class="col-sm-6">
                                    <label class="form-label field-label">
                                        Unit of measure
                                    </label>

                                    <div class="unit-display">
                                        <span class="unit-value">
                                            @Model.Services[i].UnitOfMeasure
                                        </span>

                                        <span class="unit-badge">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Automatic
                                        </span>
                                    </div>
                                </div>

                                <!-- Free allowance -->
                                <div class="col-12">
                                    <label asp-for="Services[i].FreeUnits"
                                           class="form-label field-label">
                                        Free units
                                    </label>

                                    <input asp-for="Services[i].FreeUnits"
                                           class="form-control"
                                           type="number"
                                           min="0"
                                           max="1000"
                                           required />

                                    <small class="text-muted d-block mt-1">
                                        For parking, use 1 to make the first car
                                        free. For other services, enter the
                                        applicable free allowance.
                                    </small>

                                    <span asp-validation-for="Services[i].FreeUnits"
                                          class="text-danger small"></span>
                                </div>

                            </div>

                            <!-- Charging model -->
                            <div class="service-option mt-3">
                                <div>
                                    <span class="fw-semibold">Pay as you go</span>
                                    <small>
                                        Charge according to recorded usage
                                    </small>
                                </div>

                                <span class="badge bg-success">
                                    <i class="fas fa-check me-1"></i>
                                    Enabled
                                </span>
                            </div>

                            <!-- Availability -->
                            <div class="service-option">
                                <div>
                                    <span class="fw-semibold">Currently available</span>
                                    <small>
                                        Allow this service to be used
                                    </small>
                                </div>

                                <div class="form-check form-switch">
                                    <input asp-for="Services[i].IsEnabled"
                                           class="form-check-input"
                                           role="switch" />
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Save bar -->
        <div class="save-bar">
            <div class="container-fluid px-0 d-flex flex-wrap
                justify-content-between align-items-center gap-3">

                <div>
                    <div class="fw-semibold">
                        Ready to save your changes?
                    </div>

                    <small class="text-muted">
                        Your service settings apply to this accommodation.
                    </small>
                </div>

                <div class="d-flex gap-2">

                    <a asp-controller="Accommodation"
                       asp-action="Manage"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>
                        Save Service Settings
                    </button>

                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
