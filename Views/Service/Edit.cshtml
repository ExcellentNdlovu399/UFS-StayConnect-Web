@model UFSStayConnect.Models.Service

@{
    ViewData["Title"] = "Edit Service";
}

<div class="service-form-page">

    <div class="page-header">

        <div>

            <div class="page-eyebrow">
                <i class="fas fa-concierge-bell"></i>
                SERVICE MANAGEMENT
            </div>

            <h1>Edit Service</h1>

            <p>
                Update the information for this residence service.
            </p>

        </div>

        <a asp-action="Index"
           class="btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Services
        </a>

    </div>


    <div class="form-card">

        <div class="form-card-header">

            <div class="header-icon">
                <i class="fas fa-pen-to-square"></i>
            </div>

            <div>

                <h2>Edit Service</h2>

                <p>
                    Update the service name and description.
                </p>

            </div>

        </div>


        <form asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="ServiceID" />


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="ServiceName">
                        Service Name
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-tag"></i>

                        <input asp-for="ServiceName"
                               class="form-control"
                               placeholder="Service name" />

                    </div>

                    <span asp-validation-for="ServiceName"
                          class="field-error">
                    </span>

                </div>


                <div class="form-group full-width">

                    <label asp-for="Description">
                        Description
                    </label>

                    <div class="textarea-wrapper">

                        <i class="fas fa-align-left"></i>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Describe the service..."></textarea>

                    </div>

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>

                </div>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">
                    <i class="fas fa-check"></i>
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .service-form-page {
        background: #f6f8fb;
        min-height: calc(100vh - 80px);
        padding: 32px;
        color: #172033;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        margin-bottom: 8px;
    }

        .page-eyebrow i {
            margin-right: 6px;
        }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .btn-secondary,
    .btn-cancel,
    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s;
    }

    .btn-secondary {
        min-height: 42px;
        padding: 10px 16px;
        background: #fff;
        border: 1px solid #d9dee8;
        color: #374151;
    }

        .btn-secondary:hover {
            color: #2563eb;
            border-color: #2563eb;
        }

    .form-card {
        max-width: 850px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(15,23,42,.05);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 23px 26px;
        border-bottom: 1px solid #edf0f4;
    }

    .header-icon {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-card-header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
    }

    .form-card-header p {
        margin: 4px 0 0;
        color: #7b8494;
        font-size: 12px;
    }

    form {
        padding: 26px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 21px;
    }

    .full-width {
        width: 100%;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: 13px;
        font-weight: 750;
    }

        .form-group label span {
            color: #dc2626;
        }

    .input-wrapper,
    .textarea-wrapper {
        position: relative;
    }

        .input-wrapper > i,
        .textarea-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            z-index: 2;
            pointer-events: none;
        }

        .textarea-wrapper > i {
            top: 18px;
            transform: none;
        }

    .form-control {
        width: 100%;
        min-height: 46px;
        box-sizing: border-box;
        padding: 10px 13px 10px 40px;
        border: 1px solid #dce1e8;
        border-radius: 9px;
        color: #172033;
        font-size: 14px;
        transition: .2s;
    }

    textarea.form-control {
        resize: vertical;
        padding-top: 12px;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }

    .field-error {
        color: #dc2626;
        font-size: 12px;
    }

    .validation-summary {
        margin-bottom: 20px;
        padding: 12px 14px;
        border-radius: 8px;
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
        font-size: 12px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

    .btn-cancel {
        min-height: 43px;
        padding: 10px 18px;
        background: #f3f4f6;
        color: #4b5563;
    }

    .btn-save {
        min-height: 43px;
        padding: 10px 20px;
        background: #2563eb;
        color: #fff;
        border: none;
        box-shadow: 0 4px 10px rgba(37,99,235,.2);
    }

        .btn-save:hover {
            background: #1d4ed8;
        }

    @@media (max-width: 700px) {

        .service-form-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
        }

        .form-card-header,
        form {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
        }
    }
</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}