@model UFSStayConnect.ViewModels.RoomViewModel

@{
    ViewData["Title"] = "Add Room";
    var accommodation = ViewBag.Accommodation as UFSStayConnect.Models.Accommodation;
}

<div class="room-form-page">

    <!-- Header -->
    <div class="page-header">

        <div>
            <div class="page-eyebrow">
                <i class="fas fa-door-open"></i>
                ROOM MANAGEMENT
            </div>

            <h1>Add Room</h1>

            <p>
                Create a new room for
                <strong>@(accommodation?.Name ?? "this accommodation")</strong>.
            </p>
        </div>

        <a asp-action="Manage"
           asp-route-accommodationId="@Model.AccommodationID"
           class="btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Rooms
        </a>

    </div>


    <!-- Residence Banner -->
    <div class="residence-banner">

        <div class="residence-icon">
            <i class="fas fa-building"></i>
        </div>

        <div class="residence-info">

            <span>Residence</span>

            <h2>
                @(accommodation?.Name ?? "Accommodation")
            </h2>

            @if (accommodation != null)
            {
                <p>
                    <i class="fas fa-location-dot"></i>
                    @accommodation.Location
                </p>
            }

        </div>

    </div>


    <!-- Form -->
    <div class="form-card">

        <div class="form-card-header">

            <div>
                <h2>Room Information</h2>

                <p>
                    Enter the details for the new room.
                </p>
            </div>

            <div class="header-icon">
                <i class="fas fa-door-open"></i>
            </div>

        </div>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="AccommodationID" />


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <div class="form-grid">

                <!-- Room Number -->
                <div class="form-group">

                    <label asp-for="RoomNumber">
                        Room Number
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-hashtag"></i>

                        <input asp-for="RoomNumber"
                               class="form-control"
                               placeholder="e.g. A101" />

                    </div>

                    <span asp-validation-for="RoomNumber"
                          class="field-error">
                    </span>

                </div>


                <!-- Floor -->
                <div class="form-group">

                    <label asp-for="Floor">
                        Floor
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-layer-group"></i>

                        <input asp-for="Floor"
                               class="form-control"
                               placeholder="e.g. Ground Floor" />

                    </div>

                    <span asp-validation-for="Floor"
                          class="field-error">
                    </span>

                </div>


                <!-- Room Type -->
                <div class="form-group">

                    <label asp-for="RoomType">
                        Room Type
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-bed"></i>

                        <select asp-for="RoomType"
                                class="form-control">

                            <option value="">Select room type</option>
                            <option value="Standard">Standard</option>
                            <option value="Single">Single</option>
                            <option value="Shared">Shared</option>
                            <option value="Premium">Premium</option>

                        </select>

                    </div>

                    <span asp-validation-for="RoomType"
                          class="field-error">
                    </span>

                </div>


                <!-- Status -->
                <div class="form-group">

                    <label asp-for="Status">
                        Room Status
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-circle-half-stroke"></i>

                        <select asp-for="Status"
                                class="form-control">

                            <option value="Available">Available</option>
                            <option value="Maintenance">Maintenance</option>

                        </select>

                    </div>

                    <span asp-validation-for="Status"
                          class="field-error">
                    </span>

                </div>


                <!-- Description -->
                <div class="form-group full-width">

                    <label asp-for="Description">
                        Description
                    </label>

                    <div class="textarea-wrapper">

                        <i class="fas fa-align-left"></i>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the room, its facilities or any relevant information..."></textarea>

                    </div>

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- Actions -->
            <div class="form-actions">

                <a asp-action="Manage"
                   asp-route-accommodationId="@Model.AccommodationID"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">
                    <i class="fas fa-plus"></i>
                    Save Room
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .room-form-page {
        background: #f6f8fb;
        min-height: calc(100vh - 80px);
        padding: 32px;
        color: #172033;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        margin-bottom: 8px;
    }

        .page-eyebrow i {
            margin-right: 6px;
        }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

        .page-header p strong {
            color: #172033;
        }

    .btn-secondary,
    .btn-cancel,
    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s;
    }

    .btn-secondary {
        min-height: 42px;
        padding: 10px 16px;
        background: #fff;
        color: #374151;
        border: 1px solid #d9dee8;
    }

        .btn-secondary:hover {
            color: #2563eb;
            border-color: #2563eb;
            background: #f8fbff;
        }

    .residence-banner {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 24px;
        margin-bottom: 22px;
        border-radius: 14px;
        background: linear-gradient(135deg, #123b73, #1e4f91);
        color: #fff;
        box-shadow: 0 8px 24px rgba(18,59,115,.15);
    }

    .residence-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 12px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .residence-info span {
        display: block;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: .7;
    }

    .residence-info h2 {
        margin: 3px 0;
        font-size: 20px;
        font-weight: 800;
    }

    .residence-info p {
        margin: 0;
        font-size: 12px;
        opacity: .8;
    }

        .residence-info p i {
            margin-right: 5px;
        }

    .form-card {
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(15,23,42,.05);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f4;
    }

        .form-card-header h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
        }

        .form-card-header p {
            margin: 4px 0 0;
            color: #7b8494;
            font-size: 12px;
        }

    .header-icon {
        width: 45px;
        height: 45px;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    form {
        padding: 26px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 21px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: 13px;
        font-weight: 750;
    }

        .form-group label span {
            color: #dc2626;
        }

    .input-wrapper,
    .textarea-wrapper {
        position: relative;
    }

        .input-wrapper > i,
        .textarea-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            pointer-events: none;
            z-index: 2;
        }

        .textarea-wrapper > i {
            top: 18px;
            transform: none;
        }

    .form-control {
        width: 100%;
        min-height: 46px;
        box-sizing: border-box;
        padding: 10px 13px 10px 40px;
        border: 1px solid #dce1e8;
        border-radius: 9px;
        background: #fff;
        color: #172033;
        font-size: 14px;
        transition: .2s;
    }

    textarea.form-control {
        resize: vertical;
        padding-top: 12px;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.10);
    }

    .field-error {
        color: #dc2626;
        font-size: 12px;
    }

    .validation-summary {
        margin-bottom: 20px;
        padding: 12px 14px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 12px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

    .btn-cancel {
        min-height: 43px;
        padding: 10px 18px;
        background: #f3f4f6;
        color: #4b5563;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

    .btn-save {
        min-height: 43px;
        padding: 10px 20px;
        background: #2563eb;
        color: #fff;
        border: none;
        box-shadow: 0 4px 10px rgba(37,99,235,.2);
    }

        .btn-save:hover {
            background: #1d4ed8;
        }

    @@media (max-width: 700px) {

        .room-form-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .form-card-header,
        form {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
        }
    }
</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}