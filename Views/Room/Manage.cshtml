@model IEnumerable<UFSStayConnect.Models.Room>
@{ ViewData["Title"]="Manage Rooms"; var accommodation=ViewBag.Accommodation as UFSStayConnect.Models.Accommodation; }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold">Rooms</h2><p class="text-muted mb-0">@(accommodation?.Name ?? "Residence")</p></div><a asp-action="Create" asp-route-accommodationId="@accommodation?.AccommodationID" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Room</a></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="px-4">Room</th><th>Floor</th><th>Type</th><th>Status</th><th class="text-end px-4">Actions</th></tr></thead><tbody>@foreach(var r in Model){var cls=r.Status=="Occupied"?"bg-danger-subtle text-danger":r.Status=="Maintenance"?"bg-secondary-subtle text-secondary":"bg-success-subtle text-success";<tr><td class="px-4 fw-bold">Room @r.RoomNumber</td><td>@(r.Floor??"—")</td><td>@r.RoomType</td><td><span class="badge @cls">@r.Status</span></td><td class="text-end px-4"><a asp-action="Edit" asp-route-id="@r.RoomID" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen"></i></a>@if(r.Status!="Occupied"){<form asp-action="Delete" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.RoomID"/><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></form>}</td></tr>}</tbody></table></div></div></div>
