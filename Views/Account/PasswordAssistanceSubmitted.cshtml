@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Request Submitted";
}

<style>
    .request-page {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: #f8f9fa;
    }

    .success-card {
        width: 100%;
        max-width: 650px;
        border: none;
        border-radius: 24px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
    }

    .success-header {
        padding: 45px 30px 35px;
        text-align: center;
        background: linear-gradient(
            135deg,
            #f0fff4 0%,
            #e8f8ee 100%
        );
        border-bottom: 1px solid #d9f0df;
    }

    .success-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #198754;
        color: #ffffff;
        box-shadow: 0 10px 25px rgba(25, 135, 84, 0.25);
        animation: successPop 0.5s ease-out;
    }

    .success-icon i {
        font-size: 42px;
    }

    .success-header h2 {
        font-size: 1.9rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 8px;
    }

    .success-header p {
        margin: 0;
        color: #6c757d;
        font-size: 0.95rem;
    }

    .success-body {
        padding: 35px;
        text-align: center;
    }

    .success-message {
        font-size: 1rem;
        color: #495057;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .process-info {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        text-align: left;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: 18px;
        margin: 25px 0;
    }

    .process-info-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e9f2ff;
        color: #0d6efd;
    }

    .process-info-content strong {
        display: block;
        color: #343a40;
        margin-bottom: 4px;
    }

    .process-info-content span {
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .return-login-btn {
        min-height: 48px;
        border-radius: 10px;
        padding: 0 25px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .return-login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(13, 110, 253, 0.2);
    }

    .reference-note {
        margin-top: 20px;
        color: #8a8f94;
        font-size: 0.8rem;
    }

    @@keyframes successPop {
        0% {
            transform: scale(0.7);
            opacity: 0;
        }

        70% {
            transform: scale(1.08);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@media (max-width: 576px) {

        .request-page {
            padding: 25px 12px;
        }

        .success-header {
            padding: 35px 20px 30px;
        }

        .success-body {
            padding: 28px 20px;
        }

        .success-header h2 {
            font-size: 1.55rem;
        }

        .success-icon {
            width: 75px;
            height: 75px;
        }

        .success-icon i {
            font-size: 34px;
        }

        .return-login-btn {
            width: 100%;
        }
    }
</style>

<div class="request-page">

    <div class="success-card">

        <!-- Success Header -->
        <div class="success-header">

            <div class="success-icon">
                <i class="fas fa-check"></i>
            </div>

            <h2>Request Submitted</h2>

            <p>
                Your password assistance request has been received successfully.
            </p>

        </div>

        <!-- Content -->
        <div class="success-body">

            <p class="success-message">
                Your password assistance request has been submitted successfully.
                Please wait while a Financial Officer verifies your details and
                processes your request.
            </p>

            <!-- Processing Information -->
            <div class="process-info">

                <div class="process-info-icon">
                    <i class="fas fa-user-shield"></i>
                </div>

                <div class="process-info-content">

                    <strong>What happens next?</strong>

                    <span>
                        A Financial Officer will verify the information you
                        provided and process your password assistance request.
                    </span>

                </div>

            </div>

            <!-- Login Button -->
            <a asp-action="Login"
               asp-controller="Account"
               class="btn btn-primary return-login-btn">

                <i class="fas fa-arrow-left me-2"></i>
                Return to Login

            </a>

            <div class="reference-note">
                <i class="fas fa-lock me-1"></i>
                Your request is handled securely.
            </div>

        </div>

    </div>

</div>