@model UFSStayConnect.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="customer-password-page">

    <!-- =========================
         HEADER
         ========================= -->

    <div class="password-page-header">

        <div>

            <div class="password-eyebrow">
                <i class="fas fa-shield-halved"></i>
                ACCOUNT SECURITY
            </div>

            <h1>Change Password</h1>

            <p>
                Update your password to help keep your UFS StayConnect account secure.
            </p>

        </div>

        <div class="password-header-icon">
            <i class="fas fa-lock"></i>
        </div>

    </div>


    <!-- =========================
         SUCCESS MESSAGE
         ========================= -->
    @if (TempData["Success"] != null)
    {
        <div class="password-success-alert">

            <div class="password-success-icon">
                <i class="fas fa-check"></i>
            </div>

            <div>
                <strong>Password updated</strong>
                <span>@TempData["Success"]</span>
            </div>

        </div>
    }


    <div class="password-layout">

        <!-- SECURITY INFORMATION -->
        <aside class="password-info-card">

            <div class="password-lock-circle">
                <i class="fas fa-lock"></i>
            </div>

            <h2>Keep your account secure</h2>

            <p>
                Your password protects your personal information,
                accommodation applications and payment activity.
            </p>


            <div class="password-security-item">

                <div>
                    <i class="fas fa-check"></i>
                </div>

                <span>
                    Use a password that is difficult for others to guess.
                </span>

            </div>


            <div class="password-security-item">

                <div>
                    <i class="fas fa-check"></i>
                </div>

                <span>
                    Avoid using your student number or personal information.
                </span>

            </div>


            <div class="password-security-item">

                <div>
                    <i class="fas fa-check"></i>
                </div>

                <span>
                    Never share your UFS StayConnect password with anyone.
                </span>

            </div>


            <div class="password-security-note">

                <i class="fas fa-shield-halved"></i>

                <span>
                    After changing your password, your current account
                    session will remain securely signed in.
                </span>

            </div>

        </aside>


        <!-- PASSWORD FORM -->
        <section class="password-form-card">

            <div class="password-form-heading">

                <div>
                    <span>SECURITY SETTINGS</span>
                    <h2>Update Your Password</h2>
                </div>

                <div class="password-form-icon">
                    <i class="fas fa-key"></i>
                </div>

            </div>


            <form asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="password-validation">
                </div>


                <div class="password-form-content">

                    <!-- Current Password -->
                    <div class="password-field">

                        <label asp-for="CurrentPassword">
                            Current Password
                        </label>

                        <div class="password-input-wrapper">

                            <i class="fas fa-lock password-field-icon"></i>

                            <input asp-for="CurrentPassword"
                                   type="password"
                                   class="password-input"
                                   autocomplete="current-password"
                                   id="CurrentPassword" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="CurrentPassword"
                                    aria-label="Show current password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="CurrentPassword"
                              class="password-field-error">
                        </span>

                    </div>


                    <!-- New Password -->
                    <div class="password-field">

                        <label asp-for="NewPassword">
                            New Password
                        </label>

                        <div class="password-input-wrapper">

                            <i class="fas fa-key password-field-icon"></i>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="password-input"
                                   autocomplete="new-password"
                                   id="NewPassword" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="NewPassword"
                                    aria-label="Show new password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="password-field-error">
                        </span>

                    </div>


                    <!-- Confirm Password -->
                    <div class="password-field">

                        <label asp-for="ConfirmNewPassword">
                            Confirm New Password
                        </label>

                        <div class="password-input-wrapper">

                            <i class="fas fa-key password-field-icon"></i>

                            <input asp-for="ConfirmNewPassword"
                                   type="password"
                                   class="password-input"
                                   autocomplete="new-password"
                                   id="ConfirmNewPassword" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="ConfirmNewPassword"
                                    aria-label="Show confirmed password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmNewPassword"
                              class="password-field-error">
                        </span>

                    </div>


                    <!-- Password Guidance -->
                    <div class="password-guidance">

                        <div class="password-guidance-header">

                            <i class="fas fa-circle-info"></i>

                            <strong>Password guidance</strong>

                        </div>

                        <p>
                            Choose a strong password that you do not use
                            for other accounts. Your exact password
                            requirements are enforced by the UFS StayConnect
                            account security settings.
                        </p>

                    </div>

                </div>


                <!-- Footer -->
                <div class="password-form-footer">

                    <a asp-action="Profile"
                       class="password-cancel-btn">

                        <i class="fas fa-arrow-left"></i>
                        Back to Profile

                    </a>

                    <button type="submit"
                            class="password-submit-btn">

                        <i class="fas fa-key"></i>
                        Change Password

                    </button>

                </div>

            </form>

        </section>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.querySelectorAll(".password-toggle").forEach(function (button) {

            button.addEventListener("click", function () {

                const targetId = this.getAttribute("data-target");
                const input = document.getElementById(targetId);
                const icon = this.querySelector("i");

                if (!input) {
                    return;
                }

                if (input.type === "password") {

                    input.type = "text";

                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");

                    this.setAttribute(
                        "aria-label",
                        "Hide password"
                    );

                } else {

                    input.type = "password";

                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");

                    this.setAttribute(
                        "aria-label",
                        "Show password"
                    );
                }

            });

        });

    </script>
}


<style>

    /* =========================================================
           UFS STAYCONNECT - CUSTOMER CHANGE PASSWORD
           ========================================================= */

    .customer-password-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 34px 30px 60px;
    }


    /* =========================
           HEADER
           ========================= */

    .password-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 24px;
    }

    .password-eyebrow {
        margin-bottom: 7px;
        color: #b8860b;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

        .password-eyebrow i {
            margin-right: 5px;
        }

    .password-page-header h1 {
        margin: 0;
        color: #123b73;
        font-size: 2rem;
        font-weight: 800;
    }

    .password-page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 0.93rem;
    }

    .password-header-icon {
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        border-radius: 14px;
        background: #123b73;
        color: #f4c430;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }


    /* =========================
           SUCCESS
           ========================= */

    .password-success-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding: 14px 17px;
        border: 1px solid #c9ecd7;
        border-radius: 10px;
        background: #edf9f2;
        color: #176b3c;
    }

    .password-success-icon {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #d7f2e2;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .password-success-alert strong,
    .password-success-alert span {
        display: block;
    }

    .password-success-alert strong {
        font-size: 0.82rem;
    }

    .password-success-alert span {
        margin-top: 2px;
        font-size: 0.77rem;
    }


    /* =========================
           LAYOUT
           ========================= */

    .password-layout {
        display: grid;
        grid-template-columns: 310px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }


    /* =========================
           INFO CARD
           ========================= */

    .password-info-card {
        padding: 29px 24px;
        background: #123b73;
        border: 1px solid #0f3464;
        border-bottom: 4px solid #f4c430;
        border-radius: 15px;
        color: #ffffff;
        box-shadow: 0 7px 24px rgba(8,20,38,0.08);
    }

    .password-lock-circle {
        width: 58px;
        height: 58px;
        margin-bottom: 20px;
        border: 2px solid #f4c430;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        color: #f4c430;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .password-info-card h2 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .password-info-card > p {
        margin: 9px 0 24px;
        color: rgba(255,255,255,0.72);
        font-size: 0.78rem;
        line-height: 1.65;
    }


    /* =========================
           SECURITY ITEMS
           ========================= */

    .password-security-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 13px;
    }

        .password-security-item > div {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
            border-radius: 50%;
            background: rgba(244,196,48,0.15);
            color: #f4c430;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.57rem;
        }

        .password-security-item span {
            color: rgba(255,255,255,0.78);
            font-size: 0.72rem;
            line-height: 1.5;
        }


    /* =========================
           SECURITY NOTE
           ========================= */

    .password-security-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 25px;
        padding: 12px;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 8px;
        background: rgba(255,255,255,0.06);
    }

        .password-security-note i {
            margin-top: 2px;
            color: #f4c430;
        }

        .password-security-note span {
            color: rgba(255,255,255,0.65);
            font-size: 0.66rem;
            line-height: 1.5;
        }


    /* =========================
           FORM CARD
           ========================= */

    .password-form-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 15px;
        box-shadow: 0 7px 24px rgba(8,20,38,0.055);
    }

    .password-form-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 27px;
        background: #ffffff;
        border-bottom: 1px solid #e7ebf0;
    }

        .password-form-heading > div:first-child > span {
            color: #b8860b;
            font-size: 0.67rem;
            font-weight: 800;
            letter-spacing: 1.2px;
        }

        .password-form-heading h2 {
            margin: 3px 0 0;
            color: #123b73;
            font-size: 1.08rem;
            font-weight: 800;
        }

    .password-form-icon {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: #edf3f9;
        color: #123b73;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    /* =========================
           FORM
           ========================= */

    .password-form-content {
        padding: 27px;
    }

    .password-field {
        margin-bottom: 19px;
    }

        .password-field label {
            display: block;
            margin-bottom: 7px;
            color: #344054;
            font-size: 0.77rem;
            font-weight: 800;
        }

    .password-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .password-field-icon {
        position: absolute;
        left: 13px;
        z-index: 1;
        color: #8290a2;
        font-size: 0.78rem;
        pointer-events: none;
    }

    .password-input {
        width: 100%;
        min-height: 45px;
        padding: 0 45px 0 37px;
        border: 1px solid #dfe5ec;
        border-radius: 8px;
        outline: none;
        background: #ffffff;
        color: #29384d;
        font-size: 0.83rem;
        transition: all 0.2s ease;
    }

        .password-input:focus {
            border-color: #123b73;
            box-shadow: 0 0 0 3px rgba(18,59,115,0.08);
        }

    .password-toggle {
        position: absolute;
        right: 5px;
        width: 35px;
        height: 35px;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: #7b8491;
        cursor: pointer;
    }

        .password-toggle:hover {
            background: #f1f4f7;
            color: #123b73;
        }

    .password-field-error {
        display: block;
        margin-top: 5px;
        color: #c0392b;
        font-size: 0.68rem;
    }


    /* =========================
           VALIDATION
           ========================= */

    .password-validation {
        margin: 20px 27px 0;
        color: #c0392b;
        font-size: 0.77rem;
    }

        .password-validation ul {
            margin-bottom: 0;
        }


    /* =========================
           GUIDANCE
           ========================= */

    .password-guidance {
        margin-top: 5px;
        padding: 14px 15px;
        border: 1px solid #dce7f4;
        border-radius: 9px;
        background: #f5f9fe;
    }

    .password-guidance-header {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #123b73;
    }

        .password-guidance-header i {
            color: #b8860b;
        }

        .password-guidance-header strong {
            font-size: 0.75rem;
        }

    .password-guidance p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 0.7rem;
        line-height: 1.55;
    }


    /* =========================
           FOOTER
           ========================= */

    .password-form-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 17px 27px;
        border-top: 1px solid #edf0f4;
        background: #fafbfc;
    }

    .password-cancel-btn,
    .password-submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 41px;
        padding: 0 16px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 750;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .password-cancel-btn {
        border: 1px solid #d9e1eb;
        background: #ffffff;
        color: #123b73;
    }

        .password-cancel-btn:hover {
            background: #f1f5f9;
            color: #123b73;
        }

    .password-submit-btn {
        border: 1px solid #123b73;
        background: #123b73;
        color: #ffffff;
        cursor: pointer;
    }

        .password-submit-btn:hover {
            background: #0d2d58;
            border-color: #0d2d58;
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 900px) {

        .password-layout {
            grid-template-columns: 1fr;
        }

        .password-info-card {
            display: grid;
            grid-template-columns: auto 1fr;
            column-gap: 18px;
        }

        .password-lock-circle {
            grid-row: span 2;
            margin-bottom: 0;
        }

        .password-info-card > p {
            margin-bottom: 10px;
        }

        .password-security-item,
        .password-security-note {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 650px) {

        .customer-password-page {
            padding: 25px 16px 45px;
        }

        .password-page-header {
            align-items: flex-start;
        }

        .password-header-icon {
            display: none;
        }

        .password-info-card {
            display: block;
        }

        .password-lock-circle {
            margin-bottom: 18px;
        }

        .password-form-content {
            padding: 21px;
        }

        .password-form-heading {
            padding: 20px;
        }

        .password-form-footer {
            padding: 15px 20px;
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .password-cancel-btn,
        .password-submit-btn {
            width: 100%;
        }
    }

</style>