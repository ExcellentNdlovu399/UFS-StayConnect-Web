@model UFSStayConnect.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login | UFS StayConnect</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            background: #f4f6f8;
            color: #17213c;
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px;
            background:
                radial-gradient(circle at top left, rgba(0, 87, 183, 0.08), transparent 35%),
                #f4f6f8;
        }

        .auth-shell {
            width: min(1180px, 100%);
            min-height: 690px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: white;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(15, 31, 56, 0.18);
        }

        /* LEFT IMAGE */

        .auth-image {
            position: relative;
            min-height: 690px;
            background-image:
                linear-gradient(
                    to top,
                    rgba(8, 20, 38, 0.82),
                    rgba(8, 20, 38, 0.10) 65%
                ),
                url('/images/auth/login-residence.jpg');

            background-size: cover;
            background-position: center;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 35px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 700;
            color: white;
        }

        .brand-logo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,.18);
        }

        .brand-logo img {
            width: 35px;
            height: 35px;
            object-fit: contain;
        }

        .image-content {
            max-width: 480px;
        }

        .image-content h1 {
            font-size: clamp(38px, 4vw, 58px);
            line-height: 1;
            font-weight: 800;
            margin-bottom: 18px;
            letter-spacing: -1.5px;
        }

        .image-content p {
            font-size: 16px;
            line-height: 1.7;
            max-width: 430px;
            color: rgba(255,255,255,.90);
            margin-bottom: 25px;
        }

        .campus-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 10px 16px;
            border-radius: 50px;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.25);
            backdrop-filter: blur(12px);
            font-size: 14px;
        }

        .slide-dots {
            display: flex;
            gap: 7px;
            margin-top: 25px;
        }

        .slide-dots span {
            width: 25px;
            height: 4px;
            border-radius: 10px;
            background: rgba(255,255,255,.45);
        }

        .slide-dots span.active {
            background: white;
            width: 42px;
        }

        /* RIGHT */

        .auth-form-side {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 55px clamp(40px, 6vw, 85px);
        }

        .top-action {
            position: absolute;
            top: 35px;
            right: 45px;
        }

        .top-register {
            color: #17213c;
            border: 1px solid #17213c;
            padding: 10px 22px;
            border-radius: 30px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: .25s ease;
        }

        .top-register:hover {
            background: #17213c;
            color: white;
        }

        .form-heading {
            margin-bottom: 35px;
        }

        .form-heading h2 {
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 8px;
        }

        .form-heading p {
            color: #8b93a7;
            margin: 0;
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            color: #313b52;
            margin-bottom: 8px;
        }

        .form-control {
            height: 54px;
            border: 1px solid #dfe3ea;
            border-radius: 10px;
            padding: 0 16px;
            font-size: 14px;
            transition: .2s ease;
        }

        .form-control:focus {
            border-color: #1769e0;
            box-shadow: 0 0 0 4px rgba(23,105,224,.10);
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 50px;
        }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: #9299a8;
            cursor: pointer;
        }

        .login-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 12px 0 25px;
            font-size: 13px;
        }

        .login-options a {
            color: #7c8494;
            text-decoration: none;
        }

        .login-options a:hover {
            color: #1769e0;
        }

        .login-btn {
            width: 100%;
            height: 54px;
            border: 0;
            border-radius: 10px;
            background: #111111;
            color: white;
            font-weight: 700;
            transition: .25s ease;
        }

        .login-btn:hover {
            background: #1769e0;
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(23,105,224,.20);
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 28px 0;
            color: #a0a7b5;
            font-size: 12px;
        }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e4e7ec;
        }

        .signup-text {
            text-align: center;
            color: #8b93a7;
            font-size: 13px;
            margin-top: 30px;
        }

        .signup-text a {
            color: #1769e0;
            font-weight: 700;
            text-decoration: none;
        }

        .validation-summary-errors {
            margin-bottom: 20px;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
        }

        @@media (max-width: 850px) {

            .auth-page {
                padding: 15px;
            }

            .auth-shell {
                grid-template-columns: 1fr;
                min-height: auto;
            }

            .auth-image {
                min-height: 330px;
                padding: 25px;
            }

            .image-content h1 {
                font-size: 38px;
            }

            .auth-form-side {
                padding: 45px 30px;
            }

            .top-action {
                position: static;
                margin-bottom: 25px;
                text-align: right;
            }
        }

        @@media (max-width: 500px) {

            .auth-page {
                padding: 0;
            }

            .auth-shell {
                border-radius: 0;
                min-height: 100vh;
            }

            .auth-image {
                min-height: 280px;
            }

            .auth-form-side {
                padding: 35px 22px;
            }
        }
    </style>
</head>

<body>

    <div class="auth-page">

        <div class="auth-shell">

            <!-- LEFT -->
            <section class="auth-image">

                <div class="brand">

                    <div class="brand-logo">
                        <img src="/images/ufs-emblem.png"
                             alt="UFS StayConnect">
                    </div>

                    <span>UFS StayConnect</span>

                </div>

                <div class="image-content">

                    <div class="campus-badge mb-3">
                        <i class="fas fa-location-dot"></i>
                        QwaQwa Campus
                    </div>

                    <h1>
                        Find Your<br />
                        Home at UFS.
                    </h1>

                    <p>
                        Discover accommodation, manage your application,
                        stay updated with your residence and manage your
                        payments — all in one place.
                    </p>

                    <div class="slide-dots">
                        <span class="active"></span>
                        <span></span>
                        <span></span>
                    </div>

                </div>

            </section>

            <!-- RIGHT -->
            <section class="auth-form-side">

                <div class="top-action">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="top-register">
                        Register
                    </a>
                </div>

                <div class="form-heading">

                    <h2>Welcome Back!</h2>

                    <p>
                        Sign in to your UFS StayConnect account
                    </p>

                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger validation-summary-errors">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                            UFS Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="example@ufs.ac.za"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-2">

                        <label asp-for="Password"
                               class="form-label">
                            Password
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="Password"
                                   class="form-control"
                                   id="loginPassword"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword()">

                                <i class="fas fa-eye"
                                   id="passwordIcon"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="login-options">

                        <label class="d-flex align-items-center gap-2">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <span>Remember me</span>

                        </label>

                        <a asp-controller="Account"
                           asp-action="PasswordAssistance">
                            Forgot Password?
                        </a>

                    </div>

                    <button type="submit"
                            class="login-btn">
                        Sign In
                    </button>

                </form>

                <div class="signup-text">

                    Don't have an account?

                    <a asp-controller="Account"
                       asp-action="Register">
                        Create an account
                    </a>

                </div>

            </section>

        </div>

    </div>

    <script>

        function togglePassword() {

            const password =
                document.getElementById("loginPassword");

            const icon =
                document.getElementById("passwordIcon");

            if (password.type === "password") {

                password.type = "text";

                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");

            } else {

                password.type = "password";

                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

    </script>

</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}