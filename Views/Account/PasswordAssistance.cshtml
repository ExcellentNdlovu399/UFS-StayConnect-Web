@model UFSStayConnect.ViewModels.PasswordAssistanceViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Password Assistance";
}

<style>
    .password-assistance-page {
        min-height: calc(100vh - 80px);
        padding: 50px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
    }

    .password-assistance-card {
        width: 100%;
        max-width: 680px;
        border: none !important;
        border-radius: 22px !important;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.09) !important;
    }

    .password-assistance-body {
        padding: 45px;
    }

    .password-header-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef4ff;
        color: #0d6efd;
        box-shadow: 0 8px 22px rgba(13, 110, 253, 0.12);
    }

    .password-header-icon i {
        font-size: 36px;
    }

    .password-title {
        color: #212529;
        font-size: 1.9rem;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .password-subtitle {
        max-width: 480px;
        margin: 0 auto;
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .password-form-group {
        margin-bottom: 22px !important;
    }

    .password-form-label {
        color: #343a40;
        font-size: 0.92rem;
        margin-bottom: 8px;
    }

    .password-form-control {
        min-height: 52px;
        border-radius: 11px !important;
        border: 1px solid #dee2e6;
        transition: all 0.2s ease;
    }

    .password-form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    textarea.password-form-control {
        min-height: 120px;
        resize: vertical;
    }

    .password-submit-btn {
        min-height: 52px;
        border-radius: 11px;
        font-weight: 600;
        border: none;
        transition: all 0.2s ease;
    }

    .password-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.22);
    }

    .password-back-link {
        color: #6c757d;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .password-back-link:hover {
        color: #0d6efd;
    }

    .password-security-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 25px;
        padding: 14px 16px;
        border-radius: 12px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        color: #6c757d;
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .password-security-note i {
        color: #0d6efd;
        margin-top: 2px;
    }

    .password-alert {
        border-radius: 11px;
        border: none;
    }

    .password-validation {
        border-radius: 11px;
    }

    @@media (max-width: 576px) {

        .password-assistance-page {
            padding: 25px 12px;
        }

        .password-assistance-body {
            padding: 30px 20px;
        }

        .password-title {
            font-size: 1.55rem;
        }

        .password-header-icon {
            width: 70px;
            height: 70px;
        }

        .password-header-icon i {
            font-size: 30px;
        }

        .password-submit-btn {
            font-size: 0.95rem;
        }
    }
</style>


<div class="password-assistance-page">

    <div class="password-assistance-card">

        <div class="password-assistance-body">

            <div class="text-center mb-4">

                <div class="password-header-icon">
                    <i class="fas fa-key"></i>
                </div>

                <h2 class="password-title mb-2">
                    Password Assistance
                </h2>

                <p class="text-muted password-subtitle">
                    Need help changing your password?
                    Submit a request to a Financial Officer.
                </p>

            </div>


            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger password-alert">
                    <i class="fas fa-circle-exclamation me-2"></i>
                    @TempData["Error"]
                </div>
            }


            <form asp-action="PasswordAssistance"
                  asp-controller="Account"
                  method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger password-validation">
                </div>


                <div class="mb-3 password-form-group">

                    <label asp-for="Email"
                           class="form-label fw-semibold password-form-label">
                        UFS Email
                    </label>

                    <input asp-for="Email"
                           class="form-control form-control-lg password-form-control"
                           placeholder="example@ufs.ac.za"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3 password-form-group">

                    <label asp-for="StudentOrStaffNumber"
                           class="form-label fw-semibold password-form-label">
                        Student / Staff Number
                    </label>

                    <input asp-for="StudentOrStaffNumber"
                           class="form-control form-control-lg password-form-control"
                           placeholder="Enter your student or staff number" />

                    <span asp-validation-for="StudentOrStaffNumber"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4 password-form-group">

                    <label asp-for="Reason"
                           class="form-label fw-semibold password-form-label">
                        Reason for Request
                    </label>

                    <textarea asp-for="Reason"
                              class="form-control password-form-control"
                              rows="4"
                              placeholder="Explain why you need password assistance..."></textarea>

                    <span asp-validation-for="Reason"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary btn-lg w-100 password-submit-btn">

                    <i class="fas fa-paper-plane me-2"></i>
                    Submit Password Assistance Request

                </button>

            </form>


            <div class="password-security-note">

                <i class="fas fa-shield-halved"></i>

                <span>
                    Your request will be reviewed by a Financial Officer
                    before any password changes are made.
                </span>

            </div>


            <div class="text-center mt-4">

                <a asp-action="Login"
                   asp-controller="Account"
                   class="text-decoration-none password-back-link">

                    <i class="fas fa-arrow-left me-1"></i>
                    Back to Login

                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}