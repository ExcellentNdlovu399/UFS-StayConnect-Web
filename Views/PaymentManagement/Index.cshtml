@model IEnumerable<UFSStayConnect.ViewModels.AdminPaymentViewModel>

@{
    ViewData["Title"] = "Payment Management";

    if (User.IsInRole("FinancialOfficer"))
    {
        Layout = "~/Views/FinancialOfficer/_FinancialOfficerLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Admin/_AdminLayout.cshtml";
    }

    var payments = Model?.ToList()
        ?? new List<UFSStayConnect.ViewModels.AdminPaymentViewModel>();

    var totalPayments = payments.Count;

    var pendingPayments = payments.Count(p =>
        string.Equals(p.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    var paidPayments = payments.Count(p =>
        string.Equals(p.Status, "Paid", StringComparison.OrdinalIgnoreCase));

    var rejectedPayments = payments.Count(p =>
        string.Equals(p.Status, "Rejected", StringComparison.OrdinalIgnoreCase));

    var totalValue = payments.Sum(p => p.Amount);

    var paidValue = payments
        .Where(p => string.Equals(p.Status, "Paid", StringComparison.OrdinalIgnoreCase))
        .Sum(p => p.Amount);

    var pendingValue = payments
        .Where(p => string.Equals(p.Status, "Pending", StringComparison.OrdinalIgnoreCase))
        .Sum(p => p.Amount);
}

<style>

    /* =========================================================
           PAYMENT MANAGEMENT CENTRE
           ========================================================= */

    .payment-page {
        padding: 4px 0 40px;
    }

    .payment-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 27px;
    }

        .payment-header h2 {
            margin: 0;
            color: #10233f;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -.4px;
        }

            .payment-header h2 i {
                color: #1769ff;
                margin-right: 8px;
            }

        .payment-header p {
            color: #718096;
            font-size: 14px;
            margin: 7px 0 0;
        }

    .pending-indicator {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 10px;
        background: #fff5df;
        color: #a36a00;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }


    /* =========================================================
           STATISTICS
           ========================================================= */

    .payment-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 27px;
    }

    .payment-stat {
        background: #fff;
        border: 1px solid #edf1f7;
        border-radius: 16px;
        padding: 19px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
        transition: .2s ease;
    }

        .payment-stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(15, 23, 42, .075);
        }

    .payment-stat-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

        .payment-stat-icon.blue {
            background: #eaf2ff;
            color: #1769ff;
        }

        .payment-stat-icon.green {
            background: #eaf9f1;
            color: #159447;
        }

        .payment-stat-icon.orange {
            background: #fff5e6;
            color: #e58a16;
        }

        .payment-stat-icon.red {
            background: #fff0f0;
            color: #d64545;
        }

    .payment-stat-content span {
        display: block;
        color: #7c8999;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .payment-stat-content strong {
        display: block;
        color: #10233f;
        font-size: 21px;
        line-height: 1.15;
        font-weight: 800;
    }

    .payment-stat-content small {
        display: block;
        color: #9aa6b2;
        font-size: 10px;
        margin-top: 3px;
    }


    /* =========================================================
           MAIN PANEL
           ========================================================= */

    .payment-panel {
        background: #fff;
        border: 1px solid #edf1f7;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .045);
        overflow: hidden;
    }

    .payment-panel-header {
        padding: 21px 23px;
        border-bottom: 1px solid #edf1f7;
    }

        .payment-panel-header h3 {
            margin: 0;
            color: #10233f;
            font-size: 17px;
            font-weight: 800;
        }

        .payment-panel-header p {
            margin: 4px 0 0;
            color: #8793a3;
            font-size: 12px;
        }


    /* =========================================================
           FILTER
           ========================================================= */

    .payment-filter {
        padding: 18px 23px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf1f7;
    }

    .payment-filter-form {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 190px auto auto;
        gap: 10px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        color: #5d6b7b;
        font-size: 10px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .filter-select {
        width: 100%;
        height: 41px;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fff;
        color: #3d4d61;
        padding: 0 12px;
        font-size: 12px;
        outline: none;
    }

        .filter-select:focus {
            border-color: #1769ff;
            box-shadow: 0 0 0 3px rgba(23, 105, 255, .07);
        }

    .filter-button {
        height: 41px;
        border-radius: 9px;
        padding: 0 17px;
        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
           PAYMENT TABLE
           ========================================================= */

    .payment-table-wrapper {
        overflow-x: auto;
    }

    .payment-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .payment-table thead th {
            background: #f8fafc;
            border-bottom: 1px solid #e8edf3;
            color: #7b8796;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .55px;
            padding: 14px 12px;
            white-space: nowrap;
        }

            .payment-table thead th:first-child {
                padding-left: 23px;
            }

            .payment-table thead th:last-child {
                padding-right: 23px;
            }

        .payment-table tbody td {
            border-bottom: 1px solid #edf1f5;
            padding: 16px 12px;
            color: #526173;
            font-size: 11px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .payment-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .payment-table tbody tr {
            transition: .15s ease;
        }

            .payment-table tbody tr:hover {
                background: #fbfcff;
            }

        .payment-table tbody td:first-child {
            padding-left: 23px;
        }

        .payment-table tbody td:last-child {
            padding-right: 23px;
        }


    /* =========================================================
           CUSTOMER
           ========================================================= */

    .customer-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .customer-avatar {
        width: 35px;
        height: 35px;
        min-width: 35px;
        border-radius: 9px;
        background: #edf4ff;
        color: #1769ff;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 11px;
        font-weight: 800;
    }

    .customer-name {
        display: block;
        color: #26384e;
        font-size: 11px;
        font-weight: 750;
        margin-bottom: 2px;
    }

    .customer-number {
        display: block;
        color: #9aa6b2;
        font-size: 9px;
    }


    /* =========================================================
           PAYMENT TYPE
           ========================================================= */

    .payment-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #47576b;
        font-weight: 650;
    }

        .payment-type i {
            color: #1769ff;
            font-size: 10px;
        }


    /* =========================================================
           AMOUNT
           ========================================================= */

    .payment-amount {
        color: #172b46;
        font-size: 12px;
        font-weight: 800;
    }


    /* =========================================================
           REFERENCE
           ========================================================= */

    .payment-reference {
        display: inline-flex;
        padding: 5px 7px;
        background: #f6f8fb;
        border-radius: 6px;
        color: #536274;
        font-family: monospace;
        font-size: 9px;
    }


    /* =========================================================
           STATUS
           ========================================================= */

    .payment-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 750;
    }

        .payment-status.paid {
            background: #eaf9f1;
            color: #16804b;
        }

        .payment-status.pending {
            background: #fff5df;
            color: #a36a00;
        }

        .payment-status.rejected {
            background: #fff0f0;
            color: #c83d3d;
        }


    /* =========================================================
           ACTIONS
           ========================================================= */

    .payment-action {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .payment-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
    }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .payment-empty {
        padding: 70px 25px;
        text-align: center;
    }

    .payment-empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 17px;
        border-radius: 18px;
        background: #eef4ff;
        color: #1769ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .payment-empty h4 {
        color: #334155;
        margin: 0 0 7px;
        font-weight: 800;
    }

    .payment-empty p {
        color: #8793a3;
        font-size: 12px;
        margin: 0;
    }


    /* =========================================================
           REJECTION MODAL
           ========================================================= */

    .reject-modal .modal-content {
        border: 0;
        border-radius: 15px;
        overflow: hidden;
    }

    .reject-modal .modal-header {
        padding: 19px 21px;
        border-bottom: 1px solid #edf1f7;
    }

    .reject-modal .modal-title {
        color: #24364c;
        font-size: 17px;
    }

    .reject-modal .modal-body {
        padding: 21px;
    }

    .reject-modal .modal-footer {
        padding: 15px 21px;
        border-top: 1px solid #edf1f7;
    }

    .reject-modal label {
        color: #465568;
        font-size: 12px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1100px) {

        .payment-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 800px) {

        .payment-filter-form {
            grid-template-columns: 1fr 1fr;
        }

        .payment-header {
            flex-direction: column;
        }
    }

    @@media (max-width: 600px) {

        .payment-stats {
            grid-template-columns: 1fr;
        }

        .payment-filter-form {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="payment-page">

    <!-- =====================================================
         HEADER
         ====================================================== -->

    <div class="payment-header">

        <div>

            <h2>
                <i class="fa-solid fa-credit-card"></i>
                Payment Management
            </h2>

            <p>
                Review, verify and manage customer payments.
            </p>

        </div>


        <div class="pending-indicator">

            <i class="fa-solid fa-clock"></i>

            @pendingPayments Pending Review

        </div>

    </div>


    <!-- =====================================================
         STATISTICS
         ====================================================== -->

    <div class="payment-stats">

        <div class="payment-stat">

            <div class="payment-stat-icon blue">
                <i class="fa-solid fa-receipt"></i>
            </div>

            <div class="payment-stat-content">

                <span>Total Transactions</span>

                <strong>
                    @totalPayments
                </strong>

                <small>
                    R @totalValue.ToString("N2") total value
                </small>

            </div>

        </div>


        <div class="payment-stat">

            <div class="payment-stat-icon green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="payment-stat-content">

                <span>Paid</span>

                <strong>
                    @paidPayments
                </strong>

                <small>
                    R @paidValue.ToString("N2") received
                </small>

            </div>

        </div>


        <div class="payment-stat">

            <div class="payment-stat-icon orange">
                <i class="fa-solid fa-clock"></i>
            </div>

            <div class="payment-stat-content">

                <span>Pending Review</span>

                <strong>
                    @pendingPayments
                </strong>

                <small>
                    R @pendingValue.ToString("N2") awaiting verification
                </small>

            </div>

        </div>


        <div class="payment-stat">

            <div class="payment-stat-icon red">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>

            <div class="payment-stat-content">

                <span>Rejected</span>

                <strong>
                    @rejectedPayments
                </strong>

                <small>
                    Transactions rejected
                </small>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MAIN PAYMENT PANEL
         ====================================================== -->

    <div class="payment-panel">

        <div class="payment-panel-header">

            <h3>
                Transaction Directory
            </h3>

            <p>
                Review customer payment submissions and verify
                pending transactions.
            </p>

        </div>


        <!-- =================================================
             FILTERS
             ================================================== -->

        <div class="payment-filter">

            <form method="get"
                  class="payment-filter-form">

                <div class="filter-field">

                    <label>
                        PAYMENT STATUS
                    </label>

                    <select name="status"
                            class="filter-select">

                        <option value="">
                            All statuses
                        </option>

                        <option value="Pending"
                                selected="@(string.Equals((string?)ViewBag.Status, "Pending", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            Pending
                        </option>

                        <option value="Paid"
                                selected="@(string.Equals((string?)ViewBag.Status, "Paid", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            Paid
                        </option>

                        <option value="Rejected"
                                selected="@(string.Equals((string?)ViewBag.Status, "Rejected", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            Rejected
                        </option>

                    </select>

                </div>


                <div class="filter-field">

                    <label>
                        PAYMENT TYPE
                    </label>

                    <select class="filter-select"
                            id="paymentTypeFilter">

                        <option value="all">
                            All payment types
                        </option>

                        <option value="rent">
                            Rent
                        </option>

                        <option value="water">
                            Water
                        </option>

                        <option value="electricity">
                            Electricity
                        </option>

                        <option value="parking">
                            Parking
                        </option>

                        <option value="laundry">
                            Laundry
                        </option>

                        <option value="refuse">
                            Refuse
                        </option>

                    </select>

                </div>


                <button type="submit"
                        class="btn btn-primary filter-button">

                    <i class="fa-solid fa-filter me-1"></i>
                    Filter

                </button>


                <a asp-action="Index"
                   class="btn btn-light border filter-button d-flex align-items-center justify-content-center">

                    Clear

                </a>

            </form>

        </div>


        <!-- =================================================
             PAYMENT TABLE
             ================================================== -->
        @if (payments.Any())
        {
            <div class="payment-table-wrapper">

                <table class="payment-table">

                    <thead>

                        <tr>

                            <th>Customer</th>

                            <th>Accommodation</th>

                            <th>Payment Type</th>

                            <th>Amount</th>

                            <th>Method</th>

                            <th>Reference</th>

                            <th>Submitted</th>

                            <th>Due Date</th>

                            <th>Status</th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var p in payments)
                        {
                            var statusClass =
                            p.Status == "Paid"
                            ? "paid"
                            : p.Status == "Rejected"
                            ? "rejected"
                            : "pending";

                            var customerName =
                            string.IsNullOrWhiteSpace(p.CustomerName)
                            ? "Unknown Customer"
                            : p.CustomerName;

                            var initials =
                            string.Join(
                            "",
                            customerName
                            .Split(
                            ' ',
                            StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x[0]))
                            .ToUpperInvariant();

                            <tr data-payment-type="@p.PaymentType.ToLowerInvariant()">

                                <!-- CUSTOMER -->

                                <td>

                                    <div class="customer-cell">

                                        <div class="customer-avatar">
                                            @initials
                                        </div>

                                        <div>

                                            <span class="customer-name">
                                                @customerName
                                            </span>

                                            <span class="customer-number">
                                                @(string.IsNullOrWhiteSpace(p.StudentNumber)
                                                                                        ? "Customer account"
                                                                                        : p.StudentNumber)
                                    </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- ACCOMMODATION -->

                                <td>

                                    <div>

                                        <strong style="font-size:11px;color:#334155;">
                                            @(p.AccommodationName ?? "—")
                                        </strong>

                                    </div>

                                </td>


                                <!-- PAYMENT TYPE -->

                                <td>

                                    <span class="payment-type">

                                        <i class="fa-solid fa-file-invoice-dollar"></i>

                                        @p.PaymentType

                                    </span>

                                </td>


                                <!-- AMOUNT -->

                                <td>

                                    <span class="payment-amount">

                                        R @p.Amount.ToString("N2")

                                    </span>

                                </td>


                                <!-- METHOD -->

                                <td>
                                    @p.PaymentMethod
                                </td>


                                <!-- REFERENCE -->

                                <td>

                                    <span class="payment-reference">
                                        @p.ReferenceNumber
                                    </span>

                                </td>


                                <!-- SUBMITTED -->

                                <td>

                                    <span style="font-size:10px;color:#526173;">

                                        @p.PaymentDate.ToLocalTime().ToString("dd/MM/yyyy")

                                    </span>

                                    <small style="display:block;color:#9aa6b2;font-size:9px;">

                                        @p.PaymentDate.ToLocalTime().ToString("HH:mm")

                                    </small>

                                </td>


                                <!-- DUE DATE -->

                                <td>

                            @if (p.DueDate.HasValue)
                                    {
                                        <span style="font-size:10px;">

                                            @p.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="payment-status @statusClass">

                                        @if (p.Status == "Paid")
                                        {
                                            <i class="fa-solid fa-circle-check"></i>
                                        }
                                        else if (p.Status == "Rejected")
                                        {
                                            <i class="fa-solid fa-circle-xmark"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-clock"></i>
                                        }

                                        @p.Status

                                    </span>

                                </td>


                                <!-- ACTION -->

                                <td>

                                    @if (p.Status == "Pending")
                                    {
                                        <div class="payment-actions">

                                            <!-- APPROVE -->

                                            <form asp-action="Approve"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@p.PaymentID" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success payment-action"
                                                        title="Approve Payment">

                                                    <i class="fa-solid fa-check"></i>

                                                </button>

                                            </form>


                                            <!-- REJECT -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger payment-action reject-button"
                                                    data-payment-id="@p.PaymentID"
                                                    data-payment-reference="@p.ReferenceNumber"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectPaymentModal"
                                                    title="Reject Payment">

                                                <i class="fa-solid fa-xmark"></i>

                                            </button>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="payment-empty">

                <div class="payment-empty-icon">

                    <i class="fa-solid fa-receipt"></i>

                </div>

                <h4>
                    No Payments Found
                </h4>

                <p>
                    There are currently no payments matching the selected filter.
                </p>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     REJECT PAYMENT MODAL
     ========================================================== -->

<div class="modal fade reject-modal"
     id="rejectPaymentModal"
     tabindex="-1"
     aria-labelledby="rejectPaymentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content shadow">

            <form asp-action="Reject"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="PaymentID"
                       id="rejectPaymentId" />


                <div class="modal-header">

                    <div>

                        <h5 class="modal-title fw-bold"
                            id="rejectPaymentModalLabel">

                            Reject Payment

                        </h5>

                        <small class="text-muted"
                               id="rejectPaymentReference">
                        </small>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label for="rejectReason"
                               class="form-label fw-semibold">

                            Reason

                        </label>

                        <select name="Reason"
                                id="rejectReason"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select a reason --
                            </option>

                            <option>
                                Incorrect payment reference
                            </option>

                            <option>
                                Incorrect amount
                            </option>

                            <option>
                                Duplicate payment
                            </option>

                            <option>
                                Invalid proof of payment
                            </option>

                            <option>
                                Payment could not be verified
                            </option>

                            <option>
                                Payment made for incorrect charge
                            </option>

                            <option>
                                Payment does not match customer account
                            </option>

                            <option>
                                Other
                            </option>

                        </select>

                    </div>


                    <div>

                        <label for="rejectExplanation"
                               class="form-label fw-semibold">

                            Additional Explanation
                            <span class="text-muted fw-normal">
                                (optional)
                            </span>

                        </label>

                        <textarea name="Explanation"
                                  id="rejectExplanation"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Add any useful details for the customer..."></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa-solid fa-xmark me-2"></i>

                        Reject Payment

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================================
               REJECTION MODAL
               ===================================================== */

            document
                .querySelectorAll(".reject-button")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        document.getElementById("rejectPaymentId").value =
                            this.dataset.paymentId;

                        document.getElementById("rejectPaymentReference").textContent =
                            "Reference: " + this.dataset.paymentReference;

                        document.getElementById("rejectReason").value = "";

                        document.getElementById("rejectExplanation").value = "";

                    });

                });


            /* =====================================================
               PAYMENT TYPE FILTER
               ===================================================== */

            const typeFilter =
                document.getElementById("paymentTypeFilter");

            const rows =
                document.querySelectorAll(
                    ".payment-table tbody tr"
                );


            if (typeFilter) {

                typeFilter.addEventListener("change", function () {

                    const selected =
                        this.value.toLowerCase();

                    rows.forEach(function (row) {

                        const rowType =
                            row.dataset.paymentType || "";

                        if (
                            selected === "all" ||
                            rowType === selected
                        ) {
                            row.style.display = "";
                        }
                        else {
                            row.style.display = "none";
                        }

                    });

                });

            }

        });

    </script>

}