@model UFSStayConnect.ViewModels.AccommodationChargeViewModel

@{
    ViewData["Title"] = "Add Accommodation Charge";
    var accommodation = ViewBag.Accommodation as UFSStayConnect.Models.Accommodation;
}

<div class="charge-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <div class="page-eyebrow">
                <i class="fas fa-file-invoice-dollar"></i>
                ACCOMMODATION MANAGEMENT
            </div>

            <h1>Add Accommodation Charge</h1>

            <p>
                Create a payment charge for
                <strong>@(accommodation?.Name ?? "this accommodation")</strong>.
            </p>
        </div>

        <a asp-action="Manage"
           asp-route-accommodationId="@Model.AccommodationID"
           class="btn-back">
            <i class="fas fa-arrow-left"></i>
            Back to Charges
        </a>
    </div>


    <!-- Accommodation Information -->
    <div class="residence-banner">
        <div class="residence-icon">
            <i class="fas fa-building"></i>
        </div>

        <div>
            <span>Residence</span>
            <h3>@(accommodation?.Name ?? "Accommodation")</h3>

            @if (accommodation != null)
            {
                <small>
                    <i class="fas fa-location-dot"></i>
                    @accommodation.Location
                </small>
            }
        </div>
    </div>


    <!-- Form -->
    <div class="form-card">

        <div class="form-card-header">
            <div>
                <h2>Charge Details</h2>
                <p>Define the payment requirement for this residence.</p>
            </div>

            <div class="header-icon">
                <i class="fas fa-money-check-dollar"></i>
            </div>
        </div>


        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="AccommodationID" />


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <div class="form-grid">

                <!-- Payment Type -->
                <div class="form-group">
                    <label asp-for="PaymentTypeID">
                        Payment Type
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-tag"></i>

                        <select asp-for="PaymentTypeID"
                                asp-items="Model.PaymentTypes"
                                class="form-control">
                            <option value="">Select payment type</option>
                        </select>
                    </div>

                    <span asp-validation-for="PaymentTypeID"
                          class="field-error">
                    </span>
                </div>


                <!-- Amount -->
                <div class="form-group">
                    <label asp-for="Amount">
                        Amount
                        <span>*</span>
                    </label>

                    <div class="input-wrapper amount-input">
                        <span class="currency">R</span>

                        <input asp-for="Amount"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0.00" />
                    </div>

                    <span asp-validation-for="Amount"
                          class="field-error">
                    </span>
                </div>


                <!-- Frequency -->
                <div class="form-group">
                    <label asp-for="Frequency">
                        Payment Frequency
                        <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-calendar-days"></i>

                        <select asp-for="Frequency"
                                class="form-control">
                            <option value="">Select frequency</option>
                            <option value="Monthly">Monthly</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Termly">Termly</option>
                            <option value="Once-Off">Once-Off</option>
                            <option value="Annual">Annual</option>
                        </select>
                    </div>

                    <span asp-validation-for="Frequency"
                          class="field-error">
                    </span>
                </div>


                <!-- Status -->
                <div class="form-group status-group">

                    <label>
                        Charge Status
                    </label>

                    <div class="status-switch">

                        <label class="switch">
                            <input asp-for="IsActive" />
                            <span class="slider"></span>
                        </label>

                        <div>
                            <strong>Active charge</strong>
                            <p>
                                Make this charge available for customer payments.
                            </p>
                        </div>

                    </div>

                </div>


                <!-- Description -->
                <div class="form-group full-width">

                    <label asp-for="Description">
                        Description
                    </label>

                    <div class="textarea-wrapper">
                        <i class="fas fa-align-left"></i>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  maxlength="500"
                                  placeholder="Enter a description for this charge..."></textarea>
                    </div>

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>

                    <small class="field-help">
                        Explain what this charge covers so customers can understand
                        the payment requirement.
                    </small>

                </div>

            </div>


            <!-- Form Actions -->
            <div class="form-actions">

                <a asp-action="Manage"
                   asp-route-accommodationId="@Model.AccommodationID"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">
                    <i class="fas fa-plus"></i>
                    Create Charge
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .charge-page {
        background: #f6f8fb;
        min-height: calc(100vh - 80px);
        padding: 32px;
        color: #172033;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-eyebrow {
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        margin-bottom: 8px;
    }

        .page-eyebrow i {
            margin-right: 6px;
        }

    .page-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #172033;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

        .page-header p strong {
            color: #172033;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border: 1px solid #d9dee8;
        background: #fff;
        color: #374151;
        border-radius: 9px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: .2s;
    }

        .btn-back:hover {
            border-color: #2563eb;
            color: #2563eb;
            background: #f8fbff;
        }

    .residence-banner {
        display: flex;
        align-items: center;
        gap: 16px;
        background: linear-gradient(135deg, #123b73, #1e4f91);
        color: #fff;
        padding: 20px 24px;
        border-radius: 14px;
        margin-bottom: 22px;
        box-shadow: 0 8px 24px rgba(18, 59, 115, .15);
    }

    .residence-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 12px;
        font-size: 21px;
    }

    .residence-banner span {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: .7;
        font-weight: 700;
    }

    .residence-banner h3 {
        margin: 3px 0;
        font-size: 19px;
        font-weight: 800;
    }

    .residence-banner small {
        opacity: .8;
    }

        .residence-banner small i {
            margin-right: 5px;
        }

    .form-card {
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
        overflow: hidden;
    }

    .form-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f4;
    }

        .form-card-header h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
        }

        .form-card-header p {
            margin: 4px 0 0;
            color: #7b8494;
            font-size: 13px;
        }

    .header-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    form {
        padding: 26px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 750;
        color: #374151;
    }

        .form-group label span {
            color: #dc2626;
        }

    .input-wrapper,
    .textarea-wrapper {
        position: relative;
    }

        .input-wrapper > i,
        .textarea-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            pointer-events: none;
            z-index: 2;
        }

        .textarea-wrapper > i {
            top: 20px;
            transform: none;
        }

    .form-control {
        width: 100%;
        min-height: 46px;
        border: 1px solid #dce1e8;
        border-radius: 9px;
        padding: 10px 13px 10px 40px;
        font-size: 14px;
        color: #172033;
        background: #fff;
        transition: .2s;
        box-sizing: border-box;
    }

    textarea.form-control {
        padding-top: 12px;
        resize: vertical;
    }

    select.form-control {
        cursor: pointer;
        appearance: auto;
    }

    .form-control:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
    }

    .amount-input .currency {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-weight: 800;
        color: #2563eb;
        z-index: 2;
    }

    .amount-input .form-control {
        padding-left: 34px;
    }

    .status-group {
        display: flex;
        flex-direction: column;
    }

    .status-switch {
        min-height: 46px;
        border: 1px solid #dce1e8;
        border-radius: 9px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fafbfc;
    }

        .status-switch strong {
            display: block;
            font-size: 13px;
            color: #374151;
        }

        .status-switch p {
            margin: 2px 0 0;
            font-size: 11px;
            color: #7b8494;
        }

    .switch {
        position: relative;
        width: 42px;
        height: 23px;
        flex-shrink: 0;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        inset: 0;
        cursor: pointer;
        background: #cbd5e1;
        border-radius: 30px;
        transition: .2s;
    }

        .slider:before {
            content: "";
            position: absolute;
            width: 17px;
            height: 17px;
            left: 3px;
            top: 3px;
            background: #fff;
            border-radius: 50%;
            transition: .2s;
            box-shadow: 0 1px 3px rgba(0,0,0,.2);
        }

    .switch input:checked + .slider {
        background: #2563eb;
    }

        .switch input:checked + .slider:before {
            transform: translateX(19px);
        }

    .field-help {
        display: block;
        margin-top: 6px;
        color: #8a93a3;
        font-size: 11px;
    }

    .field-error,
    .validation-summary {
        color: #dc2626;
        font-size: 12px;
    }

    .validation-summary {
        background: #fef2f2;
        border: 1px solid #fecaca;
        padding: 12px 14px;
        border-radius: 8px;
        margin-bottom: 22px;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

    .btn-cancel,
    .btn-save {
        min-height: 43px;
        padding: 10px 18px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        cursor: pointer;
    }

    .btn-cancel {
        color: #4b5563;
        background: #f3f4f6;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

    .btn-save {
        background: #2563eb;
        color: #fff;
        box-shadow: 0 4px 10px rgba(37,99,235,.2);
    }

        .btn-save:hover {
            background: #1d4ed8;
        }

    @@media (max-width: 768px) {

        .charge-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .form-card-header,
        form {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
        }
    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}