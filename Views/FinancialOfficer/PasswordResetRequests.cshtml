@model UFSStayConnect.ViewModels.ResetCustomerPasswordViewModel

@{
    ViewData["Title"] = "Reset Customer Password";
}

<style>
    .password-reset-page {
        min-height: calc(100vh - 80px);
        padding: 35px 20px;
    }

    .password-card {
        max-width: 720px;
        margin: 0 auto;
        border: none;
        border-radius: 22px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    }

    .password-card-header {
        background: linear-gradient(135deg, #fff8e1 0%, #fff3cd 100%);
        padding: 35px 30px 30px;
        text-align: center;
        border-bottom: 1px solid #f1e5bd;
    }

    .password-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffc107;
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(255, 193, 7, 0.28);
    }

    .password-icon i {
        font-size: 30px;
    }

    .password-card-header h2 {
        margin-bottom: 8px;
        font-weight: 700;
        color: #212529;
        letter-spacing: -0.4px;
    }

    .password-card-header p {
        margin: 0;
        color: #6c757d;
        font-size: 0.95rem;
    }

    .customer-name {
        color: #212529;
        font-weight: 700;
    }

    .password-card-body {
        padding: 35px;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 8px;
    }

    .password-input-wrapper {
        position: relative;
    }

    .password-input-wrapper .form-control {
        padding-right: 48px;
    }

    .form-control {
        min-height: 48px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.15);
    }

    .password-toggle {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #6c757d;
        cursor: pointer;
        padding: 5px;
        z-index: 2;
    }

    .password-toggle:hover {
        color: #212529;
    }

    .password-requirements {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 15px 18px;
        margin-top: 12px;
        margin-bottom: 25px;
    }

    .password-requirements-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #495057;
        margin-bottom: 8px;
    }

    .password-requirements ul {
        margin: 0;
        padding-left: 20px;
        color: #6c757d;
        font-size: 0.85rem;
    }

    .password-requirements li {
        margin-bottom: 3px;
    }

    .validation-summary {
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .btn-cancel {
        min-height: 46px;
        border-radius: 10px;
        padding: 0 20px;
        font-weight: 600;
    }

    .btn-reset {
        min-height: 46px;
        border-radius: 10px;
        padding: 0 22px;
        font-weight: 600;
        border: none;
        transition: all 0.2s ease;
    }

    .btn-reset:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 15px rgba(255, 193, 7, 0.25);
    }

    .security-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: #fff8e1;
        border: 1px solid #ffe69c;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 25px;
        color: #664d03;
        font-size: 0.85rem;
    }

    .security-note i {
        margin-top: 2px;
        color: #d39e00;
    }

    @@media (max-width: 576px) {
        .password-reset-page {
            padding: 20px 12px;
        }

        .password-card-header {
            padding: 28px 20px 25px;
        }

        .password-card-body {
            padding: 25px 20px;
        }

        .password-card-header h2 {
            font-size: 1.5rem;
        }

        .action-buttons {
            flex-direction: column-reverse;
        }

        .action-buttons .btn {
            width: 100%;
        }
    }
</style>

<div class="password-reset-page">

    <div class="password-card">

        <!-- Header -->
        <div class="password-card-header">

            <div class="password-icon">
                <i class="fa-solid fa-key"></i>
            </div>

            <h2>Reset Customer Password</h2>

            <p>
                Set a new temporary password for
                <span class="customer-name">@Model.CustomerName</span>
            </p>

        </div>

        <!-- Body -->
        <div class="password-card-body">

            <!-- Validation -->
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger validation-summary"
                 role="alert"></div>

            <form asp-action="ResetCustomerPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="CustomerId" type="hidden" />

                <!-- New Password -->
                <div class="mb-3">

                    <label asp-for="NewPassword" class="form-label">
                        <i class="fa-solid fa-lock me-1 text-warning"></i>
                        New Password
                    </label>

                    <div class="password-input-wrapper">

                        <input asp-for="NewPassword"
                               id="newPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Enter new password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('newPassword', this)"
                                aria-label="Show password">

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger small"></span>

                </div>

                <!-- Requirements -->
                <div class="password-requirements">

                    <div class="password-requirements-title">
                        <i class="fa-solid fa-shield-halved me-1"></i>
                        Password requirements
                    </div>

                    <ul>
                        <li>At least 12 characters</li>
                        <li>At least one uppercase letter</li>
                        <li>At least one lowercase letter</li>
                        <li>At least one number</li>
                    </ul>

                </div>

                <!-- Confirm Password -->
                <div class="mb-3">

                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="fa-solid fa-lock me-1 text-warning"></i>
                        Confirm Password
                    </label>

                    <div class="password-input-wrapper">

                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Confirm new password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword('confirmPassword', this)"
                                aria-label="Show password">

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger small"></span>

                </div>

                <!-- Security note -->
                <div class="security-note">

                    <i class="fa-solid fa-circle-info"></i>

                    <div>
                        <strong>Password reset</strong><br />
                        The customer will need to use this new password when
                        signing in to their account.
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 action-buttons">

                    <a asp-action="CustomerDetails"
                       asp-route-id="@Model.CustomerId"
                       class="btn btn-light border btn-cancel">

                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-warning btn-reset">

                        <i class="fa-solid fa-key me-2"></i>
                        Reset Password

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function togglePassword(inputId, button) {

            const input = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");

                button.setAttribute("aria-label", "Hide password");

            } else {

                input.type = "password";

                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");

                button.setAttribute("aria-label", "Show password");
            }
        }

    </script>
}