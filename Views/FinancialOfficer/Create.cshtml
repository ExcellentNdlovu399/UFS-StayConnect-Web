@model UFSStayConnect.ViewModels.CreateOfficerViewModel

@{
    ViewData["Title"] = "Add Financial Officer";
}

<div class="officer-create-page">

    <!-- Page Header -->
    <div class="page-header">

        <div>

            <div class="page-eyebrow">
                <i class="fas fa-user-shield"></i>
                FINANCIAL OFFICER MANAGEMENT
            </div>

            <h1>Add Financial Officer</h1>

            <p>
                Create an authorized financial officer account for
                UFS StayConnect.
            </p>

        </div>

        <a asp-action="Index"
           class="btn-secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Officers
        </a>

    </div>


    <!-- Security Banner -->
    <div class="security-banner">

        <div class="security-icon">
            <i class="fas fa-shield-halved"></i>
        </div>

        <div>

            <strong>Authorized account</strong>

            <p>
                Financial officers have access to payment and financial
                management functions. Only create accounts for authorized staff.
            </p>

        </div>

    </div>


    <!-- Form Card -->
    <div class="form-card">

        <div class="form-card-header">

            <div class="header-icon">
                <i class="fas fa-user-plus"></i>
            </div>

            <div>

                <h2>Officer Account Details</h2>

                <p>
                    Enter the staff member's information and account credentials.
                </p>

            </div>

        </div>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>


            <!-- Personal Information -->
            <div class="form-section">

                <div class="section-heading">

                    <div class="section-icon">
                        <i class="fas fa-user"></i>
                    </div>

                    <div>

                        <h3>Personal Information</h3>

                        <p>
                            Basic information about the financial officer.
                        </p>

                    </div>

                </div>


                <div class="form-grid">

                    <!-- First Name -->
                    <div class="form-group">

                        <label asp-for="FirstName">
                            First Name
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-user"></i>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   autocomplete="given-name"
                                   placeholder="Enter first name" />

                        </div>

                        <span asp-validation-for="FirstName"
                              class="field-error">
                        </span>

                    </div>


                    <!-- Surname -->
                    <div class="form-group">

                        <label asp-for="Surname">
                            Surname
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-user"></i>

                            <input asp-for="Surname"
                                   class="form-control"
                                   autocomplete="family-name"
                                   placeholder="Enter surname" />

                        </div>

                        <span asp-validation-for="Surname"
                              class="field-error">
                        </span>

                    </div>


                    <!-- Employee Number -->
                    <div class="form-group">

                        <label asp-for="EmployeeNumber">
                            Employee Number
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-id-badge"></i>

                            <input asp-for="EmployeeNumber"
                                   class="form-control"
                                   placeholder="Enter employee number" />

                        </div>

                        <span asp-validation-for="EmployeeNumber"
                              class="field-error">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Account Information -->
            <div class="form-section">

                <div class="section-heading">

                    <div class="section-icon blue">
                        <i class="fas fa-at"></i>
                    </div>

                    <div>

                        <h3>Account Information</h3>

                        <p>
                            Configure the officer's UFS login credentials.
                        </p>

                    </div>

                </div>


                <div class="form-grid">

                    <!-- Email -->
                    <div class="form-group full-width">

                        <label asp-for="Email">
                            UFS Email Address
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-envelope"></i>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="employee@ufs.ac.za" />

                        </div>

                        <div class="field-help">

                            <i class="fas fa-circle-info"></i>

                            Use a UFS email address ending in
                            <strong>@@ufs.ac.za</strong>
                            or
                            <strong>@@ufs4life.ac.za</strong>.

                        </div>

                        <span asp-validation-for="Email"
                              class="field-error">
                        </span>

                    </div>


                    <!-- Password -->
                    <div class="form-group">

                        <label asp-for="Password">
                            Password
                            <span>*</span>
                        </label>

                        <div class="input-wrapper password-wrapper">

                            <i class="fas fa-lock"></i>

                            <input asp-for="Password"
                                   class="form-control password-input"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Enter password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('Password', this)"
                                    aria-label="Show password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <div class="field-help">

                            <i class="fas fa-shield-halved"></i>

                            At least 12 characters with uppercase,
                            lowercase and a digit.

                        </div>

                        <span asp-validation-for="Password"
                              class="field-error">
                        </span>

                    </div>


                    <!-- Confirm Password -->
                    <div class="form-group">

                        <label asp-for="ConfirmPassword">
                            Confirm Password
                            <span>*</span>
                        </label>

                        <div class="input-wrapper password-wrapper">

                            <i class="fas fa-lock"></i>

                            <input asp-for="ConfirmPassword"
                                   class="form-control password-input"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Confirm password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('ConfirmPassword', this)"
                                    aria-label="Show password">

                                <i class="fas fa-eye"></i>

                            </button>

                        </div>

                        <div class="field-help">
                            Re-enter the password to confirm it.
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-error">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Account Role Information -->
            <div class="role-information">

                <div class="role-icon">
                    <i class="fas fa-user-tie"></i>
                </div>

                <div>

                    <strong>Financial Officer Role</strong>

                    <p>
                        This account will be created as a Financial Officer
                        and will receive the permissions associated with
                        the Financial Officer role.
                    </p>

                </div>

            </div>


            <!-- Actions -->
            <div class="form-actions">

                <a asp-action="Index"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">

                    <i class="fas fa-user-plus"></i>

                    Create Officer

                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .officer-create-page {
        min-height: calc(100vh - 80px);
        padding: 32px;
        background: #f6f8fb;
        color: #172033;
    }


    /* PAGE HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 22px;
    }

    .page-eyebrow {
        margin-bottom: 8px;
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

        .page-eyebrow i {
            margin-right: 6px;
        }

    .page-header h1 {
        margin: 0;
        color: #172033;
        font-size: 30px;
        font-weight: 800;
    }

    .page-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }


    /* BUTTONS */

    .btn-secondary,
    .btn-cancel,
    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s;
    }

    .btn-secondary {
        min-height: 42px;
        padding: 10px 16px;
        background: #fff;
        border: 1px solid #d9dee8;
        color: #374151;
    }

        .btn-secondary:hover {
            color: #2563eb;
            border-color: #2563eb;
            background: #f8fbff;
        }


    /* SECURITY BANNER */

    .security-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
        padding: 16px 19px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 11px;
    }

    .security-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #dbeafe;
        color: #2563eb;
        font-size: 17px;
    }

    .security-banner strong {
        display: block;
        color: #1e3a8a;
        font-size: 13px;
        font-weight: 800;
    }

    .security-banner p {
        margin: 3px 0 0;
        color: #536175;
        font-size: 12px;
        line-height: 1.5;
    }


    /* FORM CARD */

    .form-card {
        max-width: 1000px;
        margin: 0 auto;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(15,23,42,.05);
    }

    .form-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 23px 26px;
        border-bottom: 1px solid #edf0f4;
    }

    .header-icon {
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 18px;
    }

    .form-card-header h2 {
        margin: 0;
        color: #172033;
        font-size: 18px;
        font-weight: 800;
    }

    .form-card-header p {
        margin: 4px 0 0;
        color: #7b8494;
        font-size: 12px;
    }

    form {
        padding: 26px;
    }


    /* VALIDATION */

    .validation-summary {
        margin-bottom: 24px;
        padding: 13px 15px;
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 9px;
        font-size: 12px;
    }

        .validation-summary:empty {
            display: none;
        }


    /* SECTIONS */

    .form-section {
        padding: 0 0 27px;
        margin-bottom: 27px;
        border-bottom: 1px solid #edf0f4;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .section-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f3f4f6;
        color: #4b5563;
        font-size: 14px;
    }

        .section-icon.blue {
            background: #eff6ff;
            color: #2563eb;
        }

    .section-heading h3 {
        margin: 0;
        color: #172033;
        font-size: 15px;
        font-weight: 800;
    }

    .section-heading p {
        margin: 3px 0 0;
        color: #8a93a3;
        font-size: 11px;
    }


    /* GRID */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .full-width {
        grid-column: 1 / -1;
    }


    /* FORM FIELDS */

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: 13px;
        font-weight: 750;
    }

        .form-group label span {
            color: #dc2626;
        }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper > i {
            position: absolute;
            left: 14px;
            top: 50%;
            z-index: 2;
            transform: translateY(-50%);
            color: #9ca3af;
            pointer-events: none;
        }

    .form-control {
        width: 100%;
        min-height: 46px;
        box-sizing: border-box;
        padding: 10px 13px 10px 40px;
        border: 1px solid #dce1e8;
        border-radius: 9px;
        background: #fff;
        color: #172033;
        font-size: 14px;
        transition: .2s;
    }

        .form-control:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.10);
        }

    .field-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    .field-help {
        display: flex;
        align-items: flex-start;
        gap: 5px;
        margin-top: 7px;
        color: #8a93a3;
        font-size: 11px;
        line-height: 1.45;
    }

        .field-help i {
            margin-top: 1px;
            color: #9ca3af;
        }

        .field-help strong {
            color: #596273;
        }


    /* PASSWORD */

    .password-wrapper .form-control {
        padding-right: 43px;
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 9px;
        width: 31px;
        height: 31px;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 7px;
        background: transparent;
        color: #9ca3af;
        cursor: pointer;
    }

        .password-toggle:hover {
            background: #f3f4f6;
            color: #2563eb;
        }


    /* ROLE INFORMATION */

    .role-information {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 25px;
        padding: 15px 17px;
        border-radius: 10px;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    .role-icon {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #fef3c7;
        color: #b45309;
        font-size: 15px;
    }

    .role-information strong {
        display: block;
        color: #92400e;
        font-size: 13px;
        font-weight: 800;
    }

    .role-information p {
        margin: 3px 0 0;
        color: #785b22;
        font-size: 11px;
        line-height: 1.5;
    }


    /* ACTIONS */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

    .btn-cancel {
        min-height: 43px;
        padding: 10px 18px;
        background: #f3f4f6;
        color: #4b5563;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

    .btn-save {
        min-height: 43px;
        padding: 10px 20px;
        background: #2563eb;
        color: #fff;
        border: none;
        box-shadow: 0 4px 10px rgba(37,99,235,.2);
    }

        .btn-save:hover {
            background: #1d4ed8;
        }


    /* RESPONSIVE */

    @@media (max-width: 700px) {

        .officer-create-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
        }

        .security-banner {
            align-items: flex-start;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .form-card-header,
        form {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
        }
    }
</style>


<script>

    function togglePassword(fieldId, button) {

        const field = document.getElementById(fieldId);

        if (!field) {
            return;
        }

        const icon = button.querySelector("i");

        if (field.type === "password") {

            field.type = "text";

            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");

            button.setAttribute(
                "aria-label",
                "Hide password"
            );

        }
        else {

            field.type = "password";

            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");

            button.setAttribute(
                "aria-label",
                "Show password"
            );

        }

    }

</script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}