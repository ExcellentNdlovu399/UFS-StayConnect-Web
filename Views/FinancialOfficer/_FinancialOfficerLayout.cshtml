@using Microsoft.AspNetCore.Identity
@using UFSStayConnect.Models
@using UFSStayConnect.DataAccess

@inject UserManager<ApplicationUser> UserManager
@inject IRepositoryWrapper Repository

@{
    var currentUser = await UserManager.GetUserAsync(User);

    var officerName = currentUser != null
        ? $"{currentUser.FirstName} {currentUser.Surname}".Trim()
        : "Financial Officer";

    if (string.IsNullOrWhiteSpace(officerName))
    {
        officerName = "Financial Officer";
    }

    var initials = string.Join("",
        officerName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0])
    ).ToUpper();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "FO";
    }

    var unreadNotifications = currentUser == null
        ? 0
        : Repository.Notification
            .FindByUser(currentUser.Id)
            .Count(n => !n.IsRead);

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null)
    {
        if (!string.Equals(
                currentController,
                controller,
                StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (action == null)
        {
            return true;
        }

        return string.Equals(
            currentAction,
            action,
            StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - UFS StayConnect
    </title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         FONT AWESOME
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =====================================================
         OUTFIT FONT
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         CUSTOMER DESIGN SYSTEM
         =====================================================

         We intentionally use the same CSS as Customer so that
         all three roles share the same visual language.
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/customer.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />


    @RenderSection("Styles", required: false)

</head>


<body class="customer-body">


    <!-- =====================================================
         MAIN WRAPPER
         ===================================================== -->

    <div class="customer-wrapper">


        <!-- =====================================================
             FINANCIAL OFFICER SIDEBAR
             ===================================================== -->

        <aside class="customer-sidebar"
               id="officerSidebar">


            <!-- SIDEBAR BACKGROUND -->

            <div class="customer-sidebar-image"></div>

            <div class="customer-sidebar-overlay"></div>


            <!-- SIDEBAR CONTENT -->

            <div class="customer-sidebar-content">


                <!-- =================================================
                     BRAND
                     ================================================= -->

                <div class="customer-brand">

                    <div class="customer-brand-logo">

                        <img src="~/images/ufs-emblem.png"
                             alt="University of the Free State"
                             class="customer-ufs-emblem" />

                    </div>


                    <div class="customer-brand-text">

                        <div class="customer-brand-title">
                            UFS StayConnect
                        </div>

                        <div class="customer-brand-subtitle">
                            Financial Officer Portal
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     NAVIGATION
                     ================================================= -->

                <nav class="customer-navigation">


                    <!-- =================================================
                         MAIN
                         ================================================= -->

                    <div class="customer-nav-section">
                        MAIN
                    </div>


                    <!-- DASHBOARD -->

                    <a asp-controller="FinancialOfficer"
                       asp-action="Index"
                       class="customer-nav-link @(IsActive("FinancialOfficer", "Index") ? "active" : "")">

                        <i class="fa-solid fa-house"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <!-- CUSTOMERS -->

                    <a asp-controller="FinancialOfficer"
                       asp-action="Customers"
                       class="customer-nav-link @(
                       IsActive("FinancialOfficer", "Customers") ||
                       IsActive("FinancialOfficer", "CustomerDetails") ||
                       IsActive("FinancialOfficer", "CreateCustomer") ||
                       IsActive("FinancialOfficer", "EditCustomer") ||
                       IsActive("FinancialOfficer", "ResetCustomerPassword")
                       ? "active" : "")">

                        <i class="fa-solid fa-users"></i>

                        <span>
                            Customers
                        </span>

                    </a>


                    <!-- PAYMENTS -->

                    <a asp-controller="PaymentManagement"
                       asp-action="Index"
                       class="customer-nav-link @(IsActive("PaymentManagement") ? "active" : "")">

                        <i class="fa-solid fa-credit-card"></i>

                        <span>
                            Payments
                        </span>

                    </a>


                    <!-- APPLICATIONS -->

                    <a asp-controller="Application"
                       asp-action="Index"
                       class="customer-nav-link @(IsActive("Application") ? "active" : "")">

                        <i class="fa-solid fa-file-lines"></i>

                        <span>
                            Applications
                        </span>

                    </a>


                    <!-- =================================================
                         MANAGEMENT
                         ================================================= -->

                    <div class="customer-nav-section">
                        MANAGEMENT
                    </div>


                    <!-- REPORTS -->

                    <a asp-controller="Report"
                       asp-action="Index"
                       class="customer-nav-link @(IsActive("Report") ? "active" : "")">

                        <i class="fa-solid fa-chart-pie"></i>

                        <span>
                            Reports
                        </span>

                    </a>


                    <!-- REVIEWS -->

                    <a asp-controller="Review"
                       asp-action="Index"
                       class="customer-nav-link @(IsActive("Review") ? "active" : "")">

                        <i class="fa-solid fa-star"></i>

                        <span>
                            Reviews
                        </span>

                    </a>


                    <!-- ADVICE -->

                    <a asp-controller="FinancialOfficer"
                       asp-action="Advice"
                       class="customer-nav-link @(IsActive("FinancialOfficer", "Advice") ? "active" : "")">

                        <i class="fa-solid fa-lightbulb"></i>

                        <span>
                            Advice &amp; Inputs
                        </span>

                    </a>


                    <!-- NOTIFICATIONS -->

                    <a asp-controller="Notification"
                       asp-action="Index"
                       class="customer-nav-link @(IsActive("Notification") ? "active" : "")">

                        <i class="fa-solid fa-bell"></i>

                        <span>
                            Notifications
                        </span>


                        @if (unreadNotifications > 0)
                        {
                            <span class="customer-notification-count">

                                @(unreadNotifications > 99
                                                            ? "99+"
                                                            : unreadNotifications.ToString())

                            </span>
                        }

                    </a>


                    <!-- =================================================
                         ACCOUNT
                         ================================================= -->

                    <div class="customer-nav-section">
                        ACCOUNT
                    </div>


                    <!-- PROFILE -->

                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="customer-nav-link @(IsActive("Account", "Profile") ? "active" : "")">

                        <i class="fa-solid fa-user"></i>

                        <span>
                            My Profile
                        </span>

                    </a>


                    @if (User.IsInRole("FinancialOfficer"))
                    {
                        <div class="customer-nav-link" aria-disabled="true"
                             title="Financial Officer passwords are managed by an Administrator"
                             style="opacity:.72;cursor:not-allowed;">
                            <i class="fa-solid fa-lock"></i>
                            <span>Password managed by Administrator</span>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="ChangePassword"
                           class="customer-nav-link @(IsActive("Account", "ChangePassword") ? "active" : "")">
                            <i class="fa-solid fa-lock"></i>
                            <span>Change Password</span>
                        </a>
                    }


                </nav>


                <!-- =================================================
                     FINANCIAL OFFICER PROFILE
                     ================================================= -->

                <div class="customer-sidebar-profile">


                    <div class="customer-profile-avatar">

                        @initials

                    </div>


                    <div class="customer-profile-info">

                        <strong>
                            @officerName
                        </strong>

                        <span>
                            Financial Officer
                        </span>

                    </div>


                </div>


                <!-- =================================================
                     LOGOUT
                     ================================================= -->

                <div class="customer-logout">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          id="officerLogoutForm">

                        @Html.AntiForgeryToken()


                        <button type="button"
                                class="customer-logout-button"
                                onclick="openOfficerLogoutModal()">

                            <i class="fa-solid fa-right-from-bracket"></i>

                            <span>
                                Logout
                            </span>

                        </button>


                    </form>

                </div>


            </div>

        </aside>


        <!-- =====================================================
             MAIN AREA
             ===================================================== -->

        <main class="customer-main">


            <!-- =================================================
                 TOP BAR
                 ================================================= -->

            <header class="customer-topbar">


                <div class="customer-topbar-left">


                    <!-- MOBILE SIDEBAR TOGGLE -->

                    <button type="button"
                            class="customer-sidebar-toggle"
                            onclick="toggleOfficerSidebar()"
                            aria-label="Open navigation">

                        <i class="fa-solid fa-bars"></i>

                    </button>


                    <!-- PAGE LABEL -->

                    <div class="customer-page-label">

                        <span>
                            UFS StayConnect
                        </span>

                    </div>


                </div>


                <!-- =================================================
                     TOPBAR RIGHT
                     ================================================= -->

                <div class="customer-topbar-right">


                    <!-- NOTIFICATIONS -->

                    <a asp-controller="Notification"
                       asp-action="Index"
                       class="customer-notification-button"
                       aria-label="Notifications">

                        <i class="fa-regular fa-bell"></i>


                        @if (unreadNotifications > 0)
                        {
                            <span class="customer-topbar-badge">

                                @(unreadNotifications > 99
                                                            ? "99+"
                                                            : unreadNotifications.ToString())

                            </span>
                        }


                    </a>


                    <!-- USER PROFILE -->

                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="customer-user">


                        <div class="customer-user-avatar">

                            @initials

                        </div>


                        <div class="customer-user-details">

                            <strong>
                                @officerName
                            </strong>

                            <small>
                                Financial Officer
                            </small>

                        </div>


                    </a>


                </div>


            </header>


            <!-- =================================================
                 PAGE CONTENT
                 ================================================= -->

            <div class="customer-page-content">

                @RenderBody()

            </div>


        </main>


    </div>


    <!-- =========================================================
         LOGOUT CONFIRMATION MODAL
         ========================================================= -->

    <div class="customer-modal"
         id="officerLogoutModal">


        <!-- BACKDROP -->

        <div class="customer-modal-backdrop"
             onclick="closeOfficerLogoutModal()">
        </div>


        <!-- MODAL -->

        <div class="customer-modal-dialog">


            <!-- ICON -->

            <div class="customer-modal-icon">

                <i class="fa-solid fa-right-from-bracket"></i>

            </div>


            <!-- TITLE -->

            <h3>
                Sign out?
            </h3>


            <!-- MESSAGE -->

            <p>
                Are you sure you want to sign out of UFS StayConnect?
            </p>


            <!-- ACTIONS -->

            <div class="customer-modal-actions">


                <!-- CANCEL -->

                <button type="button"
                        class="customer-modal-cancel"
                        onclick="closeOfficerLogoutModal()">

                    Stay signed in

                </button>


                <!-- CONFIRM -->

                <button type="button"
                        class="customer-modal-confirm"
                        onclick="confirmOfficerLogout()">

                    Sign out

                </button>


            </div>


        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script>


            /* =====================================================
               SIDEBAR TOGGLE
               ===================================================== */

            function toggleOfficerSidebar() {

                const sidebar =
                    document.getElementById("officerSidebar");

                if (!sidebar) {
                    return;
                }

                sidebar.classList.toggle("show");

            }


            /* =====================================================
               CLOSE SIDEBAR WHEN CLICKING A NAVIGATION LINK
               ===================================================== */

            document.addEventListener("click", function (event) {

                const sidebar =
                    document.getElementById("officerSidebar");

                if (!sidebar) {
                    return;
                }


                if (window.innerWidth > 992) {
                    return;
                }


                const navigationLink =
                    event.target.closest(".customer-nav-link");

                if (navigationLink) {

                    sidebar.classList.remove("show");

                }

            });


            /* =====================================================
               CLOSE SIDEBAR WHEN ESCAPE IS PRESSED
               ===================================================== */

            document.addEventListener("keydown", function (event) {

                if (event.key !== "Escape") {
                    return;
                }


                const sidebar =
                    document.getElementById("officerSidebar");


                if (sidebar) {

                    sidebar.classList.remove("show");

                }


                closeOfficerLogoutModal();

            });


            /* =====================================================
               LOGOUT MODAL
               ===================================================== */

            function openOfficerLogoutModal() {

                const modal =
                    document.getElementById("officerLogoutModal");

                if (!modal) {
                    return;
                }

                modal.classList.add("show");

                document.body.classList.add("modal-open");

            }


            function closeOfficerLogoutModal() {

                const modal =
                    document.getElementById("officerLogoutModal");

                if (!modal) {
                    return;
                }

                modal.classList.remove("show");

                document.body.classList.remove("modal-open");

            }


            function confirmOfficerLogout() {

                const form =
                    document.getElementById("officerLogoutForm");

                if (form) {

                    form.submit();

                }

            }


    </script>


    <!-- =========================================================
         BOOTSTRAP JAVASCRIPT
         ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false)

</body>

</html>