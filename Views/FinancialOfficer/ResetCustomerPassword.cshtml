@model UFSStayConnect.ViewModels.ResetCustomerPasswordViewModel

@{
    ViewData["Title"] = "Reset Customer Password";

    if (User.IsInRole("FinancialOfficer"))
    {
        Layout = "~/Views/FinancialOfficer/_FinancialOfficerLayout.cshtml";
    }
    else if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Admin/_AdminLayout.cshtml";
    }
}

<div class="password-reset-page">

    <!-- PAGE HEADER -->
    <div class="password-reset-header">

        <div>
            <div class="password-reset-eyebrow">
                <i class="fa-solid fa-shield-halved"></i>
                Customer Account Security
            </div>

            <h1>Reset Customer Password</h1>

            <p>
                Create a temporary password for this customer account.
            </p>
        </div>

        <a asp-controller="@(User.IsInRole("FinancialOfficer") ? "FinancialOfficer" : "Admin")"
           asp-action="@(User.IsInRole("FinancialOfficer") ? "Customers" : "Users")"
           class="password-back-btn">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Customers

        </a>

    </div>


    <!-- CONTENT -->
    <div class="password-reset-grid">

        <!-- MAIN FORM -->
        <div class="password-reset-card">

            <div class="password-card-header">

                <div class="password-card-icon">
                    <i class="fa-solid fa-key"></i>
                </div>

                <div>
                    <h2>Temporary Password</h2>

                    <p>
                        Set a new temporary password for the selected customer.
                    </p>
                </div>

            </div>


            <div class="password-card-body">

                <!-- INFORMATION NOTICE -->
                <div class="password-info-alert">

                    <div class="password-info-icon">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>

                    <div>
                        <strong>Password change required</strong>

                        <p>
                            The customer will be required to change this
                            temporary password after successfully signing in.
                        </p>
                    </div>

                </div>


                <!-- VALIDATION -->
                <div asp-validation-summary="ModelOnly"
                     class="password-validation"
                     role="alert">
                </div>


                <form asp-action="ResetCustomerPassword"
                      asp-controller="@(User.IsInRole("FinancialOfficer") ? "FinancialOfficer" : "Admin")"
                      method="post"
                      id="resetCustomerPasswordForm">

                    @Html.AntiForgeryToken()

                    <input asp-for="CustomerId"
                           type="hidden" />


                    <!-- CUSTOMER -->
                    <div class="password-field">

                        <label asp-for="CustomerName">
                            Customer
                        </label>

                        <div class="password-input-wrapper">

                            <span class="password-input-icon">
                                <i class="fa-solid fa-user"></i>
                            </span>

                            <input asp-for="CustomerName"
                                   class="password-input"
                                   readonly />

                        </div>

                    </div>


                    <!-- NEW PASSWORD -->
                    <div class="password-field">

                        <label asp-for="NewPassword">
                            New Temporary Password
                            <span>*</span>
                        </label>

                        <div class="password-input-wrapper">

                            <span class="password-input-icon">
                                <i class="fa-solid fa-lock"></i>
                            </span>

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   class="password-input password-input-with-toggle"
                                   autocomplete="new-password"
                                   placeholder="Enter temporary password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="newPassword"
                                    aria-label="Show password">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="password-field-error">
                        </span>

                        <div class="password-hint">
                            <i class="fa-solid fa-circle-check"></i>
                            Use at least 12 characters.
                        </div>

                    </div>


                    <!-- CONFIRM PASSWORD -->
                    <div class="password-field">

                        <label asp-for="ConfirmPassword">
                            Confirm Temporary Password
                            <span>*</span>
                        </label>

                        <div class="password-input-wrapper">

                            <span class="password-input-icon">
                                <i class="fa-solid fa-lock"></i>
                            </span>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   class="password-input password-input-with-toggle"
                                   autocomplete="new-password"
                                   placeholder="Repeat temporary password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="confirmPassword"
                                    aria-label="Show password">

                                <i class="fa-solid fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="password-field-error">
                        </span>

                    </div>


                    <!-- ACTIONS -->
                    <div class="password-form-actions">

                        <a asp-controller="@(User.IsInRole("FinancialOfficer") ? "FinancialOfficer" : "Admin")"
                           asp-action="@(User.IsInRole("FinancialOfficer") ? "Customers" : "Users")"
                           class="password-cancel-btn">

                            <i class="fa-solid fa-xmark"></i>
                            Cancel

                        </a>


                        <button type="submit"
                                class="password-submit-btn">

                            <i class="fa-solid fa-key"></i>
                            Reset Password

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- SIDEBAR -->
        <aside class="password-security-sidebar">

            <!-- SECURITY CARD -->
            <div class="password-side-card">

                <div class="password-side-heading">

                    <div class="password-side-icon blue">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div>
                        <h3>Account Security</h3>
                        <span>Password reset information</span>
                    </div>

                </div>


                <ul class="password-security-list">

                    <li>
                        <span class="security-check">
                            <i class="fa-solid fa-check"></i>
                        </span>

                        <div>
                            <strong>Temporary access</strong>
                            <p>
                                The password is intended for the customer's
                                next login.
                            </p>
                        </div>
                    </li>


                    <li>
                        <span class="security-check">
                            <i class="fa-solid fa-check"></i>
                        </span>

                        <div>
                            <strong>Password change required</strong>
                            <p>
                                The customer must change the temporary
                                password after signing in.
                            </p>
                        </div>
                    </li>


                    <li>
                        <span class="security-check">
                            <i class="fa-solid fa-check"></i>
                        </span>

                        <div>
                            <strong>Do not share publicly</strong>
                            <p>
                                Give the temporary password to the customer
                                through a secure channel.
                            </p>
                        </div>
                    </li>

                </ul>

            </div>


            <!-- PASSWORD GUIDANCE -->
            <div class="password-side-card">

                <div class="password-side-heading">

                    <div class="password-side-icon gold">
                        <i class="fa-solid fa-key"></i>
                    </div>

                    <div>
                        <h3>Password Guidance</h3>
                        <span>Recommended practice</span>
                    </div>

                </div>


                <div class="password-guidance">

                    <div class="guidance-item">
                        <i class="fa-solid fa-check"></i>
                        <span>Use 12 or more characters.</span>
                    </div>

                    <div class="guidance-item">
                        <i class="fa-solid fa-check"></i>
                        <span>Use a mixture of letters and numbers.</span>
                    </div>

                    <div class="guidance-item">
                        <i class="fa-solid fa-check"></i>
                        <span>Avoid easily guessed information.</span>
                    </div>

                </div>

            </div>


            <!-- ROLE INFORMATION -->
            <div class="password-side-card password-role-card">

                <div class="password-side-heading">

                    <div class="password-side-icon green">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>

                    <div>
                        <h3>Customer Account</h3>
                        <span>Access information</span>
                    </div>

                </div>

                <p>
                    This operation changes the customer's login password.
                    It does not change the customer's role, accommodation,
                    applications or payment history.
                </p>

            </div>

        </aside>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".password-toggle")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const targetId = this.dataset.target;

                        const input =
                            document.getElementById(targetId);

                        const icon =
                            this.querySelector("i");

                        if (!input) {
                            return;
                        }

                        if (input.type === "password") {

                            input.type = "text";

                            icon.classList.remove("fa-eye");
                            icon.classList.add("fa-eye-slash");

                            this.setAttribute(
                                "aria-label",
                                "Hide password"
                            );

                        }
                        else {

                            input.type = "password";

                            icon.classList.remove("fa-eye-slash");
                            icon.classList.add("fa-eye");

                            this.setAttribute(
                                "aria-label",
                                "Show password"
                            );

                        }

                    });

                });

        });

    </script>


    <style>

        
    </style>
}