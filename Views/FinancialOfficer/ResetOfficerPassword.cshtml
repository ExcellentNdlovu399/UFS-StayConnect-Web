@model UFSStayConnect.ViewModels.ResetOfficerPasswordViewModel

@{
    ViewData["Title"] = "Reset Officer Password";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="container py-4" style="max-width:720px;">
    <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-bold mb-2" style="letter-spacing:.12em;color:#b98a22;">Account security</div>
            <h1 class="h3 mb-2" style="color:#092746;">Reset Financial Officer password</h1>
            <p class="text-muted mb-0">Set a new temporary password for <strong>@Model.OfficerName</strong>. The officer cannot change this password themselves; an Administrator manages resets.</p>
        </div>
        <i class="fas fa-user-shield fa-2x" style="color:#b98a22;"></i>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-warning">
                <i class="fas fa-lock me-2"></i> Share the temporary password through a secure channel. Do not send it in a public message.
            </div>
            <form asp-controller="FinancialOfficer" asp-action="ResetOfficerPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="OfficerId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label" asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <small class="form-text text-muted">Use at least 12 characters and satisfy the system password policy.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <a asp-controller="FinancialOfficer" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary" style="background:#092746;border-color:#092746;">
                        <i class="fas fa-key me-1"></i> Reset password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
