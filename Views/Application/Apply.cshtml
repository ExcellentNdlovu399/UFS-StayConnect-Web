@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let currentStep = 1;


        // =========================================================
        // SHOW STEP
        // =========================================================

        function showStep(step) {

            document
                .querySelectorAll(".application-step-panel")
                .forEach(panel => {

                    panel.classList.remove("active");

                });


            const selectedPanel =
                document.querySelector(
                    `.application-step-panel[data-step="${step}"]`
                );


            if (selectedPanel) {

                selectedPanel.classList.add("active");

            }


            // Update progress indicators

            document
                .querySelectorAll(".progress-step")
                .forEach(indicator => {

                    const number =
                        parseInt(
                            indicator.getAttribute(
                                "data-step-indicator"
                            )
                        );


                    indicator.classList.remove(
                        "active",
                        "completed"
                    );


                    if (number === step) {

                        indicator.classList.add("active");

                    }
                    else if (number < step) {

                        indicator.classList.add("completed");

                    }

                });


            // Update connectors

            document
                .querySelectorAll(".progress-connector")
                .forEach((connector, index) => {

                    if (index < step - 1) {

                        connector.classList.add("completed");

                    }
                    else {

                        connector.classList.remove("completed");

                    }

                });


            currentStep = step;


            updateReview();


            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });

        }


        // =========================================================
        // CHECK FILE
        // =========================================================

        function checkFile(inputName, nextStep) {

            const input =
                document.querySelector(
                    `[name="${inputName}"]`
                );


            if (!input ||
                !input.files ||
                input.files.length === 0) {

                alert(
                    "Please select the required PDF document before continuing."
                );

                return;

            }


            const file =
                input.files[0];


            const extension =
                file.name
                    .toLowerCase()
                    .substring(
                        file.name.lastIndexOf(".")
                    );


            if (extension !== ".pdf") {

                alert(
                    "Only PDF documents are allowed."
                );

                return;

            }


            if (file.size > 5 * 1024 * 1024) {

                alert(
                    "The selected PDF cannot be larger than 5 MB."
                );

                return;

            }


            showStep(nextStep);

        }


        // =========================================================
        // HANDLE FILE
        // =========================================================

        function handleFile(input, displayId) {

            const display =
                document.getElementById(displayId);


            if (!display) {
                return;
            }


            if (!input.files ||
                input.files.length === 0) {

                display.innerHTML = "";

                return;

            }


            const file =
                input.files[0];


            if (!file.name
                .toLowerCase()
                .endsWith(".pdf")) {

                display.innerHTML =
                    `<span style="color:#c03939;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Please select a PDF file.
                    </span>`;

                return;

            }


            if (file.size > 5 * 1024 * 1024) {

                display.innerHTML =
                    `<span style="color:#c03939;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        File exceeds the 5 MB limit.
                    </span>`;

                return;

            }


            display.innerHTML =
                `<i class="fa-solid fa-circle-check"></i>
                 ${escapeHtml(file.name)}
                 · ${formatFileSize(file.size)}`;


            updateReview();

        }


        // =========================================================
        // REVIEW
        // =========================================================

        function checkApplicantDocument() {

            const isStaff =
                '@Model.UserType'.toLowerCase() === 'staff';

            const inputName =
                isStaff ? 'EmploymentDocument' : 'RegistrationDocument';

            const input =
                document.querySelector(`[name="${inputName}"]`);

            if (!input ||
                !input.files ||
                input.files.length === 0) {

                alert(
                    isStaff
                        ? 'Please select your proof of employment before continuing.'
                        : 'Please select your proof of registration before continuing.'
                );

                return;
            }

            const file = input.files[0];

            if (!file.name.toLowerCase().endsWith('.pdf')) {

                alert('Only PDF documents are allowed.');

                return;
            }

            if (file.size > 5 * 1024 * 1024) {

                alert('The selected PDF cannot be larger than 5 MB.');

                return;
            }

            showStep(5);
        }

        
        // =========================================================
        // REVIEW
        // =========================================================

        function updateReview() {

            const idInput = document.querySelector('[name="IDDocument"]');
            const registrationInput = document.querySelector('[name="RegistrationDocument"]');
            const employmentInput = document.querySelector('[name="EmploymentDocument"]');

            const reviewId = document.getElementById('reviewId');
            const reviewRegistration = document.getElementById('reviewRegistration');
            const reviewEmployment = document.getElementById('reviewEmployment');

            if (idInput && idInput.files && idInput.files.length > 0 && reviewId) {
                reviewId.textContent = idInput.files[0].name;
            }

            if (registrationInput && registrationInput.files && registrationInput.files.length > 0 && reviewRegistration) {
                reviewRegistration.textContent = registrationInput.files[0].name;
            }

            if (employmentInput && employmentInput.files && employmentInput.files.length > 0 && reviewEmployment) {
                reviewEmployment.textContent = employmentInput.files[0].name;
            }
        }


        // =========================================================
        // FILE SIZE
        // =========================================================

        function formatFileSize(bytes) {

            if (bytes < 1024) {

                return bytes + " B";

            }


            if (bytes < 1024 * 1024) {

                return (
                    bytes / 1024
                ).toFixed(1) + " KB";

            }


            return (
                bytes / (1024 * 1024)
            ).toFixed(1) + " MB";

        }


        // =========================================================
        // ESCAPE HTML
        // =========================================================

        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value;

            return element.innerHTML;

        }


        // =========================================================
        // PREVENT DOUBLE SUBMISSION
        // =========================================================

        document
            .getElementById("stayApplicationForm")
            .addEventListener(
                "submit",
                function () {

                    const button =
                        this.querySelector(
                            ".submit-button"
                        );


                    if (button) {

                        button.disabled = true;

                        button.innerHTML =
                            `<i class="fa-solid fa-spinner fa-spin"></i>
                             Submitting...`;

                    }

                }
            );


        // =========================================================
        // INITIALISE
        // =========================================================

        showStep(1);


    </script>

}