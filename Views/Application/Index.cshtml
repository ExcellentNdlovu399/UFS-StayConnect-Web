@model IEnumerable<UFSStayConnect.Models.Application>

@{
    bool isAdmin = User.IsInRole("Admin");
    bool isManagement = isAdmin || User.IsInRole("FinancialOfficer");

    ViewData["Title"] = isManagement
        ? "Application Management"
        : "My Applications";

    var applications = Model?.ToList()
        ?? new List<UFSStayConnect.Models.Application>();

    var totalApplications = applications.Count;

    var pendingApplications = applications.Count(a =>
        string.Equals(a.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    var approvedApplications = applications.Count(a =>
        string.Equals(a.Status, "Approved", StringComparison.OrdinalIgnoreCase));

    var rejectedApplications = applications.Count(a =>
        string.Equals(a.Status, "Rejected", StringComparison.OrdinalIgnoreCase));

    var closedApplications = applications.Count(a =>
        string.Equals(a.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(a.Status, "Withdrawn", StringComparison.OrdinalIgnoreCase));
}

<style>

    /* =========================================================
               APPLICATION MANAGEMENT
               ========================================================= */

    .applications-page {
        padding: 4px 0 40px;
    }

    .applications-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 26px;
    }

    .applications-title h2 {
        margin: 0;
        color: #10233f;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

        .applications-title h2 i {
            color: #1769ff;
            margin-right: 8px;
        }

    .applications-title p {
        color: #718096;
        margin: 7px 0 0;
        font-size: 14px;
    }

    .management-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #eef4ff;
        color: #1769ff;
        border-radius: 9px;
        padding: 9px 13px;
        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
               ALERTS
               ========================================================= */

    .application-alert {
        border: 0;
        border-radius: 12px;
        padding: 14px 17px;
        margin-bottom: 20px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
    }


    /* =========================================================
               STAT CARDS
               ========================================================= */

    .application-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 26px;
    }

    .application-stat-card {
        background: #fff;
        border: 1px solid #edf1f7;
        border-radius: 16px;
        padding: 19px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
        transition: .2s ease;
    }

        .application-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(15, 23, 42, .075);
        }

    .application-stat-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

        .application-stat-icon.blue {
            background: #eaf2ff;
            color: #1769ff;
        }

        .application-stat-icon.orange {
            background: #fff5e6;
            color: #e58a16;
        }

        .application-stat-icon.green {
            background: #eaf9f1;
            color: #159447;
        }

        .application-stat-icon.red {
            background: #fff0f0;
            color: #d64545;
        }

    .application-stat-content span {
        display: block;
        color: #7c8999;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .application-stat-content strong {
        display: block;
        color: #10233f;
        font-size: 24px;
        line-height: 1.1;
        font-weight: 800;
    }

    .application-stat-content small {
        color: #9aa6b2;
        font-size: 10px;
    }


    /* =========================================================
               FILTER PANEL
               ========================================================= */

    .application-panel {
        background: #fff;
        border: 1px solid #edf1f7;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .045);
        overflow: hidden;
    }

    .application-panel-header {
        padding: 21px 23px;
        border-bottom: 1px solid #edf1f7;
    }

        .application-panel-header h3 {
            color: #10233f;
            margin: 0;
            font-size: 17px;
            font-weight: 800;
        }

        .application-panel-header p {
            color: #8793a3;
            margin: 4px 0 0;
            font-size: 12px;
        }

    .application-filter-area {
        padding: 18px 23px;
        border-bottom: 1px solid #edf1f7;
        background: #fbfcfe;
    }

    .application-filter-form {
        display: grid;
        grid-template-columns: minmax(250px, 1fr) 200px auto auto;
        gap: 10px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        color: #5d6b7b;
        font-size: 10px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .filter-input-wrapper {
        position: relative;
    }

        .filter-input-wrapper i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ba6b3;
            font-size: 12px;
        }

    .filter-input,
    .filter-select {
        width: 100%;
        height: 41px;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fff;
        color: #3d4d61;
        font-size: 12px;
        outline: none;
    }

    .filter-input {
        padding: 0 13px 0 36px;
    }

    .filter-select {
        padding: 0 12px;
    }

        .filter-input:focus,
        .filter-select:focus {
            border-color: #1769ff;
            box-shadow: 0 0 0 3px rgba(23, 105, 255, .07);
        }

    .filter-button {
        height: 41px;
        border-radius: 9px;
        padding: 0 18px;
        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
               APPLICATION LIST
               ========================================================= */

    .application-list {
        padding: 22px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .application-card {
        border: 1px solid #e4eaf1;
        border-radius: 14px;
        background: #fff;
        overflow: hidden;
        transition: .2s ease;
    }

        .application-card:hover {
            border-color: #d4deea;
            box-shadow: 0 9px 26px rgba(15, 23, 42, .06);
        }

    .application-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 14px 18px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf1f7;
    }

    .application-reference span {
        display: block;
        color: #9aa6b2;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 2px;
    }

    .application-reference strong {
        color: #27394f;
        font-size: 13px;
        font-weight: 800;
    }


    /* =========================================================
               STATUS
               ========================================================= */

    .application-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 750;
    }

        .application-status.pending {
            background: #fff5df;
            color: #a36a00;
        }

        .application-status.approved {
            background: #eaf9f1;
            color: #16804b;
        }

        .application-status.rejected {
            background: #fff0f0;
            color: #c83d3d;
        }

        .application-status.closed {
            background: #eef2f7;
            color: #64748b;
        }


    /* =========================================================
               MAIN APPLICATION INFORMATION
               ========================================================= */

    .application-information {
        display: grid;
        grid-template-columns: 1.4fr 1.4fr .9fr .9fr;
        gap: 0;
        padding: 20px 18px;
    }

    .application-info {
        display: flex;
        gap: 10px;
        min-width: 0;
        padding: 0 17px;
        border-right: 1px solid #edf1f7;
    }

        .application-info:first-child {
            padding-left: 0;
        }

        .application-info:last-child {
            border-right: 0;
        }

    .application-info-icon {
        width: 35px;
        height: 35px;
        min-width: 35px;
        border-radius: 8px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 12px;
    }

        .application-info-icon.person {
            background: #f1edff;
            color: #684fc4;
        }

        .application-info-icon.residence {
            background: #edf4ff;
            color: #1769ff;
        }

        .application-info-icon.room {
            background: #eaf9f1;
            color: #16804b;
        }

        .application-info-icon.date {
            background: #fff5e6;
            color: #c17a0b;
        }

    .application-info-content {
        min-width: 0;
    }

        .application-info-content span {
            display: block;
            color: #9aa6b2;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .7px;
            margin-bottom: 4px;
        }

        .application-info-content strong {
            display: block;
            color: #334155;
            font-size: 11px;
            line-height: 1.45;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .application-info-content small {
            display: block;
            color: #8b97a5;
            font-size: 9px;
            margin-top: 3px;
            overflow: hidden;
            text-overflow: ellipsis;
        }


    /* =========================================================
               DOCUMENTS
               ========================================================= */

    .application-documents {
        margin: 0 18px;
        padding: 15px 0;
        border-top: 1px solid #edf1f7;
        border-bottom: 1px solid #edf1f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .documents-title {
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
    }

        .documents-title i {
            color: #1769ff;
            margin-right: 5px;
        }

    .documents-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .document-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        padding: 6px 9px;
        border-radius: 7px;
        color: #64748b;
        font-size: 9px;
        font-weight: 650;
    }

        .document-item .present {
            color: #16804b;
        }

        .document-item .missing {
            color: #d14343;
        }


    /* =========================================================
               FOOTER / ACTIONS
               ========================================================= */

    .application-card-footer {
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

        .application-card-footer small {
            color: #9aa6b2;
            font-size: 9px;
        }

    .view-application-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 8px 13px;
        border: 1px solid #1769ff;
        border-radius: 8px;
        color: #1769ff;
        background: #fff;
        text-decoration: none;
        font-size: 10px;
        font-weight: 750;
        transition: .2s ease;
    }

        .view-application-button:hover {
            background: #1769ff;
            color: #fff;
        }


    /* =========================================================
               CUSTOMER INFORMATION
               ========================================================= */

    .customer-application-note {
        background: #eef6ff;
        border: 1px solid #d9e9ff;
        border-radius: 12px;
        padding: 14px 17px;
        color: #46617f;
        font-size: 11px;
        margin-bottom: 20px;
    }

        .customer-application-note i {
            color: #1769ff;
            margin-right: 7px;
        }

    .find-accommodation-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        border-radius: 9px;
        background: #1769ff;
        color: #fff;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
    }

        .find-accommodation-button:hover {
            color: #fff;
            background: #0e57c8;
        }


    /* =========================================================
               EMPTY STATE
               ========================================================= */

    .applications-empty {
        padding: 70px 25px;
        text-align: center;
    }

    .applications-empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 17px;
        border-radius: 18px;
        background: #eef4ff;
        color: #1769ff;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 25px;
    }

    .applications-empty h4 {
        color: #334155;
        margin: 0 0 7px;
        font-weight: 800;
    }

    .applications-empty p {
        color: #8793a3;
        font-size: 12px;
        margin-bottom: 18px;
    }


    /* =========================================================
               RESPONSIVE
               ========================================================= */

    @@media (max-width: 1100px) {

        .application-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .application-information {
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .application-info {
            padding: 0;
            border-right: 0;
        }
    }

    @@media (max-width: 850px) {

        .application-filter-form {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 600px) {

        .applications-header {
            flex-direction: column;
        }

        .application-stats {
            grid-template-columns: 1fr;
        }

        .application-filter-form {
            grid-template-columns: 1fr;
        }

        .application-information {
            grid-template-columns: 1fr;
        }

        .application-info {
            padding-bottom: 13px;
            border-bottom: 1px solid #edf1f7;
        }

            .application-info:last-child {
                border-bottom: 0;
                padding-bottom: 0;
            }

        .application-documents {
            align-items: flex-start;
            flex-direction: column;
        }

        .application-card-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .view-application-button {
            width: 100%;
        }
    }
</style>


<div class="applications-page">

    <!-- =====================================================
         PAGE HEADER
         ====================================================== -->

    <div class="applications-header">

        <div class="applications-title">

            <h2>
                <i class="fa-solid fa-file-signature"></i>

                @(isManagement
                                ? "Application Management"
                                : "My Applications")
            </h2>

            <p>
                @(isManagement
                                ? "Review, verify and manage accommodation applications."
                                : "View and track your accommodation applications.")
            </p>

        </div>


        @if (isManagement)
        {
            <div class="management-label">

                <i class="fa-solid fa-shield-halved"></i>

                @(isAdmin
                            ? "Administrator Review Area"
                            : "Financial Officer Review Area")

        </div>
                }
        else
        {
            <a asp-controller="Accommodation"
               asp-action="Index"
               class="find-accommodation-button">

                <i class="fa-solid fa-building"></i>
                Find Accommodation

            </a>
        }

    </div>


    <!-- =====================================================
         MESSAGES
         ====================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success application-alert alert-dismissible fade show">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger application-alert alert-dismissible fade show">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================================
         STATISTICS
         ====================================================== -->

    <div class="application-stats">

        <div class="application-stat-card">

            <div class="application-stat-icon blue">
                <i class="fa-solid fa-file-lines"></i>
            </div>

            <div class="application-stat-content">

                <span>
                    @(isManagement
                                        ? "Total Applications"
                                        : "My Applications")
                </span>

                <strong>@totalApplications</strong>

                <small>Application records</small>

            </div>

        </div>


        <div class="application-stat-card">

            <div class="application-stat-icon orange">
                <i class="fa-solid fa-clock"></i>
            </div>

            <div class="application-stat-content">

                <span>Pending</span>

                <strong>@pendingApplications</strong>

                <small>Awaiting review</small>

            </div>

        </div>


        <div class="application-stat-card">

            <div class="application-stat-icon green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="application-stat-content">

                <span>Approved</span>

                <strong>@approvedApplications</strong>

                <small>Successfully approved</small>

            </div>

        </div>


        <div class="application-stat-card">

            <div class="application-stat-icon red">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>

            <div class="application-stat-content">

                <span>Rejected</span>

                <strong>@rejectedApplications</strong>

                <small>
                    @if (closedApplications > 0)
                    {
                        <text>@closedApplications cancelled/withdrawn</text>
                    }
                    else
                    {
                        <text>Not approved</text>
                    }
                </small>

            </div>

        </div>

    </div>


    @if (!isManagement)
    {
        <div class="customer-application-note">

            <i class="fa-solid fa-circle-info"></i>

            You may keep applications at multiple residences while
            they are pending. Once one application is approved and
            a room is allocated, the system automatically closes
            your other pending applications.

        </div>
    }


    <!-- =====================================================
         APPLICATION DIRECTORY
         ====================================================== -->

    <div class="application-panel">

        <div class="application-panel-header">

            <h3>
                @(isManagement
                                ? "Application Directory"
                                : "Application History")
            </h3>

            <p>
                @(isManagement
                                ? "Review applicant information, documents and accommodation requests."
                                : "Track your submitted accommodation applications.")
            </p>

        </div>


        <!-- =================================================
             MANAGEMENT FILTER
             ================================================== -->
        @if (isManagement)
        {
            <div class="application-filter-area">

                <form method="get"
                      class="application-filter-form">

                    <div class="filter-field">

                        <label>
                            SEARCH APPLICATIONS
                        </label>

                        <div class="filter-input-wrapper">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input name="search"
                                   value="@ViewBag.Search"
                                   class="filter-input"
                                   placeholder="Applicant, email, residence or application number..." />

                        </div>

                    </div>


                    <div class="filter-field">

                        <label>
                            APPLICATION STATUS
                        </label>

                        <select name="status"
                                class="filter-select">

                            <option value="">
                                All statuses
                            </option>

                            <option value="Pending"
                                    selected="@(ViewBag.Status == "Pending")">
                                Pending
                            </option>

                            <option value="Approved"
                                    selected="@(ViewBag.Status == "Approved")">
                                Approved
                            </option>

                            <option value="Rejected"
                                    selected="@(ViewBag.Status == "Rejected")">
                                Rejected
                            </option>

                            <option value="Cancelled"
                                    selected="@(ViewBag.Status == "Cancelled")">
                                Cancelled
                            </option>

                            <option value="Withdrawn"
                                    selected="@(ViewBag.Status == "Withdrawn")">
                                Withdrawn
                            </option>

                        </select>

                    </div>


                    <button type="submit"
                            class="btn btn-primary filter-button">

                        <i class="fa-solid fa-filter me-1"></i>
                        Filter

                    </button>


                    <a asp-action="Index"
                       class="btn btn-light border filter-button d-flex align-items-center justify-content-center">

                        Clear

                    </a>

                </form>

            </div>
        }


        <!-- =================================================
             APPLICATION RECORDS
             ================================================== -->
        @if (applications.Any())
        {
            <div class="application-list">

                @foreach (var application in applications)
                {
                    var status =
                    string.IsNullOrWhiteSpace(application.Status)
                    ? "Unknown"
                    : application.Status;

                    var statusClass =
                    status.Equals("Approved", StringComparison.OrdinalIgnoreCase)
                    ? "approved"
                    : status.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                    ? "rejected"
                    : status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ||
                    status.Equals("Withdrawn", StringComparison.OrdinalIgnoreCase)
                    ? "closed"
                    : "pending";

                    var hasId =
                    application.IDDocument != null &&
                    application.IDDocument.Length > 0;

                    var hasRegistration =
                    application.RegistrationDocument != null &&
                    application.RegistrationDocument.Length > 0;

                    var isStaff =
                    string.Equals(
                    application.User?.UserType,
                    "Staff",
                    StringComparison.OrdinalIgnoreCase);

                    var hasApplicantDocument =
                    isStaff
                    ? application.EmploymentDocument != null &&
                    application.EmploymentDocument.Length > 0
                    : application.RegistrationDocument != null &&
                    application.RegistrationDocument.Length > 0;

                    <div class="application-card">


                        <!-- TOP -->

                        <div class="application-card-top">

                            <div class="application-reference">

                                <span>APPLICATION REFERENCE</span>

                                <strong>
                                    #APP-@application.ApplicationID.ToString("D5")
                                </strong>

                            </div>


                            <div class="application-status @statusClass">

                                @if (statusClass == "approved")
                                {
                                    <i class="fa-solid fa-circle-check"></i>
                                }
                                else if (statusClass == "rejected")
                                {
                                    <i class="fa-solid fa-circle-xmark"></i>
                                }
                                else if (statusClass == "closed")
                                {
                                    <i class="fa-solid fa-ban"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-clock"></i>
                                }

                                @status

                            </div>

                        </div>


                        <!-- INFORMATION -->

                        <div class="application-information">


                            @if (isManagement)
                            {
                                <div class="application-info">

                                    <div class="application-info-icon person">
                                        <i class="fa-solid fa-user"></i>
                                    </div>

                                    <div class="application-info-content">

                                        <span>APPLICANT</span>

                                        <strong>

                                            @(application.User != null
                                                                            ? $"{application.User.FirstName} {application.User.Surname}"
                                                                            : "Unknown Applicant")

                            </strong>

                            @if (application.User != null)
                                        {
                                            <small>
                                                @application.User.Email
                                            </small>
                                        }

                                    </div>

                                </div>
                            }


                        <div class="application-info">

                            <div class="application-info-icon residence">
                                <i class="fa-solid fa-building"></i>
                            </div>

                            <div class="application-info-content">

                                <span>RESIDENCE</span>

                                <strong>

                                    @(application.Accommodation?.Name
                                                                    ?? "Unknown Accommodation")

                            </strong>

                            @if (application.Accommodation != null)
                                    {
                                        <small>

                                            <i class="fa-solid fa-location-dot me-1"></i>

                                            @application.Accommodation.Location

                                        </small>
                                    }

                                </div>

                            </div>


                            <div class="application-info">

                                <div class="application-info-icon room">
                                    <i class="fa-solid fa-door-open"></i>
                                </div>

                                <div class="application-info-content">

                                    <span>ROOM</span>

                                    @if (application.Room != null)
                                    {
                                        <strong>
                                            @application.Room.RoomNumber
                                        </strong>

                                        <small>
                                            Allocated
                                        </small>
                                    }
                                    else
                                    {
                                        <strong>
                                            Not allocated
                                        </strong>

                                        <small>
                                            @(status == "Pending"
                                                                            ? "Awaiting decision"
                                                                            : "No room assigned")
                            </small>
                                                        }

                            </div>

                        </div>


                        <div class="application-info">

                            <div class="application-info-icon date">
                                <i class="fa-solid fa-calendar"></i>
                            </div>

                            <div class="application-info-content">

                                <span>SUBMITTED</span>

                                <strong>
                                    @application.ApplicationDate.ToLocalTime().ToString("dd MMM yyyy")
                                </strong>

                                <small>
                                    @application.ApplicationDate.ToLocalTime().ToString("HH:mm")
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- DOCUMENTS -->

                    <div class="application-documents">

                        <div class="documents-title">

                            <i class="fa-solid fa-folder-open"></i>

                            Supporting Documents

                        </div>


                        <div class="documents-list">

                            <div class="document-item">

                                <i class="fa-solid @(hasId ? "fa-circle-check present" : "fa-circle-xmark missing")"></i>

                                Certified ID

                            </div>


                            <div class="document-item">

                                <i class="fa-solid @(hasApplicantDocument ? "fa-circle-check present" : "fa-circle-xmark missing")"></i>

                                @(isStaff ? "Employment" : "Registration")

                            </div>

                        </div>

                    </div>


                    <!-- ACTION -->

                    <div class="application-card-footer">

                        <small>

                            <i class="fa-solid fa-house me-1"></i>

                            @(application.Accommodation?.Type
                                                    ?? "Accommodation")

                        </small>


                        <a asp-controller="Application"
                           asp-action="Details"
                           asp-route-id="@application.ApplicationID"
                           class="view-application-button">

                            <i class="fa-solid fa-eye"></i>

                            @(isManagement
                                                    ? "Review Application"
                                                    : "View Application")

                    </a>

                        </div>

                    </div>
                        }

            </div>
        }
        else
        {
            <!-- =================================================
                 EMPTY STATE
                 ================================================== -->

            <div class="applications-empty">

                <div class="applications-empty-icon">
                    <i class="fa-solid fa-folder-open"></i>
                </div>

                <h4>
                    No Applications Found
                </h4>

                <p>

                    @(isManagement
                                    ? "There are currently no accommodation applications matching your selection."
                                    : "You have not submitted an accommodation application yet.")

            </p>


            @if (!isManagement)
                {
                    <a asp-controller="Accommodation"
                       asp-action="Index"
                       class="find-accommodation-button">

                        <i class="fa-solid fa-building"></i>
                        Find Accommodation

                    </a>
                }

            </div>
        }

    </div>

</div>