@model UFSStayConnect.Models.Application

@{
    bool isAdmin = User.IsInRole("Admin");

    bool isManagement =
        isAdmin ||
        User.IsInRole("FinancialOfficer");

    ViewData["Title"] =
        isManagement
            ? "Review Application"
            : "Application Details";
}

<div class="application-details-page">

    <div class="application-details-container">

        @if (Model.Room != null)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="fa-solid fa-door-open text-success fs-4"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Allocated Room</small>
                            <strong>Room @Model.Room.RoomNumber</strong>
                            <div class="small text-muted">@Model.Accommodation?.Name</div>
                        </div>
                    </div>
                </div>
            </div>
        }


        <!-- HEADER -->

        <div class="details-header">

            <div>

                <div class="details-eyebrow">
                    @(isManagement
                                        ? "ADMINISTRATION"
                                        : "MY APPLICATION")
                </div>

                <h1>

                    <i class="fa-solid fa-file-circle-check"></i>

                    Application #@Model.ApplicationID

                </h1>

                <p>
                    @(isManagement
                                        ? "Review the applicant, accommodation and supporting documents."
                                        : "View the details and status of your accommodation application.")
                </p>

            </div>


            <div class="header-actions">

                <a asp-controller="Application"
                   asp-action="Index"
                   class="details-back-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Applications

                </a>

            </div>

        </div>


        <!-- ALERTS -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="details-alert success">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <div class="details-alert danger">

                <i class="fa-solid fa-circle-exclamation"></i>

                <span>
                    @TempData["ErrorMessage"]
                </span>

            </div>
        }


        <!-- STATUS BANNER -->

        <div class="application-status-banner
            @(Model.Status == "Approved"
                             ? "approved"
                             : Model.Status == "Rejected"
                                 ? "rejected"
                                 : Model.Status == "Cancelled" || Model.Status == "Withdrawn"
                                     ? "cancelled"
                                     : "pending")">

            <div class="status-banner-icon">

                @if (Model.Status == "Approved")
                {
                    <i class="fa-solid fa-circle-check"></i>
                }
                else if (Model.Status == "Rejected")
                {
                    <i class="fa-solid fa-circle-xmark"></i>
                }
                else if (Model.Status == "Cancelled" || Model.Status == "Withdrawn")
                {
                    <i class="fa-solid fa-ban"></i>
                }
                else
                {
                    <i class="fa-solid fa-clock"></i>
                }

            </div>


            <div>

                <span>
                    APPLICATION STATUS
                </span>

                <strong>
                    @Model.Status
                </strong>

            </div>


            <div class="status-date">

                Submitted

                @(Model.ApplicationDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm"))

            </div>

        </div>


        <!-- =====================================================
             APPLICANT INFORMATION
             ===================================================== -->

        <div class="details-card">

            <div class="details-card-header">

                <div class="details-section-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h2>
                        Applicant Information
                    </h2>

                    <p>
                        Personal information associated with this application.
                    </p>

                </div>

            </div>


            <div class="details-divider"></div>


            @if (Model.User != null)
            {
                <div class="details-information-grid">

                    <div class="detail-field">

                        <span>
                            FULL NAME
                        </span>

                        <strong>
                            @Model.User.FirstName
                            @Model.User.Surname
                        </strong>

                    </div>


                    <div class="detail-field">

                        <span>
                            USER TYPE
                        </span>

                        <strong>
                            @Model.User.UserType
                        </strong>

                    </div>


                    <div class="detail-field">

                        <span>
                            EMAIL ADDRESS
                        </span>

                        <strong>
                            @Model.User.Email
                        </strong>

                    </div>


                    <div class="detail-field">

                        <span>
                            PHONE NUMBER
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(
                                                    Model.User.PhoneNumber)
                                                    ? "Not provided"
                                                    : Model.User.PhoneNumber)
                    </strong>

                    </div>


                @if (!string.IsNullOrWhiteSpace(
                                Model.User.StudentNumber))
                    {
                        <div class="detail-field">

                            <span>
                                STUDENT NUMBER
                            </span>

                            <strong>
                                @Model.User.StudentNumber
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                                    Model.User.EmployeeNumber))
                    {
                        <div class="detail-field">

                            <span>
                                EMPLOYEE NUMBER
                            </span>

                            <strong>
                                @Model.User.EmployeeNumber
                            </strong>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="details-unavailable">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                    Applicant information is unavailable.

                </div>
            }

        </div>


        <!-- =====================================================
             ACCOMMODATION
             ===================================================== -->

        <div class="details-card">

            <div class="details-card-header">

                <div class="details-section-icon accommodation">

                    <i class="fa-solid fa-building"></i>

                </div>

                <div>

                    <h2>
                        Accommodation
                    </h2>

                    <p>
                        Accommodation selected by the applicant.
                    </p>

                </div>

            </div>


            <div class="details-divider"></div>


            @if (Model.Accommodation != null)
            {
                <div class="selected-accommodation">

                    <div class="selected-accommodation-top">

                        <div>

                            <span>
                                SELECTED ACCOMMODATION
                            </span>

                            <h3>
                                @Model.Accommodation.Name
                            </h3>

                            <p>

                                <i class="fa-solid fa-location-dot"></i>

                                @Model.Accommodation.Location

                            </p>

                        </div>


                        <div class="rooms-badge">

                            <i class="fa-solid fa-door-open"></i>

                            @Model.Accommodation.AvailableRooms
                            rooms available

                        </div>

                    </div>


                    <div class="accommodation-info-grid">

                        <div>

                            <span>
                                TYPE
                            </span>

                            <strong>
                                @Model.Accommodation.Type
                            </strong>

                        </div>


                        <div>

                            <span>
                                BEDROOMS
                            </span>

                            <strong>
                                @Model.Accommodation.Bedrooms
                            </strong>

                        </div>


                        <div>

                            <span>
                                BATHROOMS
                            </span>

                            <strong>
                                @Model.Accommodation.Bathrooms
                            </strong>

                        </div>


                        <div>

                            <span>
                                MONTHLY RENT
                            </span>

                            <strong class="rent">
                                R @(Model.Accommodation.MonthlyRent.ToString("N2"))
                            </strong>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="details-unavailable">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                    Accommodation information is unavailable.

                </div>
            }

        </div>


        <!-- =====================================================
             APPLICATION INFORMATION
             ===================================================== -->

        <div class="details-card">

            <div class="details-card-header">

                <div class="details-section-icon application">

                    <i class="fa-solid fa-file-lines"></i>

                </div>

                <div>

                    <h2>
                        Application Information
                    </h2>

                    <p>
                        Submission and processing information.
                    </p>

                </div>

            </div>


            <div class="details-divider"></div>


            <div class="application-info-grid">

                <div>

                    <span>
                        APPLICATION ID
                    </span>

                    <strong>
                        #@Model.ApplicationID
                    </strong>

                </div>


                <div>

                    <span>
                        APPLICATION DATE
                    </span>

                    <strong>

                        @(Model.ApplicationDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm"))

                    </strong>

                </div>


                <div>

                    <span>
                        SUBMISSION TIME
                    </span>

                    <strong>

                        @(Model.ApplicationDate.ToLocalTime().ToString("dd MMMM yyyy"))

                    </strong>

                </div>


                <div>

                    <span>
                        CURRENT STATUS
                    </span>

                    <strong>
                        @Model.Status
                    </strong>

                </div>

            </div>


            @if (Model.Status == "Rejected" &&
                        !string.IsNullOrWhiteSpace(
                        Model.RejectionReason))
            {
                <div class="rejection-reason-box">

                    <div class="reason-icon">

                        <i class="fa-solid fa-circle-exclamation"></i>

                    </div>

                    <div>

                        <strong>
                            Rejection Reason
                        </strong>

                        <p>
                            @Model.RejectionReason
                        </p>

                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             DOCUMENTS
             ===================================================== -->

        <div class="details-card">

            <div class="details-card-header">

                <div class="details-section-icon documents">

                    <i class="fa-solid fa-folder-open"></i>

                </div>

                <div>

                    <h2>
                        Supporting Documents
                    </h2>

                    <p>
                        Documents submitted with this application.
                    </p>

                </div>

            </div>


            <div class="details-divider"></div>


            <div class="documents-grid">

                <!-- ID -->

                <div class="submitted-document">

                    <div class="submitted-document-icon">

                        <i class="fa-solid fa-id-card"></i>

                    </div>

                    <div class="submitted-document-body">

                        <span>
                            DOCUMENT 01
                        </span>

                        <h3>
                            Certified Copy of ID
                        </h3>

                        @if (Model.IDDocument != null &&
                                                Model.IDDocument.Length > 0)
                        {
                            <p>
                                @Model.IDDocumentName
                            </p>

                            <a asp-controller="Application"
                               asp-action="ViewDocument"
                               asp-route-id="@Model.ApplicationID"
                               asp-route-type="id"
                               target="_blank"
                               class="document-view-button">

                                <i class="fa-solid fa-file-pdf"></i>

                                View PDF

                            </a>
                        }
                        else
                        {
                            <p class="missing">
                                Document unavailable
                            </p>
                        }

                    </div>

                </div>


                <!-- REGISTRATION -->

                <div class="submitted-document">

                    <div class="submitted-document-icon">

                        <i class="fa-solid fa-graduation-cap"></i>

                    </div>

                    <div class="submitted-document-body">

                        <span>
                            DOCUMENT 02
                        </span>

                        <h3>
                            Proof of Registration
                        </h3>

                        @if (Model.RegistrationDocument != null &&
                                                Model.RegistrationDocument.Length > 0)
                        {
                            <p>
                                @Model.RegistrationDocumentName
                            </p>

                            <a asp-controller="Application"
                               asp-action="ViewDocument"
                               asp-route-id="@Model.ApplicationID"
                               asp-route-type="registration"
                               target="_blank"
                               class="document-view-button">

                                <i class="fa-solid fa-file-pdf"></i>

                                View PDF

                            </a>
                        }
                        else
                        {
                            <p class="missing">
                                Document unavailable
                            </p>
                        }

                    </div>

                </div>


                @if (string.Equals(Model.User?.UserType, "Staff", StringComparison.OrdinalIgnoreCase))
                {
                    <!-- EMPLOYMENT -->
                    <div class="submitted-document">
                        <div class="submitted-document-icon">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>
                        <div class="submitted-document-body">
                            <span>DOCUMENT 02</span>
                            <h3>Proof of Employment</h3>

                            @if (Model.EmploymentDocument != null && Model.EmploymentDocument.Length > 0)
                            {
                                <p>@Model.EmploymentDocumentName</p>
                                <a asp-controller="Application"
                                   asp-action="ViewDocument"
                                   asp-route-id="@Model.ApplicationID"
                                   asp-route-type="employment"
                                   target="_blank"
                                   class="document-view-button">
                                    <i class="fa-solid fa-file-pdf"></i>
                                    View PDF
                                </a>
                            }
                            else
                            {
                                <p class="missing">Document unavailable</p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- REGISTRATION CONFIRMATION -->
                    <div class="submitted-document">
                        <div class="submitted-document-icon">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div class="submitted-document-body">
                            <span>DOCUMENT 02</span>
                            <h3>Proof of Registration</h3>

                            @if (Model.RegistrationDocument != null && Model.RegistrationDocument.Length > 0)
                            {
                                <p>@Model.RegistrationDocumentName</p>
                                <a asp-controller="Application"
                                   asp-action="ViewDocument"
                                   asp-route-id="@Model.ApplicationID"
                                   asp-route-type="registration"
                                   target="_blank"
                                   class="document-view-button">
                                    <i class="fa-solid fa-file-pdf"></i>
                                    View PDF
                                </a>
                            }
                            else
                            {
                                <p class="missing">Document unavailable</p>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>


        @if (!isManagement && Model.Status == "Pending")
        {
            <div class="decision-card mb-4">
                <div class="decision-heading">
                    <div class="decision-icon"><i class="fa-solid fa-arrow-rotate-left"></i></div>
                    <div><h2>Change Your Mind?</h2><p>You can withdraw this pending application before an administrator approves or rejects it.</p></div>
                </div>
                <form asp-controller="Application" asp-action="Withdraw" method="post" class="mt-3" onsubmit="return confirm('Withdraw this pending application?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ApplicationID" />
                    <button type="submit" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-rotate-left me-2"></i>Withdraw Application</button>
                </form>
            </div>
        }


        <!-- =====================================================
             ADMIN DECISION
             ===================================================== -->
        @if (isAdmin &&
                Model.Status == "Pending")
        {
            <div class="decision-card">

                <div class="decision-heading">

                    <div class="decision-icon">

                        <i class="fa-solid fa-gavel"></i>

                    </div>

                    <div>

                        <h2>
                            Application Decision
                        </h2>

                        <p>
                            Review all submitted information and
                            documents before making a decision.
                        </p>

                    </div>

                </div>


                <form asp-controller="Application"
                      asp-action="Approve"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.ApplicationID" />

                    <div class="mb-3">
                        <label for="roomId" class="form-label fw-semibold">
                            Allocate Available Room
                        </label>
                        <select id="roomId" name="roomId" class="form-select" required>
                            <option value="">-- Select Room --</option>
                            @foreach (var room in (ViewBag.AvailableRooms as IEnumerable<UFSStayConnect.Models.Room> ?? Enumerable.Empty<UFSStayConnect.Models.Room>()))
                            {
                                <option value="@room.RoomID">Room @room.RoomNumber (@room.RoomType)</option>
                            }
                        </select>
                        @if (!(ViewBag.AvailableRooms as IEnumerable<UFSStayConnect.Models.Room> ?? Enumerable.Empty<UFSStayConnect.Models.Room>()).Any())
                        {
                            <div class="text-danger small mt-2">No available rooms have been created for this residence. Create a room before approving.</div>
                        }
                    </div>

                    <div class="decision-actions">
                        @if ((ViewBag.AvailableRooms as IEnumerable<UFSStayConnect.Models.Room> ?? Enumerable.Empty<UFSStayConnect.Models.Room>()).Any())
                        {
                            <button type="submit" class="approve-button" onclick="return confirm('Approve this application and allocate the selected room?');">
                                <i class="fa-solid fa-check"></i>
                                Approve & Allocate Room
                            </button>
                        }

                        <button type="button"
                                class="reject-button"
                                data-bs-toggle="modal"
                                data-bs-target="#rejectApplicationModal">
                            <i class="fa-solid fa-xmark"></i>
                            Reject Application
                        </button>
                    </div>

                </form>

                <div class="decision-warning">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Approval requires an available room. The selected room will become occupied and the student will receive a notification with the room number.
                    </span>
                </div>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     REJECTION MODAL
     ========================================================= -->
@if (isAdmin &&
     Model.Status == "Pending")
{
    <div class="modal fade"
         id="rejectApplicationModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content rejection-modal">

                <div class="modal-header">

                    <div>

                        <div class="modal-icon">

                            <i class="fa-solid fa-xmark"></i>

                        </div>

                        <h5 class="modal-title">
                            Reject Application
                        </h5>

                        <p>
                            Application #@Model.ApplicationID
                        </p>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <form asp-controller="Application"
                      asp-action="Reject"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               value="@Model.ApplicationID" />


                        <label for="rejectionReason"
                               class="form-label">

                            Rejection Reason

                            <span class="text-danger">
                                *
                            </span>

                        </label>


                        <textarea id="rejectionReason"
                              name="reason"
                              class="form-control"
                              rows="6"
                              maxlength="1000"
                              required
                              placeholder="Enter the reason for rejecting this application..."></textarea>


                        <div class="form-text">

                            Maximum 1000 characters.

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <button type="submit"
                                class="btn btn-danger">

                            <i class="fa-solid fa-xmark"></i>

                            Reject Application

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


<style>

    .application-details-page {
        min-height: calc(100vh - 70px);
        background: #f5f7fa;
        padding: 40px 25px 70px;
    }

    .application-details-container {
        max-width: 1050px;
        margin: auto;
    }

    .details-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 25px;
    }

    .details-eyebrow {
        color: #1769e0;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 5px;
    }

    .details-header h1 {
        color: #152a43;
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 6px;
    }

        .details-header h1 i {
            color: #1769e0;
            margin-right: 7px;
        }

    .details-header p {
        color: #7b8796;
        font-size: 12px;
        margin: 0;
    }

    .details-back-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        background: white;
        border: 1px solid #d5dde6;
        border-radius: 7px;
        color: #596879;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
    }

        .details-back-button:hover {
            color: #1769e0;
            border-color: #1769e0;
        }

    .details-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 17px;
        font-size: 11px;
    }

        .details-alert.success {
            color: #26734c;
            background: #edf9f2;
            border: 1px solid #cce8d7;
        }

        .details-alert.danger {
            color: #a33a3a;
            background: #fff1f1;
            border: 1px solid #efcccc;
        }

    .application-status-banner {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 16px 19px;
        border-radius: 9px;
        margin-bottom: 20px;
        border: 1px solid;
    }

        .application-status-banner.pending {
            background: #fffaf0;
            border-color: #f0dfad;
            color: #8a6a16;
        }

        .application-status-banner.approved {
            background: #edf9f2;
            border-color: #cce8d7;
            color: #26734c;
        }

        .application-status-banner.rejected {
            background: #fff1f1;
            border-color: #efcccc;
            color: #a33a3a;
        }

        .application-status-banner.cancelled {
            background: #f1f5f9;
            border-color: #d8e0e8;
            color: #64748b;
        }

    .status-banner-icon {
        font-size: 22px;
    }

    .application-status-banner span {
        display: block;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .8px;
        margin-bottom: 2px;
    }

    .application-status-banner strong {
        font-size: 15px;
    }

    .status-date {
        margin-left: auto;
        font-size: 10px;
    }

    .details-card {
        background: white;
        border: 1px solid #dfe6ee;
        border-radius: 11px;
        padding: 27px;
        margin-bottom: 18px;
        box-shadow: 0 3px 14px rgba(20, 40, 65, .035);
    }

    .details-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .details-section-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #edf4ff;
        color: #1769e0;
        font-size: 17px;
    }

        .details-section-icon.accommodation {
            background: #eef8f3;
            color: #16804b;
        }

        .details-section-icon.application {
            background: #f0edff;
            color: #6554c0;
        }

        .details-section-icon.documents {
            background: #fff1f1;
            color: #c03939;
        }

    .details-card-header h2 {
        color: #263b53;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 3px;
    }

    .details-card-header p {
        color: #8a95a2;
        font-size: 10px;
        margin: 0;
    }

    .details-divider {
        height: 1px;
        background: #edf1f5;
        margin: 23px 0;
    }

    .details-information-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .detail-field span,
    .accommodation-info-grid span,
    .application-info-grid span {
        display: block;
        color: #9aa5b1;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .8px;
        margin-bottom: 5px;
    }

    .detail-field strong {
        color: #334155;
        font-size: 12px;
        font-weight: 600;
    }

    .details-unavailable {
        padding: 14px;
        border-radius: 7px;
