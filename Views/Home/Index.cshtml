@{
    
    Layout = "~/Views/Shared/_Layout.cshtml";
ViewData["Title"] = "Home";
}


<!-- HERO SECTION -->

<section class="hero">

    <div class="container">

        <div class="row">

            <div class="col-lg-8 text-white">

                <h1>
                    Find Your Place.
                    <br />
                    Manage Your Stay.
                </h1>

                <p>
                    UFS StayConnect makes it easier to find,
                    apply for and manage accommodation at
                    the UFS QwaQwa Campus.
                </p>

                <a asp-controller="Accommodation"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="fa-solid fa-magnifying-glass"></i>
                    Find Accommodation

                </a>

                <a href="/Account/Register"
                   class="btn btn-outline-light">

                    Get Started

                </a>

            </div>

        </div>

    </div>

</section>



<!-- FEATURES -->

<section class="features-section">

    <div class="container">

        <div class="text-center mb-5">

            <h2>
                Everything You Need in One Place
            </h2>

            <p class="text-muted">
                Manage your accommodation journey with ease.
            </p>

        </div>


        <div class="row g-4">


            <!-- FIND -->

            <div class="col-md-4">

                <div class="feature-card text-center">

                    <div class="feature-icon">
                        <i class="fa-solid fa-house"></i>
                    </div>

                    <h3>
                        Find Accommodation
                    </h3>

                    <p class="text-muted">
                        Search and explore available
                        accommodation that suits your needs.
                    </p>

                </div>

            </div>



            <!-- APPLY -->

            <div class="col-md-4">

                <div class="feature-card text-center">

                    <div class="feature-icon">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>

                    <h3>
                        Apply Online
                    </h3>

                    <p class="text-muted">
                        Submit your accommodation application
                        through the online platform.
                    </p>

                </div>

            </div>



            <!-- PAY -->

            <div class="col-md-4">

                <div class="feature-card text-center">

                    <div class="feature-icon">
                        <i class="fa-solid fa-credit-card"></i>
                    </div>

                    <h3>
                        Manage Payments
                    </h3>

                    <p class="text-muted">
                        View your bills, make payments and
                        track your transaction history.
                    </p>

                </div>

            </div>


        </div>

    </div>

</section>



<!-- CALL TO ACTION -->

<section class="available-accommodation-section py-5">
    <div class="container">

        <div class="text-center mb-4">
            <span class="section-label">ACCOMMODATION</span>
            <h2 class="fw-bold mt-2">Find Your Accommodation</h2>
            <p class="text-muted">
                Explore available accommodation options at UFS QwaQwa.
            </p>
        </div>

        @if (ViewBag.AvailableAccommodations != null &&
                ViewBag.AvailableAccommodations.Count > 0)
        {
            <div class="accommodation-slider-wrapper">

                <button type="button"
                        class="slider-btn slider-prev"
                        onclick="scrollAccommodationCards(-1)"
                        aria-label="Previous accommodation">
                    <i class="fas fa-chevron-left"></i>
                </button>

                <div id="accommodationSlider"
                     class="accommodation-slider">

                    @foreach (var accommodation in ViewBag.AvailableAccommodations)
                    {
                        <div class="accommodation-card">

                            <div class="accommodation-card-image">
                                @if (!string.IsNullOrEmpty(accommodation.ImagePath))
                                {
                                    <img src="@accommodation.ImagePath"
                                         alt="@accommodation.Name">
                                }
                                else
                                {
                                    <div class="accommodation-placeholder">
                                        <i class="fas fa-building"></i>
                                    </div>
                                }

                                <span class="availability-badge">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Available
                                </span>
                            </div>

                            <div class="accommodation-card-body">

                                <h5 class="fw-bold mb-2">
                                    @accommodation.Name
                                </h5>

                                <p class="text-muted small mb-3">
                                    <i class="fas fa-map-marker-alt me-1"></i>
                                    @accommodation.Location
                                </p>

                                <div class="accommodation-info">

                                    <div>
                                        <i class="fas fa-bed"></i>
                                        <span>
                                            @accommodation.AvailableRooms
                                            rooms available
                                        </span>
                                    </div>

                                    <div>
                                        <i class="fas fa-money-bill-wave"></i>
                                        <span>
                                            R @(accommodation.MonthlyRent.ToString("N2"))
                                            / month
                                        </span>
                                    </div>

                                </div>

                                <a asp-controller="Accommodation"
                                   asp-action="Details"
                                   asp-route-id="@accommodation.AccommodationID"
                                   class="btn btn-outline-primary w-100 mt-3">
                                    View Accommodation
                                    <!--i-- class="fas fa-arrow-right ms-2"></!--i-->
                                </a>

                            </div>

                        </div>
                    }

                </div>

                <button type="button"
                        class="slider-btn slider-next"
                        onclick="scrollAccommodationCards(1)"
                        aria-label="Next accommodation">
                    <i class="fas fa-chevron-right"></i>
                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="empty-accommodation-icon mb-3">
                    <i class="fas fa-home"></i>
                </div>

                <h5>No accommodation currently available</h5>

                <p class="text-muted">
                    Please check again later for available accommodation.
                </p>
            </div>
        }

    </div>
</section>

