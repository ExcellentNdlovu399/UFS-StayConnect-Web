<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - UFS StayConnect
    </title>

    <!-- Google Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Main site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Landing/public pages CSS -->
    <link rel="stylesheet"
          href="~/css/landing.css"
          asp-append-version="true" />

    @RenderSection("Styles", required: false)

</head>

<body>

    <!-- ========================================================= -->
    <!-- PUBLIC NAVBAR                                             -->
    <!-- ========================================================= -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container">

                <!-- LOGO -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/ufs-emblem.png"
                         alt="University of the Free State"
                         class="ufs-emblem" />

                    UFS StayConnect

                </a>


                <!-- MOBILE MENU -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- PUBLIC NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                              
                                Home

                            </a>

                        </li>


                        <!-- ACCOMMODATION -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Accommodation"
                               asp-action="Index">

                              
                                Accommodation

                            </a>

                        </li>


                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="CustomerCharge" asp-action="Index">
                                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> Customer Charges
                                </a>
                            </li>
                        }

                        <!-- LOGIN / REGISTER ONLY FOR VISITORS -->
                        @if (User.Identity == null ||
                                                !User.Identity.IsAuthenticated)
                        {

                            <!-- LOGIN -->

                            <li class="nav-item ms-lg-3">

                                <a class="btn btn-primary px-4"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    <i class="fa-solid fa-right-to-bracket me-2"></i>

                                    Login

                                </a>

                            </li>


                            <!-- REGISTER -->

                            <li class="nav-item ms-lg-2">

                                <a class="btn btn-outline-light px-4"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    <i class="fa-solid fa-user-plus me-2"></i>

                                    Register

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ========================================================= -->
    <!-- PAGE CONTENT                                               -->
    <!-- ========================================================= -->

    <div class="container-fluid p-0">

        <main>

            @RenderBody()

        </main>

    </div>


    <!-- ========================================================= -->
    <!-- FOOTER                                                     -->
    <!-- ========================================================= -->

    <partial name="_Footer" />


    <!-- ========================================================= -->
    <!-- PAGE SCRIPTS                                               -->
    <!-- ========================================================= -->
    @await RenderSectionAsync(
    "Scripts",
        required: false)


    <!-- Bootstrap JavaScript -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>